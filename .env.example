# MarkChat Marketing Platform Environment Variables
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_BRIDGE_API_URL=http://localhost:4000
# Optional approved HTTPS CMS media host. Unconfigured hosts are rejected by hero media URL sanitization.
PUBLIC_CMS_MEDIA_HOST=
# Server-side CMS authentication credential (COMPROMISED VALUE PURGED).
# Mandatory Rotation Required: Set a newly generated 256-bit secret exclusively
# in the secure server-side environment where the central CMS API runs.
ADMIN_CMS_SECRET=
SITE_URL=http://localhost:4321
SITE_NAME=MarkChat
SITE_DESCRIPTION=Turn Every Customer Chat into an Instant M-Pesa Sale
SITE_AUTHOR=MarkChat Technologies Ltd

# Control Plane URL used for signup, Google OAuth and subscription checkout.
# Use the same public HTTPS origin for frontend and Control Plane CORS.
PUBLIC_CONTROL_PLANE_URL=http://localhost:5000
# Legacy alias (deprecated; PUBLIC_CONTROL_PLANE_URL takes precedence):
PUBLIC_CONTROL_PLANE_API_URL=http://localhost:5000
