---
/**
 * Core-only public pricing. The separate SMS product is not advertised here.
 * Subscription figures continue to come from the published billing catalog.
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PricingTable from '@sections/pricing/PricingTable.astro';
import FAQSection from '@sections/content/FAQSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import MCSection from '@/components/design-system/MCSection.astro';
import MCSectionHeading from '@/components/design-system/MCSectionHeading.astro';
import MCCard from '@/components/design-system/MCCard.astro';
import MCStatusBadge from '@/components/design-system/MCStatusBadge.astro';
import { siteConfig } from '@/config';
import { fetchPricingMatrix, fetchFaqs } from '@/lib/cms-api';

const [matrix, faqsList] = await Promise.all([fetchPricingMatrix(), fetchFaqs()]);
const deferred = /\bsms\b|sender\s+id|byoc|\bsla\b|saml|sso|whitelabel|dedicated\s+support|shortcode|audit\s+logs?|agent\s+capacity/i;

const plans = matrix.tiers.map((tier) => ({
  name: tier.name,
  monthlyPrice: tier.monthlyPrice,
  customPrice: tier.monthlyPrice === null ? 'Custom' : undefined,
  description: deferred.test(tier.description)
    ? 'Customer conversation workspace with features and integrations confirmed during onboarding.'
    : tier.description,
  features: tier.features.filter((feature) => !deferred.test(feature)).slice(0, 5),
  highlighted: tier.highlighted,
  badge: deferred.test(tier.badge || '') ? 'Workspace plan' : tier.badge,
  cta: {
    label: tier.ctaLabel,
    href: /^\/(?!\/)/.test(tier.ctaHref) ? tier.ctaHref : '/contact',
  },
}));

const pricingFaqs = faqsList
  .filter((faq) => ['pricing', 'mpesa', 'general'].includes(faq.category))
  .filter((faq) => !deferred.test(faq.question + ' ' + faq.answer))
  .slice(0, 6)
  .map((faq) => ({ question: faq.question, answer: faq.answer }));
---

<MarketingLayout
  title={`Pricing & Plans — ${siteConfig.name} Kenya`}
  description="Explore current MarkChat Core workspace subscriptions in KES, compare collaboration features, and arrange approved messaging and M-Pesa provider setup."
>
  <PricingTable
    flatPreview
    title="Simple, transparent Core workspace pricing"
    subtitle="Choose a plan that suits your team. Provider setup, permissions and transaction fees are confirmed separately."
    plans={plans}
    defaultPeriod="monthly"
    background="muted"
    footerLink={{ label: 'Discuss business requirements', href: '/contact' }}
  />

  <MCSection tone="default" id="billing-principles">
    <div class="mb-9">
      <MCSectionHeading
        eyebrow="How billing works"
        title="A clear path from your plan to an active workspace"
        description="Core subscriptions cover your MarkChat workspace. Channel providers and payment integrations require their own configuration and approval."
      />
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <MCCard>
        <MCStatusBadge status="available" label="Workspace subscription" />
        <h3 class="mt-4 text-lg font-semibold text-text">Choose a workspace</h3>
        <p class="mt-3 text-sm leading-relaxed text-text-muted">
          Compare published monthly subscription prices and included collaboration features.
        </p>
      </MCCard>
      <MCCard>
        <MCStatusBadge status="integration" label="Provider approval" />
        <h3 class="mt-4 text-lg font-semibold text-text">Connect eligible channels</h3>
        <p class="mt-3 text-sm leading-relaxed text-text-muted">
          WhatsApp and other integrations depend on permissions and your provider account.
        </p>
      </MCCard>
      <MCCard>
        <MCStatusBadge status="integration" label="Merchant configuration" />
        <h3 class="mt-4 text-lg font-semibold text-text">Configure M-Pesa</h3>
        <p class="mt-3 text-sm leading-relaxed text-text-muted">
          Authorized Daraja payment workflows require merchant credentials and callback verification.
        </p>
      </MCCard>
    </div>
  </MCSection>

  {
    pricingFaqs.length > 0 && (
      <FAQSection
        title="Frequently asked billing questions"
        subtitle="Current subscription terms and provider readiness."
        faqs={pricingFaqs}
        variant="simple"
        background="muted"
      />
    )
  }

  <CTA
    title="Need help choosing the right plan?"
    description="Talk with our Nairobi team about workspace seats, messaging channels and authorized payment integrations."
    action={{ label: 'Book a Demo', href: '/demo' }}
    secondaryAction={{ label: 'Contact Sales', href: '/contact' }}
    background="default"
  />
</MarketingLayout>
