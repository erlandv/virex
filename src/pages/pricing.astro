---
/**
 * MarkChat Kenya — Pricing & Plan Feature Matrix
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PricingTable from '@sections/pricing/PricingTable.astro';
import ComparisonTable from '@sections/pricing/ComparisonTable.astro';
import TrustBadges from '@sections/pricing/TrustBadges.astro';
import FAQSection from '@sections/content/FAQSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';
import { fetchPricingMatrix, fetchFaqs } from '@/lib/cms-api';

const [matrix, faqsList] = await Promise.all([fetchPricingMatrix(), fetchFaqs()]);

const planNames = matrix.tiers.map((t) => t.name);

const plans = matrix.tiers.map((tier) => ({
  name: tier.name,
  monthlyPrice: tier.monthlyPrice,
  customPrice: tier.monthlyPrice === null ? 'Custom' : undefined,
  description: tier.description,
  features: tier.features,
  highlighted: tier.highlighted,
  badge: tier.badge,
  cta: {
    label: tier.ctaLabel,
    href: tier.ctaHref,
  },
}));

// Build comparison matrix based on the CMS feature-gating matrix
const featMap = new Map(matrix.featureMatrix.map((f) => [f.key, f]));

const comparisonCategories = [
  {
    name: 'Channels & Inboxes',
    features: [
      {
        name: 'Official WhatsApp Cloud API',
        values: [
          featMap.get('whatsapp_api')?.starter ?? true,
          featMap.get('whatsapp_api')?.pro ?? true,
          featMap.get('whatsapp_api')?.enterprise ?? true,
        ],
        tooltip: 'Direct Meta Cloud API integration with zero phone ban risk',
      },
      {
        name: 'Bulk SMS Gateway (Africa’s Talking)',
        values: [
          '50 Trial SMS',
          featMap.get('bulk_ai_campaigns')?.pro ? '500 SMS / mo Included' : false,
          'BYOC Zero Markup / Custom',
        ],
        tooltip: 'Prepaid bundles via M-Pesa or Bring Your Own Carrier credentials',
      },
      {
        name: 'Instagram DMs & Facebook Messenger',
        values: [false, true, true],
        tooltip: 'Centralize social messages into your shared team inbox',
      },
    ],
  },
  {
    name: 'M-Pesa & Mobile Money Modes',
    features: [
      {
        name: 'In-Chat /stk PIN Prompt Checkout',
        values: [
          featMap.get('mpesa_stk_checkout')?.starter ?? false,
          featMap.get('mpesa_stk_checkout')?.pro ?? true,
          featMap.get('mpesa_stk_checkout')?.enterprise ?? true,
        ],
        tooltip: 'Trigger instant M-Pesa PIN popup on customer phone directly in chat',
      },
      {
        name: 'Daraja C2B Auto-Verification (Stops Fake SMS)',
        values: ['Manual Log', true, 'Dedicated Route'],
        tooltip: 'Server-side TransID validation that eliminates screenshot fraud',
      },
      {
        name: 'Pochi la Biashara & Till Forwarder Sync',
        values: [
          featMap.get('pochi_sms_sync')?.starter ?? false,
          featMap.get('pochi_sms_sync')?.pro ?? true,
          featMap.get('pochi_sms_sync')?.enterprise ?? true,
        ],
        tooltip: 'Real-time Android SMS sync forwarder for personal/Pochi lines',
      },
      {
        name: 'Shared Bank Paybill (KCB, Equity, Co-op)',
        values: [false, true, true],
        tooltip: 'Auto-routes incoming bank payments by customer account reference',
      },
    ],
  },
  {
    name: 'Markcopilot AI Automation',
    features: [
      {
        name: 'Dual-Mode AI Engine (Swahili / English)',
        values: ['50 msgs / mo', featMap.get('markcopilot_ai')?.pro ?? true, 'Custom Fine-Tuning'],
        tooltip: 'Trained on your catalog, price lists, and delivery guidelines',
      },
      {
        name: 'Agent 1-Click Reply Drafts & Summaries',
        values: [false, true, true],
        tooltip: 'Accelerates human agent response times by 4x',
      },
      {
        name: 'Sentiment & Urgency Order Tagging',
        values: [false, true, true],
        tooltip: 'Alerts supervisors to ready-to-pay wholesale leads',
      },
    ],
  },
  {
    name: 'Team Scale & Administration',
    features: [
      {
        name: 'Team Agent Seats',
        values: ['1 Agent', '5 Agents included', 'Unlimited Seats'],
      },
      {
        name: 'Workspace Performance & SLA Reports',
        values: [
          featMap.get('workspace_analytics')?.starter ?? false,
          featMap.get('workspace_analytics')?.pro ?? true,
          featMap.get('workspace_analytics')?.enterprise ?? true,
        ],
      },
      {
        name: 'Custom Domain Whitelabeling & Branding',
        values: [
          featMap.get('custom_whitelabel')?.starter ?? false,
          featMap.get('custom_whitelabel')?.pro ?? true,
          featMap.get('custom_whitelabel')?.enterprise ?? true,
        ],
      },
      {
        name: 'Customer Support',
        values: ['Community & Email', 'Priority WhatsApp Support', '24/7 Dedicated Account Lead'],
      },
    ],
  },
];

const pricingFaqs = faqsList
  .filter((f) => f.category === 'pricing' || f.category === 'mpesa' || f.category === 'general')
  .slice(0, 6);
---

<MarketingLayout
  title={`Pricing & Plans - ${siteConfig.name} Kenya`}
  description="Transparent KES pricing for MarkChat. Starter KES 0/mo, Pro KES 3,500/mo, Enterprise scale. In-Chat M-Pesa STK, Bulk SMS, and Markcopilot AI."
>
  <PricingTable
    title="Simple, Transparent KES Pricing"
    subtitle="All plans include official WhatsApp Cloud API access and 50 free Bulk SMS credits to test. Save 20% when billed annually."
    plans={plans}
    annualDiscount={20}
    defaultPeriod="monthly"
  />

  <TrustBadges
    guarantee={{
      title: '14-Day Free Trial on Pro Plans',
      description:
        'Try all MarkChat Pro features risk-free. No credit card required to start—pay via M-Pesa only when satisfied.',
    }}
  />

  <ComparisonTable
    title="Detailed Plan & Feature Gating Matrix"
    subtitle="Inspect exact channel boundaries, M-Pesa modes, and Markcopilot AI capabilities across all tiers."
    plans={planNames}
    categories={comparisonCategories}
    highlightedPlan={1}
    background="default"
  />

  <FAQSection
    title="Frequently Asked Billing & M-Pesa Questions"
    faqs={pricingFaqs.map((f) => ({ question: f.question, answer: f.answer }))}
    variant="simple"
    background="default"
  />

  <CTA
    title="Need custom Paybill routing or high SMS volume?"
    description="Our Nairobi engineering team will configure dedicated shortcodes and custom ERP webhooks for your enterprise."
    action={{ label: 'Book Technical Consultation', href: '/demo' }}
    background="muted"
  />
</MarketingLayout>
