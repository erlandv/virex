---
/**
 * MarkChat Kenya — Integrations Directory
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import IntegrationIcon from '@/components/ui/IntegrationIcon.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';
import { fetchIntegrations } from '@/lib/cms-api';

const integrations = await fetchIntegrations();
const featured = integrations.filter((i) => i.isFeatured);

const categories = [
  'All',
  'Payments',
  'Messaging',
  'SMS Gateway',
  'Social Commerce',
  'E-Commerce',
  'AI Automation',
  'Productivity',
  'Authentication',
];
---

<MarketingLayout
  title={`Integrations - ${siteConfig.name}`}
  description="Connect Safaricom M-Pesa Daraja, Africa’s Talking Bulk SMS, Meta WhatsApp Cloud API, and Markcopilot AI into MarkChat."
>
  <PageHeader
    title="Kenyan Commerce & Telecommunications Integrations"
    subtitle="Unify Safaricom Daraja API, Africa’s Talking Bulk SMS, WhatsApp Cloud, and Pochi la Biashara in one high-performance stack."
  />

  <!-- Section 1 — Featured Integrations (3-Column Rich Cards) -->
  <section class="py-12 sm:py-16 bg-surface/50 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <span class="text-xs font-mono font-semibold text-primary uppercase">Core Ecosystem</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-text mt-1">Featured Integrations</h2>
        <p class="text-sm text-text-muted mt-2">
          The essential mobile money and telecommunication channels powering modern Kenyan trade.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          featured.map((item) => (
            <a
              href={`/integrations/${item.slug}`}
              class="group flex flex-col justify-between p-6 rounded-2xl border border-border bg-background hover:border-primary/50 hover:shadow-lg transition-all"
            >
              <div>
                <div class="flex items-center justify-between mb-4">
                  <IntegrationIcon
                    iconKey={item.iconKey}
                    logoUrl={item.logoUrl}
                    name={item.name}
                    size="md"
                  />
                  {item.isPopular && (
                    <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-primary/10 text-primary border border-primary/20">
                      Popular
                    </span>
                  )}
                </div>
                <h3 class="text-lg font-bold text-text group-hover:text-primary transition-colors">
                  {item.name}
                </h3>
                <p class="text-xs font-mono text-text-muted mt-1 uppercase tracking-wider">
                  {item.category}
                </p>
                <p class="text-sm text-text-muted mt-3 line-clamp-2 leading-relaxed">
                  {item.shortDescription}
                </p>
              </div>

              <div class="mt-5 pt-4 border-t border-border/50 flex items-center justify-between text-xs font-semibold text-primary">
                <span>View workflow guide</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 2 — All Integrations (Filter Pills + 4-Column Centered Icon Grid) -->
  <section class="py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-text">All Supported Integrations</h2>
        <p class="text-sm text-text-muted mt-2">
          Filter by channel type or click any card to inspect architecture, step-by-step setup
          guides, and merchant benefits.
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap justify-center gap-2 mb-12" data-filter-tabs>
        {
          categories.map((category, index) => (
            <button
              type="button"
              class:list={[
                'px-4 py-2 rounded-full text-xs font-semibold transition-all cursor-pointer',
                index === 0
                  ? 'bg-primary text-white shadow-sm'
                  : 'bg-surface border border-border text-text-muted hover:text-text hover:bg-surface-hover',
              ]}
              data-category={category}
            >
              {category}
            </button>
          ))
        }
      </div>

      <!-- 4-Column Centered Icon Card Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-integrations-grid>
        {
          integrations.map((item) => (
            <a
              href={`/integrations/${item.slug}`}
              class="group flex flex-col items-center text-center p-6 rounded-2xl border border-border bg-surface hover:border-primary hover:shadow-lg transition-all"
              data-category={item.category}
            >
              <IntegrationIcon
                iconKey={item.iconKey}
                logoUrl={item.logoUrl}
                name={item.name}
                size="xl"
                class="mb-4"
              />
              <h3 class="text-base font-bold text-text group-hover:text-primary transition-colors">
                {item.name}
              </h3>
              <p class="text-xs text-text-muted mt-1">{item.category}</p>

              {item.isPopular && (
                <span class="mt-3 px-2.5 py-0.5 text-xs font-semibold rounded-full bg-primary/10 text-primary border border-primary/20">
                  Popular
                </span>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    title="Have a custom ERP, Till, or Bank Paybill?"
    description="MarkChat Enterprise supports dedicated shortcodes, core banking callbacks, and custom webhooks."
    action={{ label: 'Book Technical Consultation', href: '/demo' }}
    background="muted"
  />
</MarketingLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-filter-tabs] button');
    const items = document.querySelectorAll<HTMLElement>('[data-integrations-grid] > a');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const category = tab.getAttribute('data-category');

        tabs.forEach((t) => {
          t.classList.remove('bg-primary', 'text-white', 'shadow-sm');
          t.classList.add('bg-surface', 'border', 'border-border', 'text-text-muted');
        });
        tab.classList.remove('bg-surface', 'border', 'border-border', 'text-text-muted');
        tab.classList.add('bg-primary', 'text-white', 'shadow-sm');

        items.forEach((item) => {
          const itemCategory = item.getAttribute('data-category');
          if (category === 'All' || itemCategory === category) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>
``
