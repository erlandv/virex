---
/**
 * MarkChat Kenya — Homepage
 *
 * Unified Customer Conversations, Engagement & In-Chat Commerce.
 * Grounded in verified product capabilities and authentic Kenyan commerce workflows.
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Hero from '@sections/marketing/Hero.astro';
import HowItWorks from '@sections/marketing/HowItWorks.astro';
import OmnichannelFlowHub from '@sections/marketing/OmnichannelFlowHub.astro';
import MarkcopilotExplainer from '@sections/marketing/MarkcopilotExplainer.astro';
import SolutionsPreview from '@sections/marketing/SolutionsPreview.astro';
import IntegrationsGrid from '@sections/marketing/IntegrationsGrid.astro';
import PricingTable from '@sections/pricing/PricingTable.astro';
import FeaturesSection from '@sections/marketing/FeaturesSection.astro';
import FAQSection from '@sections/content/FAQSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import Newsletter from '@sections/marketing/Newsletter.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config';
import { fetchPricingMatrix, fetchIntegrations, fetchHomepageSettings } from '@/lib/cms-api';

const [pricingMatrix, allIntegrations, homepageSettings] = await Promise.all([
  fetchPricingMatrix(),
  fetchIntegrations(),
  fetchHomepageSettings(),
]);

const sections = homepageSettings?.sections || {
  hero: true,
  omnichannelFlow: true,
  howItWorks: true,
  coreCapabilities: true,
  operationalScenarios: true,
  markcopilot: true,
  solutionsPreview: true,
  integrations: true,
  pricing: true,
  kenyaPrinciples: true,
  faqs: true,
  closingCta: true,
  newsletter: true,
};

const featuredIntegrations = allIntegrations
  .filter((i) => i.isFeatured)
  .slice(0, 6)
  .map((i) => ({
    slug: i.slug,
    name: i.name,
    category: i.category,
    iconKey: i.iconKey,
    logoUrl: i.logoUrl,
    isPopular: i.isPopular,
    shortDescription: i.shortDescription,
    href: `/integrations/${i.slug}`,
  }));

const pricingPlans = pricingMatrix.tiers.map((tier) => ({
  name: tier.name,
  monthlyPrice: tier.monthlyPrice,
  customPrice: tier.monthlyPrice === null ? 'Custom' : undefined,
  description: tier.description,
  features: tier.features,
  highlighted: tier.highlighted,
  badge: tier.badge,
  cta: {
    label: tier.ctaLabel,
    href: ['starter', 'growth', 'scale'].includes(tier.id)
      ? `/register?plan=${tier.id}&interval=monthly`
      : '/contact?topic=enterprise',
  },
}));

// Authentic Core Product Capabilities
const coreCapabilities = [
  {
    icon: 'lucide:inbox',
    title: 'Collaborative Omnichannel Inbox',
    description:
      'Unify WhatsApp Cloud API, Africa’s Talking Bulk SMS, Instagram DMs, Facebook Messenger, and website live chat into one workspace with team collision detection and private notes.',
  },
  {
    icon: 'lucide:smartphone',
    title: 'In-Chat /stk M-Pesa Prompts',
    description:
      'Agents trigger instant Safaricom SIM Toolkit PIN prompts directly within customer chat threads using /stk <amount> <phone>, eliminating account number typing errors.',
  },
  {
    icon: 'lucide:shield-check',
    title: 'Automated Callback Verification',
    description:
      'Review Safaricom Daraja C2B payment evidence before releasing goods. Merchant credentials and configured payment validation are required.',
  },
  {
    icon: 'lucide:message-square',
    title: 'Africa’s Talking Bulk SMS & BYOC',
    description:
      'Send transactional notifications and promotional SMS broadcasts using your own approved Alphanumeric Sender ID, with two-way conversation threading.',
  },
  {
    icon: 'lucide:sparkles',
    title: 'Bilingual Markcopilot AI',
    description:
      'Dual-mode artificial intelligence that drafts contextual agent replies in English, Swahili, and Sheng, while autonomously handling common catalog and order questions.',
  },
  {
    icon: 'lucide:layers',
    title: 'Pochi la Biashara & Till Android Sync',
    description:
      'Connect small-merchant Pochi la Biashara and Buy Goods lines via our dedicated Android SMS bridge APK, streaming mobile payment receipts directly into customer records.',
  },
];

// Substantive Real-World Operational Scenarios (Kenyan Commerce Workflows)
const operationalScenarios = [
  {
    title: 'Retail & Social Commerce',
    subtitle: 'From WhatsApp Product Inquiries to Instant STK Settlement',
    badge: 'WhatsApp Cloud + /stk',
    channelName: 'WhatsApp Business',
    channelIcon: 'lucide:message-circle',
    channelColor: 'text-[#25D366]',
    recipient: '+254 722 ••• 456 (Peter K.)',
    reconciliationBadge: 'Daraja Webhook Matched',
    steps: [
      {
        speaker: 'Customer (WhatsApp)',
        role: 'Buyer',
        text: 'Habari, do you have the leather sneakers size 43 in black? How much with delivery to Westlands?',
        type: 'customer',
        time: '14:21',
      },
      {
        speaker: 'Sales Agent (MarkChat)',
        role: 'Staff',
        text: 'Habari! Yes, size 43 black is available in stock. Total is KES 4,050 (shoes + KES 250 boda). Prompting your M-Pesa now.',
        type: 'agent',
        time: '14:22',
      },
      {
        speaker: 'Daraja STK Gateway',
        role: 'System Action',
        text: 'Executed: /stk 4050 0722123456 → Safaricom SIM Toolkit PIN prompt pushed to customer phone.',
        type: 'system',
        time: '14:22',
      },
      {
        speaker: 'Safaricom Daraja Callback',
        role: 'Verified Payment',
        text: 'Confirmed: KES 4,050 received from PETER KAMAU (Ref: QHL81920). Order #8192 marked PAID.',
        type: 'success',
        time: '14:23',
      },
    ],
  },
  {
    title: 'Clinics & Professional Services',
    subtitle: 'Automated Consultation Deposits & SMS Confirmation',
    badge: 'Live Chat + Paybill',
    channelName: 'Website Live Chat',
    channelIcon: 'lucide:messages-square',
    channelColor: 'text-indigo-500',
    recipient: 'Website Visitor #4029',
    reconciliationBadge: 'C2B Paybill Reconciled',
    steps: [
      {
        speaker: 'Patient (Live Chat)',
        role: 'Visitor',
        text: 'I would like to schedule a dental checkup for tomorrow at 2:00 PM at your Upper Hill clinic.',
        type: 'customer',
        time: '10:04',
      },
      {
        speaker: 'Markcopilot AI',
        role: 'Autonomous Assistant',
        text: 'Dental slot for tomorrow 2:00 PM is open. A KES 500 consultation deposit confirms your appointment.',
        type: 'agent',
        time: '10:04',
      },
      {
        speaker: 'Daraja C2B Webhook',
        role: 'System Action',
        text: 'Payment matched on Paybill 625100 (Acc: DENT-104, Ref: RK782910). Clinic calendar locked.',
        type: 'system',
        time: '10:06',
      },
      {
        speaker: 'Africa’s Talking SMS Broadcast',
        role: 'Transactional SMS',
        text: 'SMS delivered via CLINICCARE: "Your dental appointment is confirmed for tomorrow 2:00 PM."',
        type: 'success',
        time: '10:06',
      },
    ],
  },
  {
    title: 'Wholesale & Auto Spares',
    subtitle: 'Africa’s Talking Two-Way SMS & Pochi la Biashara Android Sync',
    badge: 'Bulk SMS + Pochi Sync',
    channelName: 'Africa’s Talking SMS',
    channelIcon: 'lucide:phone-call',
    channelColor: 'text-amber-500',
    recipient: '+254 712 ••• 654 (Daniel O.)',
    reconciliationBadge: 'Android APK Bridge Synced',
    steps: [
      {
        speaker: 'Customer (Bulk SMS)',
        role: 'SMS Buyer',
        text: 'Nahitaji brake pads za Toyota Fielder 2015. Mko nazo na bei ni ngapi?',
        type: 'customer',
        time: '09:12',
      },
      {
        speaker: 'Wholesale Desk (MarkChat)',
        role: 'Staff',
        text: 'Ziko boss! OEM pair ni KES 4,500. Lipa kwa Pochi la Biashara 0712987654 tutume na parcel leo.',
        type: 'agent',
        time: '09:14',
      },
      {
        speaker: 'MarkChat Android Bridge',
        role: 'System Action',
        text: 'Android SMS Bridge matched receipt: KES 4,500 from DANIEL OCHIENG (Ref: RH39201L).',
        type: 'system',
        time: '09:18',
      },
      {
        speaker: 'Alphanumeric Dispatch Alert',
        role: 'Automated Broadcast',
        text: 'SMS delivered via AUTOPARTS: "Mzigo wako umetumwa na Modern Coast Waybill #MC8812. Shukran!"',
        type: 'success',
        time: '09:20',
      },
    ],
  },
];

// Core Engineering & Product Principles
const corePrinciples = [
  {
    id: 'kenya-first',
    title: 'Built for Kenya First',
    description:
      'Engineered specifically for local commerce realities: Safaricom Paybill, Buy Goods Tills, Pochi la Biashara, and WhatsApp sales across East Africa.',
    icon: 'lucide:map-pin',
    badge: 'Local Context',
  },
  {
    id: 'fraud-shield',
    title: 'Real-Time Fraud Prevention',
    description:
      'Helps staff verify payment references through configured provider integrations rather than trusting SMS screenshots.',
    icon: 'lucide:shield-check',
    badge: 'Fraud Shield',
  },
  {
    id: 'conversational-speed',
    title: 'Conversational Speed',
    description:
      'Use configured M-Pesa STK workflows to reduce manual payment steps, subject to Safaricom availability and merchant authorization.',
    icon: 'lucide:zap',
    badge: 'Checkout Velocity',
  },
  {
    id: 'radical-simplicity',
    title: 'Radical Simplicity',
    description:
      'Use guided workspace setup and configure the channels approved for your business. Provider onboarding time can vary.',
    icon: 'lucide:sparkles',
    badge: 'Zero Friction',
  },
];

// Leadership profiles are intentionally withheld until verified.

// Verified Kenyan Merchant FAQs
const homepageFaqs = [
  {
    question: 'How does the in-chat /stk command work?',
    answer:
      'While chatting with a customer in WhatsApp or live chat, an authorized agent types `/stk <amount> <phone>` (for example `/stk 2500 0712345678`). MarkChat communicates directly with Safaricom’s Daraja API to trigger a SIM Toolkit prompt on the customer’s phone. The customer enters their M-Pesa PIN, and once approved, Safaricom sends an encrypted callback to MarkChat that verifies the transaction and logs the receipt in the conversation thread.',
  },
  {
    question: 'Do I need a Safaricom Daraja developer account to use MarkChat?',
    answer:
      'No. If you have an existing Safaricom Business Paybill or Buy Goods Till, you can connect it directly using our guided integration setup. For merchants using Pochi la Biashara or personal mobile lines, our MarkChat Android SMS Bridge allows you to stream payment confirmations securely without technical Daraja API setup.',
  },
  {
    question: 'Does MarkChat charge a percentage fee on my M-Pesa transactions?',
    answer:
      'MarkChat Core plans are recurring workspace subscriptions. SMS prepaid credits and provider transaction charges are separate; review the current plan and provider tariffs before purchasing.',
  },
  {
    question: 'Can my team respond to WhatsApp and SMS from the same interface?',
    answer:
      'MarkChat Core is designed for teams to manage supported messaging channels in one workspace. SMS Studio is a separate prepaid service and full inbox federation depends on configured integrations.',
  },
  {
    question: 'What is Bring Your Own Credentials (BYOC) for Bulk SMS?',
    answer:
      'BYOC allows you to connect your own Africa’s Talking API key and approved Alphanumeric Sender ID directly into MarkChat. You pay Africa’s Talking directly at your negotiated carrier volume rates, while using MarkChat’s shared inbox to manage two-way SMS conversations and marketing campaigns.',
  },
  {
    question: 'How does Markcopilot handle Swahili and Sheng conversations?',
    answer:
      'Markcopilot is trained on East African commercial communication patterns. It understands colloquial Sheng expressions, regional English dialects, and polite formal Swahili. In Agent Assist mode, it suggests 1-click draft responses for human review, and in Autonomous mode, it can deflect common repetitive questions about store hours, locations, and pricing.',
  },
];
---

<MarketingLayout
  title={`${siteConfig.name} - Unified Customer Conversations & Engagement Platform`}
  description="Bring customer conversations, engagement, and sales together. Unify WhatsApp Business, Africa’s Talking SMS, Instagram DMs, Messenger, and live chat with Markcopilot AI and in-chat M-Pesa."
>
  <!-- 1. Hero Section (Unified Customer Communications Platform) -->
  {
    sections.hero && (
      <Hero
        title="Bring Customer Conversations, Engagement & Sales Together"
        subtitle="Unify WhatsApp Business Cloud, Africa’s Talking Bulk SMS, Instagram DMs, Messenger, and website live chat into one collaborative team inbox. Empower your support team, automate repetitive queries with Markcopilot AI, and close deals with in-chat M-Pesa."
        badge="Unified Customer Communications & Engagement Platform"
        primaryCTA={{
          label: 'Book Live Demo',
          href: '/demo',
        }}
        secondaryCTA={{
          label: 'Explore Plans & Pricing',
          href: '/pricing',
        }}
        stats={[
          { value: '6 Channels', label: 'Single Shared Hub' },
          { value: '< 10s', label: 'In-Chat /stk Delivery' },
          { value: 'Bilingual AI', label: 'English, Swahili & Sheng', highlight: true },
        ]}
      />
    )
  }

  <!-- 2. Omnichannel Vector Pulse Flow Hub -->
  {sections.omnichannelFlow && <OmnichannelFlowHub />}

  <!-- 3. How It Works (3 Concrete Steps) -->
  {
    sections.howItWorks && (
      <HowItWorks
        title="How MarkChat Operates in 3 Concrete Steps"
        subtitle="From channel connection to collaborative team engagement and instant in-chat payment settlement."
        steps={[
          {
            title: '1. Connect Your Communication Channels',
            description:
              'Link your official WhatsApp Business Cloud API number, Africa’s Talking SMS credentials, and social messaging inboxes.',
            icon: 'lucide:link-2',
          },
          {
            title: '2. Collaborate & Automate with Markcopilot AI',
            description:
              'Assign conversations across teammates, detect collisions, and let bilingual AI handle routine FAQs in English, Swahili, and Sheng.',
            icon: 'lucide:sparkles',
          },
          {
            title: '3. Close Deals with In-Chat M-Pesa /stk',
            description:
              'Trigger instant Safaricom SIM Toolkit PIN prompts in-thread. MarkChat reconciles the Daraja C2B callback and logs verified receipts.',
            icon: 'lucide:check-circle-2',
          },
        ]}
        variant="horizontal"
        background="default"
      />
    )
  }

  <!-- 4. Substantive Core Capabilities Breakdown -->
  {
    sections.coreCapabilities && (
      <FeaturesSection
        title="Core Architecture Built for African Commerce"
        subtitle="A unified platform engineered around local payment habits, telco infrastructure, and multilingual customer engagement."
        features={coreCapabilities}
        background="muted"
        footerLink={{ label: 'Explore complete feature directory →', href: '/features' }}
      />
    )
  }

  <!-- 5. Real-World Operational Scenarios Walkthrough -->
  {
    sections.operationalScenarios && (
      <section class="py-16 sm:py-24 bg-surface/40 border-y border-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl mx-auto text-center mb-16">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 mb-4">
              <Icon name="lucide:workflow" class="w-3.5 h-3.5" />
              <span>Operational Scenarios</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text">
              Illustrative Kenyan Merchant Workflows
            </h2>
            <p class="mt-4 text-base sm:text-lg text-text-muted">
              Examples illustrating possible customer-support and payment journeys. They are not
              verified client transactions, live provider receipts or evidence of deployment.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {operationalScenarios.map((scenario) => (
              <div class="bg-surface border border-border rounded-2xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between overflow-hidden">
                <div>
                  {/* Chat Window Chrome / Header */}
                  <div class="px-4 py-3 bg-surface-hover/80 border-b border-border/80 flex items-center justify-between">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <div
                        class={`w-7 h-7 rounded-lg bg-surface border border-border flex items-center justify-center shrink-0 ${scenario.channelColor}`}
                      >
                        <Icon name={scenario.channelIcon} class="w-4 h-4" />
                      </div>
                      <div class="min-w-0">
                        <div class="flex items-center gap-1.5">
                          <span class="text-xs font-bold text-text truncate">
                            {scenario.channelName}
                          </span>
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0" />
                        </div>
                        <p class="text-[10px] text-text-muted font-mono truncate">
                          {scenario.recipient}
                        </p>
                      </div>
                    </div>
                    <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-primary/10 text-primary border border-primary/20 shrink-0">
                      {scenario.badge}
                    </span>
                  </div>

                  {/* Scenario Title Bar */}
                  <div class="px-4 pt-4 pb-2">
                    <h3 class="text-base font-bold text-text leading-snug">{scenario.title}</h3>
                    <p class="text-xs text-text-muted mt-0.5">{scenario.subtitle}</p>
                  </div>

                  {/* Step-by-Step Message Thread */}
                  <div class="p-4 space-y-3">
                    {scenario.steps.map((step) => (
                      <div
                        class={`p-3 rounded-xl text-xs leading-relaxed transition-colors ${
                          step.type === 'customer'
                            ? 'bg-surface border border-border text-text shadow-xs'
                            : step.type === 'agent'
                              ? 'bg-blue-50/70 dark:bg-blue-950/30 border border-blue-200/80 dark:border-blue-800/40 text-text shadow-xs'
                              : step.type === 'system'
                                ? 'bg-amber-50 dark:bg-amber-950/40 border border-amber-200/90 dark:border-amber-800/60 text-amber-950 dark:text-amber-200 font-mono text-[11px]'
                                : 'bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200/90 dark:border-emerald-800/60 text-emerald-950 dark:text-emerald-200 font-mono text-[11px]'
                        }`}
                      >
                        <div class="flex items-center justify-between mb-1">
                          <span
                            class={`font-bold text-[10px] uppercase tracking-wider ${
                              step.type === 'customer'
                                ? 'text-text-muted'
                                : step.type === 'agent'
                                  ? 'text-primary'
                                  : step.type === 'system'
                                    ? 'text-amber-800 dark:text-amber-300'
                                    : 'text-emerald-800 dark:text-emerald-300'
                            }`}
                          >
                            {step.speaker}
                          </span>
                          <span class="text-[10px] opacity-60 font-mono">{step.time}</span>
                        </div>
                        <div class="leading-relaxed">{step.text}</div>
                      </div>
                    ))}
                  </div>
                </div>

                {/* Card Footer */}
                <div class="px-4 py-3 bg-surface-hover/50 border-t border-border/70 flex items-center justify-between text-xs text-text-muted">
                  <span class="inline-flex items-center gap-1.5 text-[11px] text-text-muted font-mono">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" />
                    {scenario.reconciliationBadge}
                  </span>
                  <a href="/demo" class="text-primary hover:underline font-medium text-xs">
                    Live demo →
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 6. Markcopilot AI Explainer Node Tree -->
  {sections.markcopilot && <MarkcopilotExplainer />}

  <!-- 7. Business Solutions & Industry Use Cases Preview -->
  {sections.solutionsPreview && <SolutionsPreview />}

  <!-- 8. Featured African Integrations Grid -->
  {
    sections.integrations && (
      <IntegrationsGrid
        title="Mobile Money & African Telco Integrations"
        subtitle="Direct connections for local infrastructure: Safaricom Daraja C2B, Africa’s Talking, and Meta Cloud API."
        integrations={featuredIntegrations}
        variant="detailed"
        invertOnDark={false}
        columns={3}
        background="default"
        footerLink={{ label: 'View all integrations →', href: '/integrations' }}
      />
    )
  }

  <!-- 9. Dynamic KES Pricing Table -->
  {
    sections.pricing && (
      <PricingTable
        title="Transparent KES Pricing for Kenyan Merchants"
        subtitle="Predictable monthly plans designed for growing businesses. Connect your channels, collaborate with your team, and SMS credits are prepaid and sold separately. Annual subscription checkout is not yet available."
        plans={pricingPlans}
        annualDiscount={20}
        background="muted"
        footerLink={{ label: 'View full plan comparison & feature matrix →', href: '/pricing' }}
      />
    )
  }

  <!-- 10. Core Principles & Nairobi Engineering Leadership -->
  {
    sections.kenyaPrinciples && (
      <section class="py-16 sm:py-24 bg-surface/40 border-t border-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          {/* Section Header */}
          <div class="max-w-3xl mx-auto text-center mb-16">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 mb-4">
              <Icon name="lucide:shield-check" class="w-3.5 h-3.5" />
              <span>Local Engineering & Integrity</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text">
              Engineered in Nairobi for African Commerce Reality
            </h2>
            <p class="mt-4 text-base sm:text-lg text-text-muted">
              We do not build generic Western SaaS. We build software adapted directly to Kenyan
              payment flows, local carrier infrastructure, and multilingual customer interactions.
            </p>
          </div>

          {/* 4 Core Principles Bento Grid */}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            {corePrinciples.map((principle) => (
              <div class="bg-surface border border-border rounded-2xl p-6 shadow-xs hover:border-primary/40 transition-all flex flex-col justify-between">
                <div>
                  <div class="w-10 h-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-4">
                    <Icon name={principle.icon} class="w-5 h-5" />
                  </div>
                  <span class="text-[10px] font-semibold uppercase tracking-wider text-primary font-mono">
                    {principle.badge}
                  </span>
                  <h3 class="text-base font-bold text-text mt-1 mb-2">{principle.title}</h3>
                  <p class="text-xs text-text-muted leading-relaxed">{principle.description}</p>
                </div>
              </div>
            ))}
          </div>

          {/* Leadership profiles omitted until real identities and titles are verified. */}
        </div>
      </section>
    )
  }

  <!-- 11. Frequently Asked Questions -->
  {
    sections.faqs && (
      <FAQSection
        title="Frequently Asked Questions"
        subtitle="Everything you need to know about setting up MarkChat, connecting Safaricom M-Pesa, and managing team messaging."
        faqs={homepageFaqs}
      />
    )
  }

  <!-- 12. Bottom Action CTA -->
  {
    sections.closingCta && (
      <CTA
        title={
          homepageSettings.closingCta?.title ||
          'Ready to bring customer conversations, engagement and sales together?'
        }
        description={
          homepageSettings.closingCta?.description ||
          'Empower your team with a unified inbox across WhatsApp, SMS, and social channels. Automate support with Markcopilot AI and close sales with in-chat M-Pesa.'
        }
        action={{
          label: homepageSettings.closingCta?.primaryCtaLabel || 'Book Live Demo',
          href: homepageSettings.closingCta?.primaryCtaHref || '/demo',
        }}
        secondaryAction={{
          label: homepageSettings.closingCta?.secondaryCtaLabel || 'Explore Plans & Pricing',
          href: homepageSettings.closingCta?.secondaryCtaHref || '/pricing',
        }}
        background="default"
      />
    )
  }

  <!-- 13. Newsletter -->
  {sections.newsletter && <Newsletter />}
</MarketingLayout>
