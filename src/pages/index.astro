---
/**
 * MarkChat Kenya — Homepage
 *
 * "Turn Every Customer Chat into an Instant M-Pesa Sale"
 * Grounded in verified product capabilities and authentic Kenyan commerce workflows.
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Hero from '@sections/marketing/Hero.astro';
import HowItWorks from '@sections/marketing/HowItWorks.astro';
import OmnichannelFlowHub from '@sections/marketing/OmnichannelFlowHub.astro';
import MarkcopilotExplainer from '@sections/marketing/MarkcopilotExplainer.astro';
import IntegrationsGrid from '@sections/marketing/IntegrationsGrid.astro';
import PricingTable from '@sections/pricing/PricingTable.astro';
import FeaturesSection from '@sections/marketing/FeaturesSection.astro';
import FAQSection from '@sections/content/FAQSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import Newsletter from '@sections/marketing/Newsletter.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config';
import { fetchPricingMatrix, fetchIntegrations } from '@/lib/cms-api';

const [pricingMatrix, allIntegrations] = await Promise.all([
  fetchPricingMatrix(),
  fetchIntegrations(),
]);

const APP_URL = import.meta.env.PUBLIC_APP_URL || 'http://localhost:3000';

const featuredIntegrations = allIntegrations
  .filter((i) => i.isFeatured)
  .slice(0, 6)
  .map((i) => ({
    slug: i.slug,
    name: i.name,
    category: i.category,
    iconKey: i.iconKey,
    logoUrl: i.logoUrl,
    isPopular: i.isPopular,
    shortDescription: i.shortDescription,
    href: `/integrations/${i.slug}`,
  }));

const pricingPlans = pricingMatrix.tiers.map((tier) => ({
  name: tier.name,
  monthlyPrice: tier.monthlyPrice,
  customPrice: tier.monthlyPrice === null ? 'Custom' : undefined,
  description: tier.description,
  features: tier.features,
  highlighted: tier.highlighted,
  badge: tier.badge,
  cta: {
    label: tier.ctaLabel,
    href: tier.ctaHref,
  },
}));

// Authentic Core Product Capabilities
const coreCapabilities = [
  {
    icon: 'lucide:inbox',
    title: 'Collaborative Omnichannel Inbox',
    description:
      'Unify WhatsApp Cloud API, Africa’s Talking Bulk SMS, Instagram DMs, Facebook Messenger, and website live chat into one workspace with team collision detection and private notes.',
  },
  {
    icon: 'lucide:smartphone',
    title: 'In-Chat /stk M-Pesa Prompts',
    description:
      'Agents trigger instant Safaricom SIM Toolkit PIN prompts directly within customer chat threads using /stk <amount> <phone>, eliminating account number typing errors.',
  },
  {
    icon: 'lucide:shield-check',
    title: 'Automated Callback Verification',
    description:
      'Reconcile Safaricom Daraja C2B webhook notifications in real time. Validate payments before releasing goods and eliminate fraudulent SMS screenshot deception.',
  },
  {
    icon: 'lucide:message-square',
    title: 'Africa’s Talking Bulk SMS & BYOC',
    description:
      'Send transactional notifications and promotional SMS broadcasts using your own approved Alphanumeric Sender ID, with two-way conversation threading.',
  },
  {
    icon: 'lucide:sparkles',
    title: 'Bilingual Markcopilot AI',
    description:
      'Dual-mode artificial intelligence that drafts contextual agent replies in English, Swahili, and Sheng, while autonomously handling common catalog and order questions.',
  },
  {
    icon: 'lucide:layers',
    title: 'Pochi la Biashara & Till Android Sync',
    description:
      'Connect small-merchant Pochi la Biashara and Buy Goods lines via our dedicated Android SMS bridge APK, streaming mobile payment receipts directly into customer records.',
  },
];

// Substantive Real-World Operational Scenarios
const operationalScenarios = [
  {
    title: 'Retail & Social Commerce',
    subtitle: 'From WhatsApp Product Inquiries to Instant STK Settlement',
    badge: 'WhatsApp + STK',
    steps: [
      {
        speaker: 'Customer (WhatsApp)',
        text: 'Habari, do you have the leather sneakers size 43 in black? How much with delivery to Westlands?',
        type: 'customer',
      },
      {
        speaker: 'Agent (MarkChat)',
        text: 'Habari! Yes, size 43 black is available in stock. Price is KES 3,800 plus KES 250 boda delivery.',
        type: 'agent',
      },
      {
        speaker: 'System (/stk Prompt)',
        text: 'Agent executed: /stk 4050 0722123456 → Safaricom PIN prompt pushed to customer handset.',
        type: 'system',
      },
      {
        speaker: 'M-Pesa Verified Callback',
        text: 'Confirmed: KES 4,050 received from PETER KAMAU (Ref: QHL81920). Order marked PAID automatically.',
        type: 'success',
      },
    ],
  },
  {
    title: 'Medical Clinics & Appointment Services',
    subtitle: 'Automated Consultation Deposits & SMS Reminders',
    badge: 'SMS + Paybill',
    steps: [
      {
        speaker: 'Patient (Website Live Chat)',
        text: 'I would like to schedule a dental checkup for tomorrow at 2:00 PM at your Upper Hill clinic.',
        type: 'customer',
      },
      {
        speaker: 'Markcopilot AI',
        text: 'Dental checkup slot for tomorrow 2:00 PM is open. A KES 500 appointment deposit confirms your slot.',
        type: 'agent',
      },
      {
        speaker: 'System (C2B Paybill Matching)',
        text: 'Payment received on Paybill 625100 with Account DENT-104. Slot locked and clinic calendar updated.',
        type: 'system',
      },
      {
        speaker: 'Africa’s Talking SMS Broadcast',
        text: 'SMS delivered to patient via SENDER ID: "CLINICCARE: Your dental appointment is confirmed for tomorrow 2PM."',
        type: 'success',
      },
    ],
  },
];

// Verified Kenyan Merchant FAQs
const homepageFaqs = [
  {
    question: 'How does the in-chat /stk command work?',
    answer:
      'While chatting with a customer in WhatsApp or live chat, an authorized agent types `/stk <amount> <phone>` (for example `/stk 2500 0712345678`). MarkChat communicates directly with Safaricom’s Daraja API to trigger a SIM Toolkit prompt on the customer’s phone. The customer enters their M-Pesa PIN, and once approved, Safaricom sends an encrypted callback to MarkChat that verifies the transaction and logs the receipt in the conversation thread.',
  },
  {
    question: 'Do I need a Safaricom Daraja developer account to use MarkChat?',
    answer:
      'No. If you have an existing Safaricom Business Paybill or Buy Goods Till, you can connect it directly using our guided integration setup. For merchants using Pochi la Biashara or personal mobile lines, our MarkChat Android SMS Bridge allows you to stream payment confirmations securely without technical Daraja API setup.',
  },
  {
    question: 'Does MarkChat charge a percentage fee on my M-Pesa transactions?',
    answer:
      'No. MarkChat does not charge percentage transaction fees on your sales. Standard Safaricom Daraja telco tariffs apply directly between you and Safaricom. MarkChat charges a predictable monthly or annual software subscription fee for the communication inbox and automation features.',
  },
  {
    question: 'Can my team respond to WhatsApp and SMS from the same interface?',
    answer:
      'Yes. MarkChat unifies WhatsApp Business Cloud, Africa’s Talking Bulk SMS, Instagram Direct Messages, Facebook Messenger, and website live chat into a single collaborative inbox. Teammates can be assigned specific conversations, leave private internal notes, and avoid replying to the same customer simultaneously.',
  },
  {
    question: 'What is Bring Your Own Credentials (BYOC) for Bulk SMS?',
    answer:
      'BYOC allows you to connect your own Africa’s Talking API key and approved Alphanumeric Sender ID directly into MarkChat. You pay Africa’s Talking directly at your negotiated carrier volume rates, while using MarkChat’s shared inbox to manage two-way SMS conversations and marketing campaigns.',
  },
  {
    question: 'How does Markcopilot handle Swahili and Sheng conversations?',
    answer:
      'Markcopilot is trained on East African commercial communication patterns. It understands colloquial Sheng expressions, regional English dialects, and polite formal Swahili. In Agent Assist mode, it suggests 1-click draft responses for human review, and in Autonomous mode, it can deflect common repetitive questions about store hours, locations, and pricing.',
  },
];
---

<MarketingLayout
  title={`${siteConfig.name} - Turn Every Customer Chat into an Instant M-Pesa Sale`}
  description={siteConfig.description}
>
  <!-- 1. Hero Section -->
  <Hero
    title="Turn Every Customer Chat into an Instant M-Pesa Sale"
    subtitle="Unify WhatsApp Business Cloud, Africa’s Talking Bulk SMS, Instagram DMs, and Facebook Messenger into one shared inbox. Trigger in-chat /stk PIN prompts and auto-verify Safaricom payments in seconds."
    primaryCTA={{
      label: 'Start Free — 50 Trial SMS Included',
      href: `${APP_URL}/app/auth/signup`,
    }}
    secondaryCTA={{
      label: 'Book Live Demo',
      href: '/demo',
    }}
    backgroundType="gradient"
    gradient="from-primary/15 via-background to-background"
  />

  <!-- 2. Omnichannel Vector Pulse Flow Hub -->
  <OmnichannelFlowHub />

  <!-- 3. How It Works (3 Concrete Steps) -->
  <HowItWorks
    title="How MarkChat Operates in 3 Concrete Steps"
    subtitle="From account setup to verified in-chat mobile money reconciliation in minutes."
    steps={[
      {
        title: '1. Connect Your Communication Channels',
        description:
          'Link your official WhatsApp Business Cloud API number, Africa’s Talking SMS credentials, and social messaging inboxes.',
        icon: 'lucide:link-2',
      },
      {
        title: '2. Configure Your Payment Destination',
        description:
          'Connect your Safaricom Paybill, Buy Goods Till, or Pochi la Biashara line via direct Daraja API callbacks or the Android Bridge.',
        icon: 'lucide:smartphone',
      },
      {
        title: '3. Close Sales with In-Chat /stk',
        description:
          'Agents type /stk to push SIM Toolkit prompts directly to buyers. MarkChat validates the Safaricom callback and generates the receipt.',
        icon: 'lucide:check-circle-2',
      },
    ]}
    variant="horizontal"
    background="default"
  />

  <!-- 4. Substantive Core Capabilities Breakdown -->
  <FeaturesSection
    title="Core Architecture Built for African Commerce"
    subtitle="A unified platform engineered around local payment habits, telco infrastructure, and multilingual customer engagement."
    features={coreCapabilities}
    background="muted"
    footerLink={{ label: 'Explore complete feature directory →', href: '/features' }}
  />

  <!-- 5. Real-World Operational Scenarios Walkthrough -->
  <section class="py-16 sm:py-24 bg-surface/40 border-y border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 mb-4"
        >
          <Icon name="lucide:workflow" class="w-3.5 h-3.5" />
          <span>Operational Scenarios</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text">
          Real-World Merchant Workflows in Action
        </h2>
        <p class="mt-4 text-base sm:text-lg text-text-muted">
          See how Kenyan businesses eliminate manual screenshot verification, speed up order
          settlement, and maintain customer context across channels.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {
          operationalScenarios.map((scenario) => (
            <div class="bg-surface border border-border rounded-2xl p-6 sm:p-8 shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
                    {scenario.badge}
                  </span>
                  <span class="text-xs text-text-muted">Interactive Simulation</span>
                </div>
                <h3 class="text-xl font-bold text-text mb-2">{scenario.title}</h3>
                <p class="text-sm text-text-muted mb-6">{scenario.subtitle}</p>

                {/* Step-by-Step Message Thread */}
                <div class="space-y-3 bg-surface-hover/60 p-4 rounded-xl border border-border/80">
                  {scenario.steps.map((step) => (
                    <div
                      class={`p-3 rounded-lg text-xs leading-relaxed ${
                        step.type === 'customer'
                          ? 'bg-surface border border-border text-text'
                          : step.type === 'agent'
                            ? 'bg-primary/10 border border-primary/20 text-text'
                            : step.type === 'system'
                              ? 'bg-amber-500/10 border border-amber-500/20 text-amber-300 font-mono'
                              : 'bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 font-mono'
                      }`}
                    >
                      <div class="font-bold text-[10px] uppercase tracking-wider mb-1 opacity-80">
                        {step.speaker}
                      </div>
                      <div>{step.text}</div>
                    </div>
                  ))}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-border/60 flex items-center justify-between text-xs text-text-muted">
                <span>Direct reconciliation via Daraja webhooks</span>
                <a href="/demo" class="text-primary hover:underline font-medium">
                  See live in demo →
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Markcopilot AI Explainer Node Tree -->
  <MarkcopilotExplainer />

  <!-- 7. Featured African Integrations Grid -->
  <IntegrationsGrid
    title="Mobile Money & African Telco Integrations"
    subtitle="Direct connections for local infrastructure: Safaricom Daraja C2B, Africa’s Talking, and Meta Cloud API."
    integrations={featuredIntegrations}
    variant="detailed"
    invertOnDark={false}
    columns={3}
    background="default"
    footerLink={{ label: 'View all integrations →', href: '/integrations' }}
  />

  <!-- 8. Dynamic KES Pricing Table -->
  <PricingTable
    title="Transparent KES Pricing for Kenyan Merchants"
    subtitle="Start free with 50 SMS credits and scale as your monthly conversation volume grows. Save 20% on annual commitments."
    plans={pricingPlans}
    annualDiscount={20}
    background="muted"
    footerLink={{ label: 'View full plan comparison & feature matrix →', href: '/pricing' }}
  />

  <!-- 9. Frequently Asked Questions -->
  <FAQSection
    title="Frequently Asked Questions"
    subtitle="Everything you need to know about setting up MarkChat, connecting Safaricom M-Pesa, and managing team messaging."
    faqs={homepageFaqs}
  />

  <!-- 10. Bottom Action CTA -->
  <CTA
    title="Ready to transform your customer messaging into verified sales?"
    description="Create your merchant workspace in 30 seconds. Test in-chat /stk prompts and receive 50 complimentary Bulk SMS credits."
    action={{ label: 'Start Free Forever', href: `${APP_URL}/app/auth/signup` }}
    background="default"
  />

  <!-- 11. Newsletter -->
  <Newsletter />
</MarketingLayout>
