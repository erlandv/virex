---
/**
 * MarkChat — Kenya-first, Community-safe, product-led homepage.
 * All media is CMS-published, locally verified, or an accessible fallback.
 * This page intentionally does not advertise the deferred SMS product line.
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Hero from '@sections/marketing/Hero.astro';
import LivePlatformWorkbench from '@/components/enterprise/LivePlatformWorkbench.astro';
import OmnichannelFlowHub from '@sections/marketing/OmnichannelFlowHub.astro';
import HowItWorks from '@sections/marketing/HowItWorks.astro';
import SolutionsPreview from '@sections/marketing/SolutionsPreview.astro';
import PricingTable from '@sections/pricing/PricingTable.astro';
import FAQSection from '@sections/content/FAQSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import Newsletter from '@sections/marketing/Newsletter.astro';
import MCSection from '@/components/design-system/MCSection.astro';
import MCSectionHeading from '@/components/design-system/MCSectionHeading.astro';
import MCFeatureBento from '@/components/design-system/MCFeatureBento.astro';
import MCButton from '@/components/design-system/MCButton.astro';
import { communityIllustrations } from '@/data/product-assets';
import type { ProductWorkflow, CmsProductMediaOverride } from '@/data/product-assets';
import { siteConfig } from '@/config';
import { fetchHomepageSettings, fetchPricingMatrix, fetchFeatures, fetchFaqs } from '@/lib/cms-api';

const [homepageSettings, pricingMatrix, publishedFeatures, publishedFaqs] = await Promise.all([
  fetchHomepageSettings(),
  fetchPricingMatrix(),
  fetchFeatures(),
  fetchFaqs(),
]);

const sections = homepageSettings.sections;
const newsletterAction = import.meta.env.PUBLIC_NEWSLETTER_ACTION_URL || '';
const verifiedNewsletterAction =
  newsletterAction.startsWith('/') && !newsletterAction.startsWith('//') ? newsletterAction : '';

const deferredTerms =
  /(?:bulk\s+)?sms|sender\s+id|byoc|saml|sso|audit\s+logs?|custom\s+roles?|captain\s+ai|agent\s+capacity|\bsla\b/i;
const legacyHeroTitle = /Bring Customer Conversations, Engagement & Sales Together/i;
const legacyDefaultCopy = /bring customer conversations, engagement and sales together/i;

function cleanCoreCopy(value: string | undefined, fallback: string): string {
  if (!value || deferredTerms.test(value) || legacyHeroTitle.test(value)) return fallback;
  return value;
}

function safeInternalPath(value: string | undefined, fallback: string): string {
  if (
    value &&
    /^\/(?![/\\])/.test(value) &&
    !value.includes('\\') &&
    !value.includes(':') &&
    !Array.from(value).some((character) => character.charCodeAt(0) < 32)
  ) {
    return value;
  }
  return fallback;
}

const heroTitle = 'Every conversation. One smarter inbox.';
const heroSubtitle =
  'Built for Kenyan businesses. Manage conversations, review Markcopilot AI suggestions, and connect authorized M-Pesa payment workflows.';
const cmsHeroTitle = cleanCoreCopy(homepageSettings.hero?.title, heroTitle);
const cmsHeroSubtitle = cleanCoreCopy(homepageSettings.hero?.subtitle, heroSubtitle);
const hasLegacyHeroActions =
  homepageSettings.hero?.primaryCtaLabel === 'Book Live Demo' &&
  homepageSettings.hero?.secondaryCtaLabel === 'Explore Plans & Pricing';
const heroPrimaryAction = {
  label: hasLegacyHeroActions
    ? 'Get Started'
    : cleanCoreCopy(homepageSettings.hero?.primaryCtaLabel, 'Get Started'),
  href: hasLegacyHeroActions
    ? '/register'
    : safeInternalPath(homepageSettings.hero?.primaryCtaHref, '/register'),
};
const heroSecondaryAction = {
  label: hasLegacyHeroActions
    ? 'Book a Demo'
    : cleanCoreCopy(homepageSettings.hero?.secondaryCtaLabel, 'Book a Demo'),
  href: hasLegacyHeroActions
    ? '/demo'
    : safeInternalPath(homepageSettings.hero?.secondaryCtaHref, '/demo'),
};

const cmsMedia: Partial<Record<ProductWorkflow, CmsProductMediaOverride>> = {};
for (const feature of publishedFeatures) {
  if (feature.status !== 'published' || feature.mediaType !== 'screenshot' || !feature.mediaUrl) {
    continue;
  }
  const name = (feature.slug + ' ' + feature.title).toLowerCase();
  let workflow: ProductWorkflow | null = null;
  if (/inbox|conversation/.test(name)) workflow = 'inbox';
  else if (/mpesa|m-pesa|checkout|daraja/.test(name)) workflow = 'mpesa';
  else if (/markcopilot|ai-assist|ai-reply/.test(name)) workflow = 'markcopilot';
  if (workflow && !cmsMedia[workflow]) {
    cmsMedia[workflow] = {
      status: feature.status,
      mediaUrl: feature.mediaUrl,
      mediaAlt: feature.mediaAlt || feature.title,
    };
  }
}

const capabilities = [
  {
    id: 'unified-inbox',
    title: 'Unified Inbox',
    description:
      'Manage connected conversations, assignments, and customer context in one workspace.',
    icon: 'lucide:inbox',
    href: '/product/shared-inbox',
  },
  {
    id: 'mpesa-stk',
    title: 'M-Pesa Checkout',
    description:
      'Coordinate approved Daraja /stk payment requests and review callback status in context.',
    icon: 'lucide:wallet-cards',
    href: '/integrations/safaricom-mpesa-daraja',
  },
  {
    id: 'markcopilot',
    title: 'Markcopilot AI',
    description:
      'Get contextual reply suggestions for human review before responding to customers.',
    icon: 'lucide:sparkles',
    href: '/markcopilot',
  },
  {
    id: 'automation-routing',
    title: 'Automation & Routing',
    description: 'Organize supported rules, team queues, and conversation assignments.',
    icon: 'lucide:workflow',
    href: '/features/automation-and-routing',
  },
  {
    id: 'contact-crm',
    title: 'Contact CRM',
    description: 'Keep contact details, conversations, and authorized follow-ups together.',
    icon: 'lucide:contact-round',
    href: '/product/crm-workspace',
  },
  {
    id: 'help-center',
    title: 'Self-Service Help Center',
    description: 'Help customers find answers from your published support knowledge.',
    icon: 'lucide:book-open',
    href: '/product/help-center',
  },
  {
    id: 'analytics-webhooks',
    title: 'Analytics & Webhooks',
    description:
      'Understand supported conversation activity and connect documented event workflows.',
    icon: 'lucide:chart-no-axes-combined',
    href: '/integrations/developer-api-webhooks',
  },
].map((feature) => ({
  ...feature,
  illustration: communityIllustrations.find((item) => item.id === feature.id)?.path,
}));

const pricingPlans = pricingMatrix.tiers.map((tier) => {
  const features = tier.features
    .filter(
      (feature) => !deferredTerms.test(feature) && !/guaranteed|unlimited channels/i.test(feature)
    )
    .slice(0, 5);
  return {
    name: tier.name,
    monthlyPrice: tier.monthlyPrice,
    customPrice: tier.monthlyPrice === null ? 'Custom' : undefined,
    description: cleanCoreCopy(
      tier.description,
      'A MarkChat workspace plan with scope and integrations confirmed during onboarding.'
    ),
    features: features.length > 0 ? features : ['Shared customer conversation workspace'],
    highlighted: tier.highlighted,
    badge: cleanCoreCopy(tier.badge, 'Workspace plan'),
    cta: {
      label: tier.ctaLabel,
      href: safeInternalPath(tier.ctaHref, '/pricing'),
    },
  };
});

const coreFaqs = publishedFaqs
  .filter((item) => item.status === 'published')
  .filter((item) => !deferredTerms.test(item.question + ' ' + item.answer))
  .slice(0, 5)
  .map((item) => ({ question: item.question, answer: item.answer }));

const fallbackFaqs = [
  {
    question: 'Which customer channels can I connect?',
    answer:
      'MarkChat supports connected customer conversation workflows. Each channel requires the appropriate provider account, permissions and configuration.',
  },
  {
    question: 'How does M-Pesa checkout work?',
    answer:
      'Authorized merchants configure Safaricom Daraja credentials. Payment status must be confirmed through trusted provider callbacks, not screenshots.',
  },
  {
    question: 'Can Markcopilot send replies automatically?',
    answer:
      'Markcopilot can assist with drafting replies for human review. Other automation capabilities depend on the features enabled in your workspace.',
  },
  {
    question: 'Where can I see the plans?',
    answer:
      'See the subscription options on our pricing page. Billing and supported integrations are confirmed during signup and onboarding.',
  },
];
const homepageFaqs = coreFaqs.length >= 3 ? coreFaqs : fallbackFaqs;

const closingTitle = cleanCoreCopy(
  homepageSettings.closingCta?.title,
  'Bring your team and customer conversations together.'
);
const closingDescription = cleanCoreCopy(
  homepageSettings.closingCta?.description,
  'Start with a shared inbox, add eligible channels, and explore the workflows that fit your Kenyan business.'
);
const finalTitle = legacyDefaultCopy.test(closingTitle)
  ? 'Bring your team and customer conversations together.'
  : closingTitle;
---

<MarketingLayout
  title={siteConfig.name + ' — One Inbox for Kenyan Businesses'}
  description="Manage customer conversations from supported channels, review Markcopilot AI replies, and connect authorized M-Pesa payment workflows."
>
  {
    sections.hero && (
      <Hero
        title={cmsHeroTitle}
        subtitle={cmsHeroSubtitle}
        badge={cleanCoreCopy(homepageSettings.hero?.badge, 'BUILT FOR KENYAN BUSINESSES')}
        primaryCTA={heroPrimaryAction}
        secondaryCTA={heroSecondaryAction}
        cmsMedia={cmsMedia.inbox}
        heroMedia={homepageSettings.hero?.heroMedia}
      />
    )
  }

  <LivePlatformWorkbench cmsMedia={cmsMedia} />

  {(sections.omnichannelFlow || sections.integrations) && <OmnichannelFlowHub />}

  {
    sections.coreCapabilities && (
      <MCSection tone="default" id="core-capabilities">
        <div class="mb-10">
          <MCSectionHeading
            eyebrow="Community-safe capabilities"
            title="The essentials for customer conversations and commerce"
            description="Seven connected workflows explained without premium-only capability claims."
          />
        </div>
        <MCFeatureBento features={capabilities} />
        <div class="mt-9">
          <MCButton href="/features" variant="secondary">
            Explore all features
          </MCButton>
        </div>
      </MCSection>
    )
  }

  {
    sections.howItWorks && (
      <HowItWorks
        title="How MarkChat works"
        subtitle="Connect your channels, organize customer inquiries, and complete supported workflows."
        steps={[
          {
            title: 'Connect customer channels',
            description:
              'Configure your approved WhatsApp Business Cloud, social messaging, web chat and email integrations.',
            icon: 'lucide:plug',
          },
          {
            title: 'Collaborate with your team',
            description:
              'Assign conversations, keep internal context, and review Markcopilot AI suggestions.',
            icon: 'lucide:users',
          },
          {
            title: 'Handle authorized M-Pesa workflows',
            description:
              'Use configured Daraja integration and verify outcomes from trusted callbacks.',
            icon: 'lucide:shield-check',
          },
        ]}
        variant="horizontal"
        background="muted"
      />
    )
  }

  {(sections.solutionsPreview || sections.operationalScenarios) && <SolutionsPreview />}

  {
    sections.markcopilot && (
      <MCSection tone="default" id="markcopilot-assist">
        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <MCSectionHeading
              eyebrow="Markcopilot AI"
              title="Faster replies, with people in control"
              description="Help your agents draft contextual responses in English and Kiswahili, with human review before sending."
            />
            <div class="mt-7">
              <MCButton href="/markcopilot" variant="secondary">
                Explore Markcopilot
              </MCButton>
            </div>
          </div>
          <div class="rounded-xl border border-border bg-surface p-6">
            <img
              src="/media/illustrations/markcopilot.svg"
              alt="Conceptual illustration of an AI-assisted customer reply"
              loading="lazy"
              class="mx-auto aspect-[5/4] max-h-64 w-full object-contain"
            />
            <p class="mt-3 text-xs text-text-muted">
              Conceptual illustration. AI assistance and language coverage depend on workspace
              configuration.
            </p>
          </div>
        </div>
      </MCSection>
    )
  }

  {
    sections.pricing && (
      <PricingTable
        flatPreview
        title="Straightforward Core subscription plans"
        subtitle="Choose a MarkChat workspace plan for your team. Channel setup and provider billing are confirmed separately."
        plans={pricingPlans}
        background="muted"
        footerLink={{ label: 'View complete plan details', href: '/pricing' }}
      />
    )
  }

  {
    sections.kenyaPrinciples && (
      <MCSection tone="default" id="kenya-first">
        <MCSectionHeading
          eyebrow="Kenya-first design"
          title="Built around the way Kenyan teams work"
          description="Customer conversations, local payments and business handoffs deserve straightforward, dependable software."
        />
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {[
            [
              'Local customer context',
              'Built for customer journeys across Kenyan retail and service businesses.',
            ],
            [
              'Verified payment status',
              'Use configured provider responses rather than relying on payment screenshots.',
            ],
            [
              'Human-led workflows',
              'Keep agents in control of customer service and AI-assisted replies.',
            ],
          ].map(([title, description]) => (
            <article class="rounded-xl border border-border bg-surface-elevated p-6">
              <h3 class="font-semibold text-text">{title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-text-muted">{description}</p>
            </article>
          ))}
        </div>
      </MCSection>
    )
  }

  {
    sections.faqs && (
      <FAQSection
        title="Frequently Asked Questions"
        subtitle="Practical answers about channels, M-Pesa, AI assistance, and getting started."
        faqs={homepageFaqs}
      />
    )
  }

  {
    sections.newsletter && verifiedNewsletterAction && (
      <Newsletter action={verifiedNewsletterAction} />
    )
  }

  {
    sections.closingCta && (
      <CTA
        title={finalTitle}
        description={closingDescription}
        action={heroPrimaryAction}
        secondaryAction={heroSecondaryAction}
        background="muted"
        variant="dark"
      />
    )
  }
</MarketingLayout>
