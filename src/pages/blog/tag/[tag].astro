---
/**
 * MarkChat Kenya — Blog Filter by Tag
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { siteConfig } from '@/config';
import { calculateReadingTime, formatDate } from '@/lib/utils';

type BlogPost = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: { data: BlogPost['data'] }) => !data.draft);
  const allTags = [...new Set(posts.flatMap((post: BlogPost) => post.data.tags))];

  return allTags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;

const posts = await getCollection('blog', ({ data }: { data: BlogPost['data'] }) => !data.draft);
const filteredPosts: BlogPost[] = posts
  .filter((post: BlogPost) => post.data.tags.includes(tag))
  .sort(
    (a: BlogPost, b: BlogPost) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
  );

// Get all unique tags for the filter
const allTags = [...new Set(posts.flatMap((post: BlogPost) => post.data.tags))].sort();

const FALLBACK_IMAGES = [
  '/images/blog/security-practices.webp',
  '/images/blog/scaling-million.webp',
  '/images/blog/virex-2-launch.webp',
  '/images/blog/deployment-workflow.webp',
];
---

<MarketingLayout
  title={`Posts tagged "${tag}" — ${siteConfig.name}`}
  description={`Browse all blog posts tagged with "${tag}" on the ${siteConfig.name} blog.`}
>
  <div
    class="py-16 sm:py-24 bg-slate-50 dark:bg-background min-h-screen transition-colors duration-200"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Header */}
      <div class="max-w-3xl mb-12">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline mb-4 group"
        >
          <span class="transition-transform duration-200 group-hover:-translate-x-1">&larr;</span>
          <span>Back to all articles</span>
        </a>
        <h1
          class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight"
        >
          Articles tagged with <span class="text-blue-600 dark:text-blue-400">"{tag}"</span>
        </h1>
        <p class="mt-2 text-base text-slate-600 dark:text-slate-400">
          Showing {filteredPosts.length}
          {filteredPosts.length === 1 ? 'article' : 'articles'}
        </p>
      </div>

      {/* Tags Filter Strip */}
      {
        allTags.length > 0 && (
          <div class="mb-12 overflow-x-auto pb-2 scrollbar-none">
            <div class="flex items-center gap-2">
              <a
                href="/blog"
                class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap bg-white dark:bg-surface border border-border dark:border-border text-slate-700 dark:text-slate-300 hover:border-blue-400"
              >
                All Topics
              </a>
              {allTags.map((t) => (
                <a
                  href={`/blog/tag/${t}`}
                  class:list={[
                    'px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition-all duration-200',
                    t === tag
                      ? 'bg-blue-600 text-white shadow-none '
                      : 'bg-white dark:bg-surface border border-border dark:border-border text-slate-700 dark:text-slate-300 hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400',
                  ]}
                >
                  #{t}
                </a>
              ))}
            </div>
          </div>
        )
      }

      {/* Grid of Posts */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          filteredPosts.map((post, idx) => {
            const authorName =
              typeof post.data.author === 'string' ? post.data.author : post.data.author.name;
            const coverImage =
              post.data.coverImage ||
              post.data.image ||
              FALLBACK_IMAGES[idx % FALLBACK_IMAGES.length];
            const category =
              post.data.category || (post.data.tags.length > 0 ? post.data.tags[0] : 'Article');
            const excerpt = post.data.excerpt || post.data.description;
            const readingTime = calculateReadingTime(post.body || '');
            const formattedDate = formatDate(post.data.publishedDate, {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            });

            return (
              <article class="bg-white dark:bg-surface border border-border dark:border-border rounded-xl overflow-hidden shadow-none transition-all duration-300 hover:-translate-y-1 flex flex-col group">
                <a
                  href={`/blog/${post.id}`}
                  class="block relative overflow-hidden bg-slate-100 dark:bg-slate-800"
                >
                  <img
                    src={coverImage}
                    alt={post.data.title}
                    class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute top-3 left-3">
                    <span class="px-2.5 py-1 rounded-full bg-slate-950/80  text-white text-[10px] font-bold uppercase tracking-wider border border-white/20">
                      {category}
                    </span>
                  </div>
                </a>

                <div class="p-6 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-2.5">
                      <time datetime={post.data.publishedDate.toISOString()}>{formattedDate}</time>
                      <span>•</span>
                      <span>{readingTime} min read</span>
                    </div>

                    <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug">
                      <a href={`/blog/${post.id}`}>{post.data.title}</a>
                    </h3>

                    <p class="mt-2.5 text-sm text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
                      {excerpt}
                    </p>
                  </div>

                  <div class="mt-6 pt-4 border-t border-border dark:border-border flex items-center justify-between">
                    <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                      {authorName}
                    </span>

                    <a
                      href={`/blog/${post.id}`}
                      class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
                    >
                      <span>Read</span>
                      <span>&rarr;</span>
                    </a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</MarketingLayout>
