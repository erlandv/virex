---
/**
 * MarkChat Kenya — Features Overview
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import FeatureHighlight from '@sections/marketing/FeatureHighlight.astro';
import BentoGrid from '@sections/marketing/BentoGrid.astro';
import ValuesSection from '@sections/team/ValuesSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';

const highlightedFeatures = [
  {
    title: 'In-Chat M-Pesa Checkout (/stk) & C2B Auto-Receipting',
    description:
      'Turn customer conversations directly into confirmed transactions. Agents type /stk <amount> <phone> to push an instant PIN prompt to the customer’s Safaricom line. Once authorized, Daraja cryptographically verifies the TransID, logs the payment in the chat timeline, and sends an automated digital receipt.',
    icon: 'lucide:smartphone',
    badge: 'Fintech Breakthrough',
    highlights: [
      'Trigger STK push prompts directly within WhatsApp, Live Chat & IG',
      'Stops fake M-Pesa confirmation SMS screenshots permanently',
      'Zero manual verification or app switching for sales staff',
      'Sends automated branded WhatsApp & SMS payment receipts',
    ],
    cta: { label: 'Explore Daraja integration', href: '/integrations/safaricom-mpesa-daraja' },
  },
  {
    title: 'Unified Omnichannel Inbox for Kenyan Retail & Support Teams',
    description:
      'Consolidate WhatsApp Business Cloud API, Bulk SMS, Instagram DMs, Facebook Messenger, Website Live Chat, and Email into one shared workspace. Assign conversations to agents, leave internal team notes, track SLA targets, and avoid missing leads across scattered devices.',
    icon: 'lucide:inbox',
    badge: 'Team Operations',
    highlights: [
      'Official WhatsApp Cloud API without phone number bans',
      'Shared team inbox with real-time agent collision detection',
      'Private internal notes and thread tagging between staff',
      'Centralized 360-degree customer purchase and conversation history',
    ],
    cta: { label: 'See WhatsApp Cloud features', href: '/integrations/whatsapp-cloud-api' },
  },
  {
    title: 'Markcopilot Dual-Mode AI Assistant (English & Swahili)',
    description:
      'A specialized commerce AI trained on Kenyan business vocabulary, Sheng slang, and your actual product catalog. Operates in Customer Mode to answer price, stock, and delivery inquiries 24/7, and in Agent Copilot Mode to provide 1-click reply drafts and urgency tagging.',
    icon: 'lucide:sparkles',
    badge: '24/7 AI Concierge',
    highlights: [
      'Ingests PDF price sheets, menus, and return policies seamlessly',
      'Answers customer inquiries autonomously in Swahili, Sheng, and English',
      'Generates 1-click reply suggestions for inbox agents',
      'Detects customer intent, sentiment, and urgent purchase readiness',
    ],
    cta: { label: 'Learn about Markcopilot', href: '/integrations/markcopilot-ai' },
  },
];

const bentoFeatures = [
  {
    title: 'All 4 Mobile Money Modes',
    description:
      'Support dedicated Paybill/Till (Daraja), Shared Bank Paybills (Equity, KCB, Co-op with account reference routing), Pochi la Biashara Android SMS sync, or SMS-Only mode.',
    icon: 'lucide:credit-card',
    size: 'large' as const,
    accent: 'primary' as const,
    href: '/docs/mpesa-setup',
  },
  {
    title: 'Prepaid & BYOC Bulk SMS',
    description:
      'Send high-delivery broadcasts via Africa’s Talking. 50 free trial credits included.',
    icon: 'lucide:message-square',
    accent: 'blue' as const,
    href: '/docs/sms-gateway',
  },
  {
    title: 'Fake Screenshot Shield',
    description: 'Server-side TransID checking eliminates counterfeit SMS and fake payment apps.',
    icon: 'lucide:shield-check',
    accent: 'green' as const,
  },
  {
    title: 'Multi-Tenant Team Subscriptions',
    description:
      'Role-based access (Owner, Admin, Agent), custom domain whitelabeling, and response SLA tracking.',
    icon: 'lucide:users',
    size: 'medium' as const,
    accent: 'purple' as const,
  },
];

const featureCategories = [
  {
    title: 'In-Chat Commerce & Mobile Money',
    subtitle: 'Streamline payment collection across East Africa’s largest payment network',
    items: [
      {
        icon: 'lucide:smartphone',
        title: 'Instant /stk Prompting',
        description:
          'Prompt customers to enter their M-Pesa PIN directly on their phone while chatting. Reduces average cart completion time from 4 minutes to 10 seconds.',
      },
      {
        icon: 'lucide:shield-alert',
        title: 'TransID Anti-Replay Engine',
        description:
          'Every Safaricom transaction is logged with its unique confirmation code. Attempts to reuse the same M-Pesa message across multiple orders are blocked instantly.',
      },
      {
        icon: 'lucide:refresh-cw',
        title: 'Pochi la Biashara Sync Forwarder',
        description:
          'Small merchants using personal lines can sync SMS receipts in real time using our Android background forwarder without complex API registration.',
      },
    ],
  },
  {
    title: 'Omnichannel Customer Communication',
    subtitle: 'Never lose a sale because a message was left unread on an unattended phone',
    items: [
      {
        icon: 'simple-icons:whatsapp',
        title: 'Official Meta Cloud API',
        description:
          'Operate compliant multi-agent WhatsApp customer support with pre-approved message templates, interactive buttons, and media attachments.',
      },
      {
        icon: 'lucide:messages-square',
        title: 'Carrier-Grade Bulk SMS',
        description:
          'Send transactional dispatch notifications, refill reminders, and promotional campaigns via Africa’s Talking with 99%+ local carrier delivery.',
      },
      {
        icon: 'simple-icons:instagram',
        title: 'Social Commerce Inbox',
        description:
          'Funnel Instagram direct messages and Facebook page inquiries into the same queue so sales reps can respond and collect payments immediately.',
      },
    ],
  },
];

const APP_URL = import.meta.env.PUBLIC_APP_URL || 'http://localhost:3000';
---

<MarketingLayout
  title={`Features - ${siteConfig.name}`}
  description="Explore MarkChat features: in-chat /stk M-Pesa checkout, WhatsApp Cloud API, Bulk SMS, Pochi la Biashara sync, and Markcopilot AI."
>
  <PageHeader
    title="Everything You Need to Power Conversational Commerce in Kenya"
    subtitle="From official WhatsApp Cloud API and Africa’s Talking Bulk SMS to in-chat M-Pesa STK push and Markcopilot AI."
  />

  <!-- Three Major Feature Highlights -->
  <FeatureHighlight features={highlightedFeatures} startImageLeft={false} background="default" />

  <!-- Bento Grid of Key Capabilities -->
  <BentoGrid
    title="Core Architecture Built for African Retailers"
    subtitle="Engineered for reliability, zero fraud, and instantaneous customer response."
    items={bentoFeatures}
    background="muted"
  />

  <!-- Detailed Feature Categories -->
  <div class="py-16 space-y-16">
    {
      featureCategories.map((category) => (
        <ValuesSection title={category.title} subtitle={category.subtitle} items={category.items} />
      ))
    }
  </div>

  <CTA
    title="Ready to automate your customer chats and M-Pesa payments?"
    description="Sign up in 30 seconds. 50 free Bulk SMS credits included on all accounts."
    action={{ label: 'Start Free Forever', href: `${APP_URL}/app/auth/signup` }}
    background="muted"
  />
</MarketingLayout>
