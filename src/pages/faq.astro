---
/**
 * MarkChat Kenya — Frequently Asked Questions
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import FAQSection from '@sections/content/FAQSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';
import { fetchFaqs } from '@/lib/cms-api';

const faqs = await fetchFaqs();

const categoryLabels: Record<string, string> = {
  general: 'General & Onboarding',
  mpesa: 'M-Pesa STK & Mobile Money',
  sms: 'Bulk SMS & Africa’s Talking',
  markcopilot: 'Markcopilot AI Assistant',
  pricing: 'Pricing, Plans & KES Billing',
};

const groupedCategories = ['mpesa', 'sms', 'markcopilot', 'pricing', 'general']
  .map((catKey) => {
    const catFaqs = faqs.filter((f) => f.category === catKey);
    return {
      name: categoryLabels[catKey] || 'General',
      faqs: catFaqs.map((f) => ({
        question: f.question,
        answer: f.answer,
      })),
    };
  })
  .filter((group) => group.faqs.length > 0);
---

<MarketingLayout
  title={`FAQ - ${siteConfig.name}`}
  description="Frequently asked questions about MarkChat. Learn how in-chat M-Pesa STK checkout, Africa’s Talking SMS, and Markcopilot AI work."
>
  <PageHeader
    title="Frequently Asked Questions"
    subtitle="Everything you need to know about setting up MarkChat, connecting Safaricom Daraja, Bulk SMS, and Markcopilot AI in Kenya."
  >
    <a href="/contact" class="text-primary hover:underline">Contact our Nairobi team</a>.
  </PageHeader>

  <FAQSection categories={groupedCategories} variant="accordion" background="default" />

  <CTA
    title="Still have questions about your Till or Paybill?"
    description="Our Nairobi support team can verify your shortcode or help set up Pochi sync in 5 minutes."
    action={{ label: 'Send an Inquiry', href: '/contact' }}
    secondaryAction={{ label: 'Book Live Demo', href: '/demo' }}
    background="muted"
  />
</MarketingLayout>
