---
/**
 * MarkChat Resources Directory
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import CTA from '@sections/marketing/CTA.astro';
import { resourcesPages } from '@/data/marketing-content';
---

<MarketingLayout
  title="Resources & Documentation - MarkChat Kenya"
  description="Technical guides, developer documentation, CLI tools, message templates, and uptime status for the MarkChat platform."
>
  <PageHeader
    title="Developer & Business Resources"
    subtitle="Documentation, deployment guides, message templates, and community tools to scale your conversational stack."
  />

  <section class="py-16 sm:py-24 bg-surface/50 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          resourcesPages.map((item) => (
            <a
              href={`/resources/${item.slug}`}
              class="group flex flex-col justify-between p-8 rounded-2xl border border-border bg-background hover:border-primary/50 hover:shadow-lg transition-all"
            >
              <div>
                <div class="flex items-center justify-between mb-6">
                  <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary border border-primary/20 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <Icon name={item.icon} class="w-6 h-6" />
                  </div>
                  {item.badge && (
                    <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-primary/10 text-primary border border-primary/20">
                      {item.badge}
                    </span>
                  )}
                </div>
                <h3 class="text-xl font-bold text-text group-hover:text-primary transition-colors">
                  {item.title}
                </h3>
                <p class="text-sm text-text-muted mt-3 line-clamp-3 leading-relaxed">
                  {item.subtitle}
                </p>
              </div>

              <div class="mt-8 pt-4 border-t border-border/50 flex items-center justify-between text-xs font-semibold text-primary">
                <span>Access resource</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    title="Have questions or need technical support?"
    description="Check our comprehensive documentation or reach our engineering team directly."
    action={{ label: 'Explore Developer Docs', href: '/docs' }}
    secondaryAction={{ label: 'Contact Support', href: '/contact' }}
    background="muted"
  />
</MarketingLayout>
