---
/**
 * MarkChat Kenya — Book a Live Demo
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import DemoRequestForm from '@forms/DemoRequestForm.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config';

const benefits = [
  {
    icon: 'lucide:presentation',
    title: 'Live STK Prompt Demo',
    description:
      'Explore a simulated M-Pesa STK request and the merchant verification workflow.',
  },
  {
    icon: 'lucide:message-circle',
    title: 'Kenyan Commerce Guidance',
    description:
      'Review merchant onboarding prerequisites for Paybill, Till, or eligible Pochi integrations.',
  },
  {
    icon: 'lucide:calculator',
    title: 'Bulk SMS Carrier Rates',
    description:
      'Compare prepaid SMS quoting with separate workspace subscriptions and carrier onboarding.',
  },
  {
    icon: 'lucide:sparkles',
    title: 'Markcopilot AI Demonstration',
    description:
      'See how Markcopilot understands Sheng, Swahili, and English to answer catalog questions 24/7.',
  },
];

const faqs = [
  {
    question: 'How long does the demonstration take?',
    answer:
      'Demos typically take 20 to 30 minutes, including guided STK checkout simulations and Q&A with our Nairobi engineering team.',
  },
  {
    question: 'Do I need my own Safaricom Paybill before the demo?',
    answer:
      'No! You can test using our sandbox shortcode or learn how to pair your personal/Pochi line with our Android SMS forwarder.',
  },
  {
    question: 'Can you show us multi-agent inbox workflows?',
    answer:
      'Yes! We demonstrate how 5+ agents handle customer inquiries concurrently on a single official WhatsApp number.',
  },
  {
    question: 'Is there any commitment required?',
    answer:
      'A discovery call does not issue SMS credits or activate carrier routes; please confirm availability with our team.',
  },
];
---

<MarketingLayout
  title={`Book a Live Demo - ${siteConfig.name}`}
  description="Schedule a guided demonstration of MarkChat with our Nairobi team. See in-chat M-Pesa STK push and Markcopilot AI in action."
>
  <section class="py-section bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Left: Content -->
        <div>
          <span
            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-primary/10 text-primary mb-4"
          >
            🇰🇪 Live Nairobi Walkthrough
          </span>
          <h1 class="text-4xl sm:text-5xl font-bold text-text mb-6">See MarkChat in Action</h1>
          <p class="text-xl text-text-muted mb-8 leading-relaxed">
            Request a tailored discussion of team messaging, prepaid SMS and Kenyan payment integrations. Provider access and live demonstrations depend on current deployment readiness.
          </p>

          <!-- Benefits -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
            {
              benefits.map((benefit) => (
                <div class="flex gap-4">
                  <div class="shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                    <Icon name={benefit.icon} class="w-5 h-5 text-primary" />
                  </div>
                  <div>
                    <h3 class="font-semibold text-text mb-1">{benefit.title}</h3>
                    <p class="text-sm text-text-muted">{benefit.description}</p>
                  </div>
                </div>
              ))
            }
          </div>

          <!-- Social proof -->
          <div class="flex items-center gap-4 p-4 rounded-xl bg-surface border border-border">
            <div class="flex -space-x-2">
              {
                ['KW', 'JO', 'EM', 'SC'].map((initials) => (
                  <div class="w-10 h-10 rounded-full bg-primary/20 border-2 border-background flex items-center justify-center text-xs font-semibold text-primary">
                    {initials}
                  </div>
                ))
              }
            </div>
            <div>
              <p class="text-sm font-medium text-text">Built for Kenyan Business Workflows</p>
              <p class="text-xs text-text-muted">
                Practical communication patterns for retail, healthcare, commerce and service teams
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Form Card -->
        <div class="p-8 sm:p-10 rounded-2xl bg-surface border border-border shadow-xl">
          <h2 class="text-2xl font-bold text-text mb-2">Request Your Live Walkthrough</h2>
          <p class="text-sm text-text-muted mb-6">
            Fill in your details below and our team will get in touch via WhatsApp or phone.
          </p>
          <DemoRequestForm />
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="mt-20 pt-16 border-t border-border">
        <h2 class="text-2xl font-bold text-text text-center mb-10">
          Frequently Asked Demo Questions
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {
            faqs.map((faq) => (
              <div class="p-6 rounded-xl bg-surface border border-border">
                <h3 class="font-semibold text-text mb-2">{faq.question}</h3>
                <p class="text-sm text-text-muted leading-relaxed">{faq.answer}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
