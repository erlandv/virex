---
/**
 * MarkChat Kenya — Documentation Landing Page & Knowledge Center
 *
 * Fully CMS-driven documentation catalog powered by Astro Content Collections.
 * Features:
 * - Real-time client-side live search over title, description, category, and tags
 * - Category filter pills with active state indicators
 * - Empty state with quick reset triggers
 * - Uniform card heights and balanced visual hierarchy
 * - Dark mode parity (dark:bg-[#0B1120])
 * - Keyboard navigation and accessibility (WCAG 2.2 AA)
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import ServiceBoundaryNotice from '@/components/common/ServiceBoundaryNotice.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config';

type DocsEntry = CollectionEntry<'docs'>;

// Fetch all published docs from collection
const allDocs = await getCollection('docs', ({ data }: { data: DocsEntry['data'] }) => !data.draft);

// Sort docs strictly by order
const sortedDocs = [...allDocs].sort((a: DocsEntry, b: DocsEntry) => a.data.order - b.data.order);

// Helper for estimated reading time based on 200 words per minute
function getReadingTime(body: string = ''): string {
  const words = body.trim().split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.ceil(words / 200));
  return `${minutes} min read`;
}

// Category visual accents
const CATEGORY_ACCENTS: Record<
  string,
  { bg: string; text: string; border: string; pillBg: string; pillText: string }
> = {
  'Getting Started': {
    bg: 'bg-blue-50 dark:bg-blue-950/70',
    text: 'text-blue-600 dark:text-blue-400',
    border: 'border-blue-200/80 dark:border-blue-800/80',
    pillBg: 'bg-blue-100/70 dark:bg-blue-950/80',
    pillText: 'text-blue-700 dark:text-blue-300',
  },
  Channels: {
    bg: 'bg-emerald-50 dark:bg-emerald-950/70',
    text: 'text-emerald-600 dark:text-emerald-400',
    border: 'border-emerald-200/80 dark:border-emerald-800/80',
    pillBg: 'bg-emerald-100/70 dark:bg-emerald-950/80',
    pillText: 'text-emerald-700 dark:text-emerald-300',
  },
  'Fintech & M-Pesa': {
    bg: 'bg-teal-50 dark:bg-teal-950/70',
    text: 'text-teal-600 dark:text-teal-400',
    border: 'border-teal-200/80 dark:border-teal-800/80',
    pillBg: 'bg-teal-100/70 dark:bg-teal-950/80',
    pillText: 'text-teal-700 dark:text-teal-300',
  },
  'Team Operations': {
    bg: 'bg-indigo-50 dark:bg-indigo-950/70',
    text: 'text-indigo-600 dark:text-indigo-400',
    border: 'border-indigo-200/80 dark:border-indigo-800/80',
    pillBg: 'bg-indigo-100/70 dark:bg-indigo-950/80',
    pillText: 'text-indigo-700 dark:text-indigo-300',
  },
  'AI Automation': {
    bg: 'bg-purple-50 dark:bg-purple-950/70',
    text: 'text-purple-600 dark:text-purple-400',
    border: 'border-purple-200/80 dark:border-purple-800/80',
    pillBg: 'bg-purple-100/70 dark:bg-purple-950/80',
    pillText: 'text-purple-700 dark:text-purple-300',
  },
  'Developer APIs': {
    bg: 'bg-cyan-50 dark:bg-cyan-950/70',
    text: 'text-cyan-600 dark:text-cyan-400',
    border: 'border-cyan-200/80 dark:border-cyan-800/80',
    pillBg: 'bg-cyan-100/70 dark:bg-cyan-950/80',
    pillText: 'text-cyan-700 dark:text-cyan-300',
  },
  Troubleshooting: {
    bg: 'bg-amber-50 dark:bg-amber-950/70',
    text: 'text-amber-600 dark:text-amber-400',
    border: 'border-amber-200/80 dark:border-amber-800/80',
    pillBg: 'bg-amber-100/70 dark:bg-amber-950/80',
    pillText: 'text-amber-700 dark:text-amber-300',
  },
};

const defaultAccent = {
  bg: 'bg-slate-50 dark:bg-slate-800/70',
  text: 'text-slate-600 dark:text-slate-400',
  border: 'border-slate-200/80 dark:border-slate-800/80',
  pillBg: 'bg-slate-100 dark:bg-slate-800',
  pillText: 'text-slate-700 dark:text-slate-300',
};

// Filter categories
const categoriesList = [
  'All Guides',
  'Getting Started',
  'Channels',
  'Fintech & M-Pesa',
  'Team Operations',
  'AI Automation',
  'Developer APIs',
  'Troubleshooting',
];
---

<MarketingLayout
  title={`Documentation & Developer Center — ${siteConfig.name}`}
  description={`Comprehensive documentation for MarkChat: Safaricom Daraja M-Pesa STK, WhatsApp Business Cloud, Africa's Talking SMS, REST APIs, and team collaboration.`}
>
  <ServiceBoundaryNotice />
  <div
    class="py-14 sm:py-20 bg-slate-50 dark:bg-[#0B1120] min-h-screen transition-colors duration-200"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* =============================================================== */}
      {/* 1. HERO HEADER WITH LIVE SEARCH & CONTROLS                      */}
      {/* =============================================================== */}
      <div class="max-w-4xl mb-12">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/70 border border-blue-200/80 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-bold tracking-wide uppercase mb-4 shadow-xs"
        >
          <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
          <span>MarkChat Documentation & API Reference</span>
        </div>
        <h1
          class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight"
        >
          Developer Documentation & <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-emerald-600 dark:from-blue-400 dark:via-indigo-400 dark:to-emerald-400"
            >Merchant Guides</span
          >
        </h1>
        <p
          class="mt-4 text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal"
        >
          Everything you need to integrate Safaricom Daraja M-Pesa STK pushes, WhatsApp Cloud API,
          Africa’s Talking Bulk SMS, REST APIs, webhooks, and Markcopilot AI into your workflow.
        </p>

        {/* Live Search Bar */}
        <div class="mt-8 relative max-w-2xl">
          <label for="docs-search-input" class="sr-only">Search documentation</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <Icon name="lucide:search" class="w-5 h-5 text-slate-400 dark:text-slate-500" />
            </div>
            <input
              type="text"
              id="docs-search-input"
              placeholder="Search guides, channels, APIs, webhooks, or M-Pesa (Press '/' to focus)..."
              class="w-full pl-11 pr-24 py-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all"
            />
            <div
              class="absolute inset-y-0 right-0 pr-3 flex items-center gap-1.5 pointer-events-none"
            >
              <kbd
                class="hidden sm:inline-block px-2 py-0.5 text-[11px] font-mono text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700"
              >
                /
              </kbd>
            </div>
          </div>
        </div>
      </div>

      {/* =============================================================== */}
      {/* 2. CATEGORY FILTER PILLS & LIVE COUNTER                         */}
      {/* =============================================================== */}
      <div
        class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6"
      >
        <div
          class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 scrollbar-none"
          role="tablist"
          aria-label="Documentation categories"
        >
          {
            categoriesList.map((cat, idx) => (
              <button
                type="button"
                data-category-filter={cat}
                class:list={[
                  'category-filter-btn shrink-0 px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all duration-150 cursor-pointer',
                  idx === 0
                    ? 'bg-blue-600 text-white shadow-xs'
                    : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700',
                ]}
              >
                {cat}
              </button>
            ))
          }
        </div>

        <div class="text-xs font-medium text-slate-500 dark:text-slate-400 shrink-0">
          <span id="docs-counter">Showing {sortedDocs.length} of {sortedDocs.length} guides</span>
        </div>
      </div>

      {/* =============================================================== */}
      {/* 3. RESPONSIVE GRID (2 to 3 to 4 Scaling with Floating Cards)   */}
      {/* =============================================================== */}
      <section class="mb-20">
        <div
          id="docs-grid"
          class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 lg:gap-8"
        >
          {
            sortedDocs.map((doc) => {
              const category = doc.data.category || doc.data.section || 'General';
              const iconName = doc.data.icon || 'lucide:book-open';
              const accent = CATEGORY_ACCENTS[category] || defaultAccent;
              const readTime = getReadingTime(doc.body);
              const difficulty = doc.data.difficulty || 'Beginner';
              const tagsStr = (doc.data.tags || []).join(' ');

              return (
                <a
                  href={`/docs/${doc.id}`}
                  data-doc-card
                  data-title={doc.data.title.toLowerCase()}
                  data-description={doc.data.description.toLowerCase()}
                  data-category={category}
                  data-tags={tagsStr.toLowerCase()}
                  class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 relative overflow-hidden group cursor-pointer flex flex-col justify-between transition-all duration-300 ease-out hover:-translate-y-2 hover:shadow-xl dark:hover:shadow-blue-900/20 hover:border-blue-500/50 dark:hover:border-blue-500/50 h-full"
                >
                  {/* Subtle Ambient Glow Behind Card */}
                  <div class="absolute -right-8 -bottom-8 w-24 h-24 bg-blue-500/5 dark:bg-blue-500/10 rounded-full blur-xl group-hover:scale-150 transition-transform duration-500 pointer-events-none" />

                  <div class="flex-1 flex flex-col">
                    {/* Top Row: Icon Container & Doc Number */}
                    <div class="flex items-center justify-between mb-4">
                      <div
                        class:list={[
                          'w-12 h-12 rounded-xl flex items-center justify-center transition-transform duration-300 group-hover:scale-110 shadow-xs border shrink-0',
                          accent.bg,
                          accent.text,
                          accent.border,
                        ]}
                      >
                        <Icon name={iconName} class="w-6 h-6" aria-hidden="true" />
                      </div>
                      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                        Doc {doc.data.order < 10 ? `0${doc.data.order}` : doc.data.order}
                      </span>
                    </div>

                    {/* Category & Difficulty Badges */}
                    <div class="flex items-center gap-2 mb-3">
                      <span
                        class:list={[
                          'inline-block px-2.5 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider',
                          accent.pillBg,
                          accent.pillText,
                        ]}
                      >
                        {category}
                      </span>
                      <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                        {difficulty}
                      </span>
                    </div>

                    {/* Title */}
                    <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2 leading-snug line-clamp-2">
                      {doc.data.title}
                    </h2>

                    {/* Description (Height Budget Clamped for Uniform Layout) */}
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 line-clamp-3 leading-relaxed mb-6">
                      {doc.data.description}
                    </p>
                  </div>

                  {/* Bottom Action & Read Time (Always Aligned at Bottom) */}
                  <div class="flex items-center justify-between text-xs font-semibold text-blue-600 dark:text-blue-400 pt-4 border-t border-slate-100 dark:border-slate-800/80 mt-auto">
                    <span class="text-[11px] font-normal text-slate-400 dark:text-slate-500">
                      {readTime}
                    </span>
                    <span class="flex items-center gap-1 group-hover:translate-x-1.5 transition-transform duration-200 font-bold">
                      <span>Read guide</span>
                      <span>&rarr;</span>
                    </span>
                  </div>
                </a>
              );
            })
          }
        </div>

        {/* Empty State when Search/Filter yields zero matches */}
        <div
          id="docs-empty-state"
          class="hidden text-center py-16 px-4 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm"
        >
          <div
            class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-blue-50 dark:bg-blue-950/70 border border-blue-200 dark:border-blue-800 flex items-center justify-center text-blue-600 dark:text-blue-400"
          >
            <Icon name="lucide:search-x" class="w-8 h-8" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">
            No Documentation Guides Found
          </h3>
          <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto mb-6">
            We couldn't find any guides matching your query. Try searching for terms like <span
              class="font-semibold text-slate-700 dark:text-slate-300">"mpesa"</span
            >, <span class="font-semibold text-slate-700 dark:text-slate-300">"whatsapp"</span>, <span
              class="font-semibold text-slate-700 dark:text-slate-300">"api"</span
            >, or <span class="font-semibold text-slate-700 dark:text-slate-300">"webhook"</span>.
          </p>
          <button
            type="button"
            id="docs-reset-btn"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 text-white font-semibold text-xs shadow-sm hover:bg-blue-700 transition-colors cursor-pointer"
          >
            <Icon name="lucide:rotate-ccw" class="w-4 h-4" />
            <span>Reset Search & Filters</span>
          </button>
        </div>
      </section>

      {/* =============================================================== */}
      {/* 4. DEVELOPER IN-CHAT SHORTCUTS & CORE WEBHOOK SUMMARY           */}
      {/* =============================================================== */}
      <section
        class="mb-20 p-8 sm:p-10 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-lg"
      >
        <div class="max-w-2xl mb-8">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
            Developer In-Chat Syntax & Webhook Protocols
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Frontline agents and external microservices trigger these standardized commands to
            collect payments and synchronize ticket lifecycles.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div
            class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 font-mono text-xs"
          >
            <span class="text-blue-600 dark:text-blue-400 font-bold"
              >/stk &lt;amount&gt; &lt;phone&gt;</span
            >
            <p class="mt-1.5 text-slate-600 dark:text-slate-400 font-sans text-xs">
              Triggers instant Safaricom SIM Toolkit PIN prompt to the customer’s phone handset.
            </p>
          </div>

          <div
            class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 font-mono text-xs"
          >
            <span class="text-emerald-600 dark:text-emerald-400 font-bold"
              >POST /api/v1/daraja/c2b</span
            >
            <p class="mt-1.5 text-slate-600 dark:text-slate-400 font-sans text-xs">
              Encrypted callback validation and confirmation hooks registered on Safaricom Daraja.
            </p>
          </div>

          <div
            class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 font-mono text-xs"
          >
            <span class="text-purple-600 dark:text-purple-400 font-bold"
              >@markcopilot &lt;prompt&gt;</span
            >
            <p class="mt-1.5 text-slate-600 dark:text-slate-400 font-sans text-xs">
              Invokes bilingual AI assist to summarize chat histories or translate customer Sheng.
            </p>
          </div>
        </div>
      </section>

      {/* =============================================================== */}
      {/* 5. ONBOARDING & ENTERPRISE ARCHITECTURE CALLOUT                 */}
      {/* =============================================================== */}
      <section
        class="rounded-3xl p-8 sm:p-12 bg-gradient-to-br from-blue-600 via-indigo-600 to-blue-800 text-white shadow-xl relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8"
      >
        <div class="max-w-xl">
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-2">
            Need Custom Integration Architecture in Nairobi?
          </h2>
          <p class="text-blue-100 text-sm sm:text-base leading-relaxed">
            Our local technical solutions team assists with Safaricom Daraja production go-live
            audits, Africa’s Talking Alphanumeric registration, and Meta Business verification.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full md:w-auto">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-white text-blue-700 font-bold text-sm shadow-md hover:bg-blue-50 transition-colors"
          >
            Contact Solutions Team
          </a>
          <a
            href="/demo"
            class="inline-flex items-center justify-center px-6 py-3 rounded-xl border border-white/40 text-white font-semibold text-sm hover:bg-white/10 transition-colors"
          >
            Book Architecture Review
          </a>
        </div>
      </section>
    </div>
  </div>
</MarketingLayout>

<script>
  function setupDocsDirectory() {
    const searchInput = document.getElementById('docs-search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.category-filter-btn');
    const docCards = document.querySelectorAll<HTMLElement>('[data-doc-card]');
    const counterEl = document.getElementById('docs-counter');
    const emptyStateEl = document.getElementById('docs-empty-state');
    const resetBtn = document.getElementById('docs-reset-btn');
    const gridEl = document.getElementById('docs-grid');

    if (!docCards.length) return;

    let activeCategory = 'All Guides';
    let searchQuery = '';
    const totalDocs = docCards.length;

    function applyFilters() {
      let visibleCount = 0;
      const q = searchQuery.toLowerCase().trim();

      docCards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const description = card.getAttribute('data-description') || '';
        const category = card.getAttribute('data-category') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesCategory = activeCategory === 'All Guides' || category === activeCategory;
        const matchesSearch =
          !q ||
          title.includes(q) ||
          description.includes(q) ||
          category.toLowerCase().includes(q) ||
          tags.includes(q);

        if (matchesCategory && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update counter
      if (counterEl) {
        counterEl.textContent = `Showing ${visibleCount} of ${totalDocs} guides`;
      }

      // Empty state toggle
      if (visibleCount === 0) {
        emptyStateEl?.classList.remove('hidden');
        gridEl?.classList.add('hidden');
      } else {
        emptyStateEl?.classList.add('hidden');
        gridEl?.classList.remove('hidden');
      }
    }

    // Category button clicks
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category-filter') || 'All Guides';
        activeCategory = cat;

        filterButtons.forEach((b) => {
          b.classList.remove('bg-blue-600', 'text-white', 'shadow-xs');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400');
        });

        btn.classList.add('bg-blue-600', 'text-white', 'shadow-xs');
        btn.classList.remove(
          'bg-white',
          'dark:bg-slate-900',
          'text-slate-600',
          'dark:text-slate-400'
        );

        applyFilters();
      });
    });

    // Real-time search input
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Keyboard shortcut '/' to focus search
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    // Reset button
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      activeCategory = 'All Guides';

      filterButtons.forEach((b) => {
        const cat = b.getAttribute('data-category-filter');
        if (cat === 'All Guides') {
          b.classList.add('bg-blue-600', 'text-white', 'shadow-xs');
          b.classList.remove(
            'bg-white',
            'dark:bg-slate-900',
            'text-slate-600',
            'dark:text-slate-400'
          );
        } else {
          b.classList.remove('bg-blue-600', 'text-white', 'shadow-xs');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400');
        }
      });

      applyFilters();
    });
  }

  // Setup on page load and Astro view transitions
  setupDocsDirectory();
  document.addEventListener('astro:page-load', setupDocsDirectory);
</script>
