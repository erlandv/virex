---
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

type DocsEntry = CollectionEntry<'docs'>;

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }: { data: DocsEntry['data'] }) => !data.draft);
  return docs.map((doc: DocsEntry) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

interface Props {
  doc: DocsEntry;
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  category={doc.data.category || doc.data.section}
  section={doc.data.section || doc.data.category}
  icon={doc.data.icon || 'lucide:book-open'}
  difficulty={doc.data.difficulty}
  lastUpdated={doc.data.lastUpdated}
  body={doc.body}
>
  <Content />
</DocsLayout>
