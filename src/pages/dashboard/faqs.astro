---
/**
 * MarkChat CMS — FAQs Manager
 */
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import Card from '@dashboard-ui/Card.astro';
import Modal from '@dashboard-ui/Modal.astro';
import { Icon } from 'astro-icon/components';
import { fetchFaqs } from '@/lib/cms-api';

const faqs = await fetchFaqs();
---

<DashboardLayout
  title="FAQs Manager"
  description="Manage interactive accordion Q&As displayed on MarkChat's public /faq page"
  breadcrumbs={[{ label: 'Dashboard', href: '/dashboard' }, { label: 'FAQs Manager' }]}
>
  <div class="cms-faqs-page">
    <div class="page-header flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-text">
          Frequently Asked Questions Manager
        </h1>
        <p class="text-sm text-text-muted mt-1">
          Update answers on M-Pesa STK push, Pochi la Biashara sync, Africa’s Talking SMS, and
          Markcopilot AI.
        </p>
      </div>
      <div class="header-actions flex gap-3">
        <a href="/faq" target="_blank" class="btn btn-secondary text-sm">
          <Icon name="lucide:external-link" class="w-4 h-4 mr-1.5 inline" />
          View Live /faq
        </a>
        <button type="button" id="open-faq-modal" class="btn btn-primary text-sm">
          <Icon name="lucide:plus" class="w-4 h-4 mr-1.5 inline" />
          Add FAQ Item
        </button>
      </div>
    </div>

    <Card
      title="Live & Draft Questions"
      description="Sorted by display order on the public website"
      padding="none"
    >
      <div class="table-responsive">
        <table class="cms-table w-full">
          <thead>
            <tr>
              <th class="text-left py-3 px-4 w-16">Order</th>
              <th class="text-left py-3 px-4">Question &amp; Answer Preview</th>
              <th class="text-left py-3 px-4 w-36">Category</th>
              <th class="text-left py-3 px-4 w-32">Status</th>
              <th class="text-right py-3 px-4 w-40">Actions</th>
            </tr>
          </thead>
          <tbody id="faq-table-body">
            {
              faqs.map((faq) => (
                <tr data-id={faq.id} data-faq={JSON.stringify(faq)}>
                  <td class="py-3 px-4 font-mono text-xs text-text-muted">#{faq.order}</td>
                  <td class="py-3 px-4">
                    <div class="font-medium text-text">{faq.question}</div>
                    <div class="text-xs text-text-muted line-clamp-1 mt-0.5">{faq.answer}</div>
                  </td>
                  <td class="py-3 px-4 text-xs">
                    <span class="inline-block bg-surface-hover px-2 py-0.5 rounded border border-border capitalize">
                      {faq.category}
                    </span>
                  </td>
                  <td class="py-3 px-4 text-xs">
                    <span class={`status-pill status-${faq.status}`}>
                      {faq.status.toUpperCase()}
                    </span>
                  </td>
                  <td class="py-3 px-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <button
                        type="button"
                        class="action-btn edit-faq-btn"
                        data-id={faq.id}
                        title="Edit FAQ"
                      >
                        <Icon name="lucide:edit-3" class="w-4 h-4" />
                      </button>
                      <select class="status-select text-xs" data-id={faq.id}>
                        <option value="published" selected={faq.status === 'published'}>
                          Published
                        </option>
                        <option value="draft" selected={faq.status === 'draft'}>
                          Draft
                        </option>
                        <option value="paused" selected={faq.status === 'paused'}>
                          Paused
                        </option>
                        <option value="archived" selected={faq.status === 'archived'}>
                          Archived
                        </option>
                      </select>
                      <button
                        type="button"
                        class="action-btn text-error delete-faq-btn"
                        data-id={faq.id}
                        title="Delete"
                      >
                        <Icon name="lucide:trash-2" class="w-4 h-4" />
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </Card>

    <!-- Modal for Create / Edit FAQ -->
    <Modal id="faq-modal" title="FAQ Item Editor" size="md">
      <form id="faq-form" class="space-y-4">
        <input type="hidden" id="faq-id" name="id" />

        <div class="form-group">
          <label class="form-label" for="faq-question">Question *</label>
          <input
            type="text"
            id="faq-question"
            name="question"
            class="form-input"
            required
            placeholder="e.g. Can I use Pochi la Biashara instead of a Paybill?"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="form-group">
            <label class="form-label" for="faq-category">Category</label>
            <select id="faq-category" name="category" class="form-input">
              <option value="general">General</option>
              <option value="mpesa">M-Pesa &amp; Daraja</option>
              <option value="sms">Bulk SMS &amp; BYOC</option>
              <option value="markcopilot">Markcopilot AI</option>
              <option value="pricing">Pricing &amp; Plans</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="faq-order">Display Order Number</label>
            <input type="number" id="faq-order" name="order" class="form-input" value="1" min="1" />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="faq-status">Lifecycle Status</label>
          <select id="faq-status" name="status" class="form-input">
            <option value="published">Published</option>
            <option value="draft">Draft</option>
            <option value="paused">Paused</option>
            <option value="archived">Archived</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="faq-answer">Detailed Answer *</label>
          <textarea
            id="faq-answer"
            name="answer"
            rows="4"
            class="form-textarea"
            required
            placeholder="Provide a helpful, precise explanation..."></textarea>
        </div>
      </form>

      <div slot="footer" class="flex justify-end gap-3">
        <button type="button" class="btn btn-secondary" onclick="window.closeModal('faq-modal')">
          Cancel
        </button>
        <button type="submit" form="faq-form" class="btn btn-primary"> Save FAQ </button>
      </div>
    </Modal>
  </div>
</DashboardLayout>

<style>
  .cms-faqs-page {
    max-width: 80rem;
    margin: 0 auto;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .cms-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.875rem;
  }

  .cms-table th {
    background: var(--color-surface-hover, #1f1f23);
    color: var(--color-text-muted, #a1a1aa);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--color-border, #27272a);
  }

  .cms-table td {
    border-bottom: 1px solid var(--color-border, #27272a);
  }

  .status-pill {
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .status-published {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
  }

  .status-draft {
    background: rgba(234, 179, 8, 0.15);
    color: #facc15;
  }

  .status-paused {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
  }

  .status-archived {
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
  }

  .action-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted, #a1a1aa);
    cursor: pointer;
    padding: 0.35rem;
    border-radius: var(--radius-sm, 0.25rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .action-btn:hover {
    color: var(--color-text, #fafafa);
    background: var(--color-surface-hover, #1f1f23);
  }

  .status-select {
    padding: 0.25rem 0.5rem;
    background: var(--color-surface, #141418);
    border: 1px solid var(--color-border, #27272a);
    border-radius: var(--radius-sm, 0.25rem);
    color: var(--color-text, #fafafa);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text, #fafafa);
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    background: var(--color-surface, #141418);
    border: 1px solid var(--color-border, #27272a);
    border-radius: var(--radius-md, 0.5rem);
    color: var(--color-text, #fafafa);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--radius-md, 0.5rem);
    cursor: pointer;
    transition: all 150ms ease;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--color-primary, #6366f1);
    color: #ffffff;
  }

  .btn-secondary {
    background: var(--color-surface, #141418);
    border-color: var(--color-border, #27272a);
    color: var(--color-text, #fafafa);
  }
</style>

<script>
  import {
    upsertFaq,
    updateItemStatus,
    deleteCmsItem,
    type CmsLifecycleStatus,
    type FaqItem,
  } from '@/lib/cms-api';

  function initFaqsAdmin() {
    const createBtn = document.getElementById('open-faq-modal');
    const form = document.getElementById('faq-form') as HTMLFormElement;

    if (createBtn) {
      createBtn.addEventListener('click', () => {
        form?.reset();
        (document.getElementById('faq-id') as HTMLInputElement).value = '';
        window.openModal?.('faq-modal');
      });
    }

    // Edit button listeners
    document.querySelectorAll('.edit-faq-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('tr');
        if (!row) return;
        const faq = JSON.parse(row.getAttribute('data-faq') || '{}');
        (document.getElementById('faq-id') as HTMLInputElement).value = faq.id || '';
        (document.getElementById('faq-question') as HTMLInputElement).value = faq.question || '';
        (document.getElementById('faq-category') as HTMLSelectElement).value =
          faq.category || 'general';
        (document.getElementById('faq-order') as HTMLInputElement).value = faq.order || 1;
        (document.getElementById('faq-status') as HTMLSelectElement).value =
          faq.status || 'published';
        (document.getElementById('faq-answer') as HTMLTextAreaElement).value = faq.answer || '';
        window.openModal?.('faq-modal');
      });
    });

    // Form submission
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = (document.getElementById('faq-id') as HTMLInputElement).value;
        const question = (document.getElementById('faq-question') as HTMLInputElement).value;
        const category = (document.getElementById('faq-category') as HTMLSelectElement)
          .value as FaqItem['category'];
        const order = parseInt(
          (document.getElementById('faq-order') as HTMLInputElement).value || '1',
          10
        );
        const status = (document.getElementById('faq-status') as HTMLSelectElement)
          .value as CmsLifecycleStatus;
        const answer = (document.getElementById('faq-answer') as HTMLTextAreaElement).value;

        await upsertFaq({
          id: id || undefined,
          question,
          category,
          order,
          status,
          answer,
        });

        window.closeModal?.('faq-modal');
        if (window.showToast) {
          window.showToast({
            message: 'FAQ item saved successfully!',
            variant: 'success',
            duration: 3000,
          });
        }
        setTimeout(() => window.location.reload(), 600);
      });
    }

    // Status quick change
    document.querySelectorAll('.status-select').forEach((sel) => {
      sel.addEventListener('change', async (e) => {
        const id = sel.getAttribute('data-id');
        const status = (e.target as HTMLSelectElement).value as CmsLifecycleStatus;
        if (id) {
          await updateItemStatus('faqs', id, status);
          if (window.showToast) {
            window.showToast({
              message: `Status updated to ${status}`,
              variant: 'success',
              duration: 2500,
            });
          }
        }
      });
    });

    // Delete FAQ
    document.querySelectorAll('.delete-faq-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (id && confirm('Are you sure you want to delete this FAQ?')) {
          await deleteCmsItem('faqs', id);
          btn.closest('tr')?.remove();
          if (window.showToast) {
            window.showToast({ message: 'FAQ deleted', variant: 'success', duration: 2500 });
          }
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initFaqsAdmin);
  document.addEventListener('astro:page-load', initFaqsAdmin);
</script>
