---
/**
 * MarkChat Website CMS — Command Center
 */
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import StatCard from '@dashboard-ui/StatCard.astro';
import Card from '@dashboard-ui/Card.astro';
import DataTable from '@dashboard-ui/DataTable.astro';
import { Icon } from 'astro-icon/components';
import {
  fetchBlogPosts,
  fetchCareers,
  fetchFaqs,
  fetchPricingMatrix,
  fetchIntegrations,
} from '@/lib/cms-api';

const [blogs, careers, faqs, pricingMatrix, integrations] = await Promise.all([
  fetchBlogPosts(),
  fetchCareers(),
  fetchFaqs(),
  fetchPricingMatrix(),
  fetchIntegrations(),
]);

const publishedPostsCount = blogs.length;
const activeJobsCount = careers.length;
const faqsCount = faqs.length;
const activePlansCount = pricingMatrix.tiers.length;
const integrationsCount = integrations.length;

// Static starter leads for display on SSR
const initialLeads = [
  {
    id: 'lead-1',
    name: 'Grace Wambui',
    company: 'Mama Mboga Mart',
    phone: '+254 722 112 233',
    volume: '5,000 - 15,000 msgs',
    channel: 'WhatsApp STK',
    status: 'New',
  },
  {
    id: 'lead-2',
    name: 'Dr. John Omondi',
    company: 'Coastal Pharma & Clinic',
    phone: '+254 733 445 566',
    volume: '15,000 - 50,000 msgs',
    channel: 'SMS + Daraja',
    status: 'Qualified',
  },
  {
    id: 'lead-3',
    name: 'Erick Mutua',
    company: 'Rift Valley Spares',
    phone: '+254 710 998 877',
    volume: '1,000 - 5,000 msgs',
    channel: 'Till C2B Verification',
    status: 'Contacted',
  },
  {
    id: 'lead-4',
    name: 'Stella Chebet',
    company: 'Afro Beauty Lounge',
    phone: '+254 720 554 433',
    volume: '500 - 1,000 msgs',
    channel: 'Pochi la Biashara',
    status: 'New',
  },
];

const leadColumns = [
  { key: 'name', label: 'Contact Name', sortable: true },
  { key: 'company', label: 'Business / Organization', sortable: true },
  { key: 'phone', label: 'Kenyan Phone', sortable: false },
  { key: 'channel', label: 'Integration Interest', sortable: false },
  { key: 'volume', label: 'Monthly Volume', sortable: true },
  { key: 'status', label: 'Status', sortable: true },
];
---

<DashboardLayout
  title="CMS Command Center"
  description="Manage MarkChat public website content, pricing matrix, and inbound leads"
  breadcrumbs={[{ label: 'Dashboard', href: '/dashboard' }, { label: 'Command Center' }]}
>
  <div class="cms-command-center">
    <!-- Header -->
    <div class="page-header flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-text">CMS Command Center</h1>
        <p class="text-sm text-text-muted mt-1">
          Single-Admin oversight of MarkChat Kenya public marketing data and incoming merchant
          leads.
        </p>
      </div>
      <div class="header-actions flex gap-3">
        <a href="/" target="_blank" class="btn btn-secondary text-sm">
          <Icon name="lucide:external-link" class="w-4 h-4 mr-1.5 inline" />
          View Public Site
        </a>
        <a href="/dashboard/pricing" class="btn btn-primary text-sm">
          <Icon name="lucide:credit-card" class="w-4 h-4 mr-1.5 inline" />
          Edit Plan Matrix
        </a>
      </div>
    </div>

    <!-- StatCards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <StatCard
        title="Published Articles"
        value={publishedPostsCount}
        icon="file-text"
        description="Live on /blog"
        trend={{ value: 25, direction: 'up' }}
      />
      <StatCard
        title="Open Nairobi Roles"
        value={activeJobsCount}
        icon="briefcase"
        description="Live on /careers"
        trend={{ value: 10, direction: 'up' }}
      />
      <StatCard title="Live FAQs" value={faqsCount} icon="help-circle" description="Live on /faq" />
      <StatCard
        title="Active KES Plans"
        value={activePlansCount}
        icon="credit-card"
        description="Starter, Pro & Enterprise"
      />
    </div>

    <!-- Quick Navigation Shortcuts -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <a href="/dashboard/pricing" class="quick-link-card">
        <div class="quick-link-icon bg-blue-500/10 text-blue-500">
          <Icon name="lucide:credit-card" class="w-5 h-5" />
        </div>
        <div class="quick-link-text">
          <h3 class="font-semibold text-text">Pricing &amp; Plan Matrix</h3>
          <p class="text-xs text-text-muted mt-0.5">Toggle KES pricing and binary feature gates</p>
        </div>
        <Icon name="lucide:chevron-right" class="w-4 h-4 text-text-muted ml-auto" />
      </a>

      <a href="/dashboard/integrations" class="quick-link-card">
        <div class="quick-link-icon bg-purple-500/10 text-purple-500">
          <Icon name="lucide:blocks" class="w-5 h-5" />
        </div>
        <div class="quick-link-text">
          <h3 class="font-semibold text-text">Integrations ({integrationsCount})</h3>
          <p class="text-xs text-text-muted mt-0.5">Manage Daraja, SMS &amp; WhatsApp</p>
        </div>
        <Icon name="lucide:chevron-right" class="w-4 h-4 text-text-muted ml-auto" />
      </a>

      <a href="/dashboard/blog" class="quick-link-card">
        <div class="quick-link-icon bg-emerald-500/10 text-emerald-500">
          <Icon name="lucide:newspaper" class="w-5 h-5" />
        </div>
        <div class="quick-link-text">
          <h3 class="font-semibold text-text">Blog &amp; Knowledge Base</h3>
          <p class="text-xs text-text-muted mt-0.5">
            Publish articles on Daraja API &amp; Bulk SMS
          </p>
        </div>
        <Icon name="lucide:chevron-right" class="w-4 h-4 text-text-muted ml-auto" />
      </a>

      <a href="/dashboard/leads" class="quick-link-card">
        <div class="quick-link-icon bg-amber-500/10 text-amber-500">
          <Icon name="lucide:inbox" class="w-5 h-5" />
        </div>
        <div class="quick-link-text">
          <h3 class="font-semibold text-text">Inbound Merchant Leads</h3>
          <p class="text-xs text-text-muted mt-0.5">Review demo bookings &amp; Markcopilot chats</p>
        </div>
        <Icon name="lucide:chevron-right" class="w-4 h-4 text-text-muted ml-auto" />
      </a>
    </div>

    <!-- Recent Inbound Merchant Leads -->
    <Card
      title="Recent Inbound Merchant Leads"
      description="Live demo bookings and inquiries captured from the Markcopilot widget"
      padding="md"
    >
      <DataTable
        columns={leadColumns}
        data={initialLeads}
        emptyMessage="No leads received yet."
        searchable={true}
        itemsPerPage={5}
      />
      <div slot="footer" class="flex justify-between items-center text-xs text-text-muted">
        <span>Showing 4 most recent merchant inquiries from Nairobi, Mombasa &amp; Nakuru</span>
        <a href="/dashboard/leads" class="text-primary hover:underline font-medium">
          View all leads &rarr;
        </a>
      </div>
    </Card>
  </div>
</DashboardLayout>

<style>
  .cms-command-center {
    max-width: 80rem;
    margin: 0 auto;
  }

  .quick-link-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    background: var(--color-surface, #141418);
    border: 1px solid var(--color-border, #27272a);
    border-radius: var(--radius-lg, 0.75rem);
    text-decoration: none;
    transition: all 150ms ease;
  }

  .quick-link-card:hover {
    border-color: var(--color-primary, #6366f1);
    transform: translateY(-1px);
    background: var(--color-surface-hover, #1f1f23);
  }

  .quick-link-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md, 0.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--radius-md, 0.5rem);
    cursor: pointer;
    transition: all 150ms ease;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--color-primary, #6366f1);
    color: #ffffff;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    background: var(--color-surface, #141418);
    border-color: var(--color-border, #27272a);
    color: var(--color-text, #fafafa);
  }

  .btn-secondary:hover {
    background: var(--color-surface-hover, #1f1f23);
  }
</style>
