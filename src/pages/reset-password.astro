---
/**
 * MarkChat Password Reset Completion Page
 *
 * Implements the approved Direction A + D Split-Screen SaaS Layout.
 * Consumes server-issued reset token to securely set a new password.
 */
import AuthSplitLayout from '@/layouts/AuthSplitLayout.astro';
import ResetPasswordForm from '@/components/forms/ResetPasswordForm.astro';
import { siteConfig } from '@/config';

const url = new URL(Astro.request.url);
const token = url.searchParams.get('token') || '';
---

<AuthSplitLayout
  title={`Set New Password — ${siteConfig.name} Kenya`}
  description="Set a new secure password for your MarkChat workspace."
  headline="Set new password"
  subheadline="Choose a secure password of at least 8 characters to access your workspace."
  pageType="reset-password"
  noindex={true}
>
  <ResetPasswordForm token={token} />
</AuthSplitLayout>
