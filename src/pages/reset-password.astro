---
/**
 * MarkChat Password Reset Completion Page
 *
 * Implements the minimal, distraction-free AuthLayout built directly on BaseLayout.
 * Centered Virex card UI with NIST SP 800-63B token hygiene.
 */
import AuthLayout from '@/layouts/AuthLayout.astro';
import ResetPasswordForm from '@/components/forms/ResetPasswordForm.astro';
import { siteConfig } from '@/config';

const url = new URL(Astro.request.url);
const token = url.searchParams.get('token') || '';
---

<AuthLayout
  title={`Set New Password — ${siteConfig.name} Kenya`}
  description="Set a new secure password for your MarkChat workspace."
  pageType="reset-password"
  noindex={true}
>
  <div class="max-w-md mx-auto w-full">
    <!-- Centered Header with Title & Subheadline -->
    <div class="text-center mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-text tracking-tight">Set new password</h1>
      <p class="mt-2 text-sm text-text-muted">Choose a secure password of at least 8 characters to access your workspace.</p>
    </div>

    <!-- Virex Card Container -->
    <div class="bg-surface border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <ResetPasswordForm token={token} />
    </div>
  </div>
</AuthLayout>