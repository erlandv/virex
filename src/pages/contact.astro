---
/**
 * MarkChat Contact Page — Modernized, Professional & KDPA-Compliant
 *
 * Implements the Virex design language with authentic product truth,
 * direct communication channels, anti-bot security, KDPA 2019 consent,
 * and seamless integration into the Single-Admin CMS lead pipeline.
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import ContactForm from '@forms/ContactForm.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig, contact, contactFAQs } from '@/config';

const office = contact.address;

// Structured channel metadata with tailored accents
const channelCards = [
  {
    id: 'sales',
    title: 'Sales & Commercial Inquiries',
    description:
      'Volume pricing, custom integrations, and commercial demonstrations for retail & enterprise teams.',
    email: contact.salesEmail || 'sales@markchat.co.ke',
    icon: 'lucide:trending-up',
    badge: 'New Customers',
    accent: 'blue',
  },
  {
    id: 'support',
    title: 'Technical Support',
    description:
      'Assistance for active workspaces, webhook configurations, and channel connectivity.',
    email: contact.supportEmail || 'support@markchat.co.ke',
    icon: 'lucide:life-buoy',
    badge: 'Active Accounts',
    accent: 'emerald',
  },
  {
    id: 'partners',
    title: 'Partnerships & Integrations',
    description:
      'Tech partnerships, ISV connectors, ERP integrators, and telco gateway aggregators.',
    email: contact.partnersEmail || 'partners@markchat.co.ke',
    icon: 'lucide:layers',
    badge: 'Technology Partners',
    accent: 'purple',
  },
  {
    id: 'general',
    title: 'General Inquiries',
    description:
      'General correspondence, media requests, or feedback for our Nairobi product team.',
    email: contact.email,
    icon: 'lucide:mail',
    badge: 'General',
    accent: 'amber',
  },
];

const channelStyles: Record<string, { borderTop: string; iconBox: string; badge: string }> = {
  blue: {
    borderTop: 'border-t-blue-500',
    iconBox:
      'bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border-blue-200/80 dark:border-blue-800/70',
    badge:
      'bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border-blue-200/80 dark:border-blue-800/70',
  },
  emerald: {
    borderTop: 'border-t-emerald-500',
    iconBox:
      'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border-emerald-200/80 dark:border-emerald-800/70',
    badge:
      'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border-emerald-200/80 dark:border-emerald-800/70',
  },
  purple: {
    borderTop: 'border-t-purple-500',
    iconBox:
      'bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 border-purple-200/80 dark:border-purple-800/70',
    badge:
      'bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border-purple-200/80 dark:border-purple-800/70',
  },
  amber: {
    borderTop: 'border-t-amber-500',
    iconBox:
      'bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 border-amber-200/80 dark:border-amber-800/70',
    badge:
      'bg-amber-50 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border-amber-200/80 dark:border-amber-800/70',
  },
};

// Schema.org ContactPage structured data
const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact MarkChat Kenya',
  description:
    'Get in touch with MarkChat operations in Nairobi, Kenya for Safaricom Daraja M-Pesa setup, Bulk SMS, and customer communication solutions.',
  url: 'https://markchat.co.ke/contact',
  mainEntity: {
    '@type': 'Organization',
    name: 'MarkChat Technologies Ltd',
    url: 'https://markchat.co.ke',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: contact.salesEmail || 'sales@markchat.co.ke',
        areaServed: 'KE',
        availableLanguage: ['English', 'Swahili'],
      },
      {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: contact.supportEmail || 'support@markchat.co.ke',
        areaServed: 'KE',
        availableLanguage: ['English', 'Swahili'],
      },
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Nairobi',
      addressRegion: 'Nairobi County',
      postalCode: '00100',
      addressCountry: 'KE',
    },
  },
};
---

<MarketingLayout
  title={`Contact Our Nairobi Team — ${siteConfig.name}`}
  description="Connect directly with MarkChat in Nairobi, Kenya. Inquire about Safaricom Daraja M-Pesa STK push, Africa’s Talking Bulk SMS, Meta WhatsApp Cloud API, and platform onboarding."
>
  <!-- Schema.org Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(contactPageSchema)} />

  <!-- ===================================================================== -->
  <!-- 1. HERO SECTION (VISION & INVITATION)                                 -->
  <!-- ===================================================================== -->
  <section
    class="relative pt-20 pb-16 sm:pt-28 sm:pb-20 overflow-hidden bg-gradient-to-b from-blue-50/40 via-background to-background dark:from-slate-900/50 dark:via-[#0B1120] dark:to-[#0B1120] border-b border-slate-200 dark:border-slate-800/80 transition-colors duration-200"
  >
    <!-- Ambient Glow Orbs -->
    <div
      class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[760px] h-[380px] bg-gradient-to-b from-blue-600/10 via-primary/5 to-transparent dark:from-blue-600/15 dark:via-primary/10 dark:to-transparent rounded-full blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Direct Channel Badge -->
        <div
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200/80 dark:border-blue-800/80 mb-6 shadow-2xs"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Direct Merchant &amp; Partner Channels</span>
        </div>

        <!-- Headline -->
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.15]"
        >
          Let’s start a <span
            class="bg-gradient-to-r from-blue-600 via-indigo-600 to-primary bg-clip-text text-transparent"
            >conversation.</span
          >
        </h1>

        <!-- Reading-Constrained Narrative Description -->
        <p
          class="mt-6 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto"
        >
          Have a question about MarkChat, need help exploring the platform, or want to discuss how
          we can support your business? Our Nairobi team is ready to help you turn customer chats
          into verified revenue.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. MAIN 2-COLUMN SECTION: DIRECT CHANNELS & MODERN CONTACT FORM       -->
  <!-- ===================================================================== -->
  <section class="py-16 sm:py-24 bg-surface/50 dark:bg-[#0B1120]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- LEFT COLUMN: Direct Communication Hub (5 Columns) -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
              Direct Communication Channels
            </h2>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              Reach out to our specialized desks directly. Every channel is monitored by our Nairobi
              operations team during active Kenyan business hours.
            </p>
          </div>

          <!-- Channel Cards Grid -->
          <div class="space-y-4">
            {
              channelCards.map((ch) => {
                const style = channelStyles[ch.accent] || channelStyles.blue;
                return (
                  <div
                    class={`bg-white dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xs hover:shadow-md transition-all duration-200 border-t-2 ${style.borderTop} flex flex-col justify-between group`}
                  >
                    <div class="flex items-start gap-4">
                      <div
                        class={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 border shadow-2xs ${style.iconBox}`}
                      >
                        <Icon name={ch.icon} class="w-5 h-5" />
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between gap-2">
                          <h3 class="text-sm font-bold text-slate-900 dark:text-white truncate">
                            {ch.title}
                          </h3>
                          <span
                            class={`px-2 py-0.5 rounded-full text-[10px] font-semibold border shrink-0 ${style.badge}`}
                          >
                            {ch.badge}
                          </span>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 leading-relaxed">
                          {ch.description}
                        </p>
                        <a
                          href={`mailto:${ch.email}`}
                          class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors group-hover:underline"
                        >
                          <span>{ch.email}</span>
                          <Icon
                            name="lucide:arrow-right"
                            class="w-3 h-3 group-hover:translate-x-0.5 transition-transform"
                          />
                        </a>
                      </div>
                    </div>
                  </div>
                );
              })
            }
          </div>

          <!-- Operations & Working Hours Card -->
          <div
            class="bg-slate-50 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 rounded-2xl p-5 sm:p-6 space-y-4"
          >
            <div class="flex items-start gap-3">
              <div
                class="w-9 h-9 rounded-xl bg-slate-200/70 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center shrink-0"
              >
                <Icon name="lucide:map-pin" class="w-4 h-4 text-blue-600 dark:text-blue-400" />
              </div>
              <div>
                <h4
                  class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
                >
                  Headquarters &amp; Operations
                </h4>
                <p class="text-sm font-bold text-slate-900 dark:text-white mt-0.5">
                  {office.street}
                </p>
                <p class="text-xs text-slate-600 dark:text-slate-400">
                  {office.city}, {office.country} (EAT / UTC+3)
                </p>
              </div>
            </div>

            <div
              class="pt-3 border-t border-slate-200/60 dark:border-slate-800 flex items-start gap-3"
            >
              <div
                class="w-9 h-9 rounded-xl bg-slate-200/70 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center shrink-0"
              >
                <Icon name="lucide:clock" class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
              </div>
              <div>
                <h4
                  class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
                >
                  Business Operating Hours
                </h4>
                <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 mt-0.5">
                  {contact.hours || 'Monday – Saturday, 8:00 AM – 6:00 PM EAT'}
                </p>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  Inquiries received outside business hours are prioritized next morning.
                </p>
              </div>
            </div>
          </div>

          <!-- Quick Live Demo Banner -->
          <div
            class="p-5 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white shadow-md relative overflow-hidden group"
          >
            <div
              class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
            >
              <div>
                <h4 class="text-sm font-bold">Prefer a guided live walkthrough?</h4>
                <p class="text-xs text-blue-100 mt-0.5">
                  Book a 20-minute tailored Google Meet demo with our local solution engineers.
                </p>
              </div>
              <a
                href="/demo"
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white text-blue-700 font-bold text-xs hover:bg-blue-50 transition-colors shrink-0 shadow-2xs"
              >
                <span>Book Demo</span>
                <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: Modernized Contact Form Card (7 Columns) -->
        <div class="lg:col-span-7">
          <div
            class="bg-white dark:bg-slate-900/70 border border-slate-200/90 dark:border-slate-800 rounded-2xl p-6 sm:p-8 lg:p-10 shadow-sm relative"
          >
            <div class="mb-6">
              <h2
                class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"
              >
                Send our team a message
              </h2>
              <p
                class="mt-1.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed"
              >
                Provide your requirements below. All messages are securely routed to our
                Single-Admin inbox and protected under Kenyan data protection standards.
              </p>
            </div>

            <!-- Modern Accessible Contact Form Island -->
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. SUPPORTING SECTION: FREQUENTLY ASKED INQUIRY QUESTIONS            -->
  <!-- ===================================================================== -->
  <section
    class="py-16 sm:py-20 border-t border-slate-200 dark:border-slate-800/80 bg-background transition-colors duration-200"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <div
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 mb-3"
        >
          <Icon name="lucide:help-circle" class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" />
          <span>Need Answers Fast?</span>
        </div>
        <h2
          class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight"
        >
          Common Questions Before Reaching Out
        </h2>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Quick clarity on MarkChat’s onboarding process, telco credentials, and local support.
        </p>
      </div>

      <!-- 4-Card FAQ Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {
          contactFAQs.map((faq) => (
            <div class="bg-white dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 rounded-2xl p-6 shadow-2xs hover:shadow-md transition-all duration-200">
              <h3 class="text-base font-bold text-slate-900 dark:text-white leading-snug">
                {faq.question}
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 text-center">
        <a
          href="/faq"
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 hover:underline transition-colors"
        >
          <span>View all categorized merchant FAQs</span>
          <Icon name="lucide:arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. SELF-SERVICE & DEVELOPER RESOURCES STRIP                          -->
  <!-- ===================================================================== -->
  <section
    class="py-12 bg-slate-50 dark:bg-slate-900/40 border-t border-slate-200 dark:border-slate-800/80"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">
            Prefer self-serve documentation?
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">
            Explore step-by-step setup guides for Safaricom Daraja, Meta WhatsApp Cloud API, and
            webhooks.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/docs"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700/80 transition-colors shadow-2xs"
          >
            <Icon name="lucide:book-open" class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" />
            <span>Developer Center</span>
          </a>
          <a
            href="/resources/status"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700/80 transition-colors shadow-2xs"
          >
            <Icon
              name="lucide:activity"
              class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"
            />
            <span>Service Status</span>
          </a>
          <a
            href="/resources/security"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700/80 transition-colors shadow-2xs"
          >
            <Icon name="lucide:shield" class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400" />
            <span>Security &amp; KDPA</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
