---
/**
 * MarkChat Forgot Password Page
 *
 * Implements the approved Direction A + D Split-Screen SaaS Layout.
 * Provides timing-safe password recovery initiation.
 */
import AuthSplitLayout from '@/layouts/AuthSplitLayout.astro';
import ForgotPasswordForm from '@/components/forms/ForgotPasswordForm.astro';
import { siteConfig } from '@/config';
---

<AuthSplitLayout
  title={`Reset Password — ${siteConfig.name} Kenya`}
  description="Request a password reset link for your MarkChat workspace."
  headline="Reset your password"
  subheadline="Enter your business email and we'll send you recovery instructions."
  pageType="forgot-password"
>
  <ForgotPasswordForm />
</AuthSplitLayout>
