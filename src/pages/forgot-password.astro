---
/**
 * MarkChat Forgot Password Page
 *
 * Implements the minimal, distraction-free AuthLayout built directly on BaseLayout.
 * Centered Virex card UI with native semantic OKLCH tokens and timing-safe password recovery.
 */
import AuthLayout from '@/layouts/AuthLayout.astro';
import ForgotPasswordForm from '@/components/forms/ForgotPasswordForm.astro';
import { siteConfig } from '@/config';
---

<AuthLayout
  title={`Reset Password — ${siteConfig.name} Kenya`}
  description="Request a password reset link for your MarkChat workspace."
  pageType="forgot-password"
>
  <div class="max-w-md mx-auto w-full">
    <!-- Centered Header with Title & Subheadline -->
    <div class="text-center mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-text tracking-tight">Reset your password</h1>
      <p class="mt-2 text-sm text-text-muted">
        Enter your business email and we'll send you recovery instructions.
      </p>
    </div>

    <!-- Virex Card Container -->
    <div class="bg-surface border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <ForgotPasswordForm />
    </div>
  </div>
</AuthLayout>
