---
/**
 * MarkChat Customer Registration Page
 *
 * Implements the minimal, distraction-free AuthLayout built directly on BaseLayout.
 * Centered Virex card UI with native semantic OKLCH tokens and two-step registration wizard.
 */
import AuthLayout from '@/layouts/AuthLayout.astro';
import RegisterForm from '@/components/forms/RegisterForm.astro';
import { siteConfig } from '@/config';

const url = new URL(Astro.request.url);
const selectedPlan = url.searchParams.get('plan') || 'growth';
---

<AuthLayout
  title={`Create Account — ${siteConfig.name} Kenya`}
  description="Register your business on MarkChat. Unify WhatsApp, SMS, Instagram, and Safaricom Daraja M-Pesa into one collaborative team workspace."
  pageType="register"
>
  <div class="max-w-xl mx-auto w-full">
    <!-- Centered Header with Title & Subheadline -->
    <div class="text-center mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-text tracking-tight">Create your MarkChat Workspace</h1>
      <p class="mt-2 text-sm text-text-muted">Start your 72-hour trial with unified WhatsApp, in-chat M-Pesa, and team inbox.</p>
    </div>

    <!-- Virex Card Container -->
    <div class="bg-surface border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <RegisterForm defaultPlanId={selectedPlan} redirectUrl="/billing" />
    </div>
  </div>
</AuthLayout>