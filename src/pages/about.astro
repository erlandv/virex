---
/**
 * MarkChat Kenya — About Us
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import StatsSection from '@sections/social-proof/StatsSection.astro';
import ValuesSection from '@sections/team/ValuesSection.astro';
import TeamSection from '@sections/team/TeamSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';

const team = [
  {
    name: 'Kevin Otieno',
    role: 'CEO & Co-founder',
    bio: 'Former fintech infrastructure engineer in Nairobi. Kevin founded MarkChat to solve the epidemic of fake M-Pesa screenshot fraud in chat commerce.',
    avatar: '/images/team/kevin-otieno.webp',
  },
  {
    name: 'Faith Mwangi',
    role: 'CTO & Co-founder',
    bio: 'Pioneered high-throughput webhook pipelines for Safaricom Daraja and Meta Cloud API across East Africa.',
    avatar: '/images/team/faith-mwangi.webp',
  },
  {
    name: 'Brian Kiprop',
    role: 'Head of Telecommunications',
    bio: 'Telecommunications routing specialist with 8+ years optimizing Africa’s Talking and local carrier SMS delivery.',
    avatar: '/images/team/brian-kiprop.webp',
  },
  {
    name: 'Amina Hassan',
    role: 'Head of AI & NLP',
    bio: 'Natural language processing researcher leading the development of Markcopilot’s Swahili, Sheng, and English retail models.',
    avatar: '/images/team/amina-hassan.webp',
  },
];

const values = [
  {
    title: 'Built for Kenya First',
    description:
      'We design exclusively for local commerce reality: Safaricom Paybill, Buy Goods Tills, Pochi la Biashara, and WhatsApp-driven sales.',
  },
  {
    title: 'Zero Payment Fraud',
    description:
      'We protect hardworking merchants from counterfeit M-Pesa SMS screenshots by cryptographically validating every TransID server-side.',
  },
  {
    title: 'Conversational Speed',
    description:
      'Every second a customer waits for a Till number is an abandoned sale. We prompt instant STK PIN popups in under 10 seconds.',
  },
  {
    title: 'Radical Simplicity',
    description:
      'No complex enterprise installations. Onboard your sales team, connect your WhatsApp number, and start selling today.',
  },
];

const stats = [
  { value: '6 Channels', label: 'Unified in One Inbox' },
  { value: 'Direct C2B', label: 'Safaricom Webhook Sync' },
  { value: 'BYOC', label: 'Africa’s Talking Support' },
  { value: '< 10s', label: 'Direct /stk Prompt Delivery' },
];

const APP_URL = import.meta.env.PUBLIC_APP_URL || 'http://localhost:3000';
---

<MarketingLayout
  title={`About Us - ${siteConfig.name}`}
  description="Learn about MarkChat Kenya: our Nairobi engineering team, mission to stop fake M-Pesa screenshots, and omnichannel commerce platform."
>
  <PageHeader
    title="Empowering African Commerce Through Instant Conversational Sales"
    align="left"
    maxWidth="lg"
  >
    <p class="mt-6 text-lg text-text-muted leading-relaxed">
      MarkChat was born in Westlands, Nairobi, out of a simple observation: Kenyan merchants were
      closing over 70% of their sales on WhatsApp, Instagram, and SMS, but payment collection
      remained manual, error-prone, and vulnerable to counterfeit M-Pesa confirmation screenshots.
    </p>
    <p class="mt-4 text-lg text-text-muted leading-relaxed">
      We united official Meta WhatsApp Cloud API, Africa’s Talking Bulk SMS, and Safaricom Daraja
      STK push into one seamless platform. Today, thousands of retail stores, pharmacies, salons,
      and logistics businesses use MarkChat to turn conversations into confirmed mobile money
      revenue.
    </p>
  </PageHeader>

  <StatsSection stats={stats} background="muted" />

  <ValuesSection title="Our Core Principles" items={values} variant="card" background="default" />

  <TeamSection
    title="The Nairobi Team Behind MarkChat"
    subtitle="Engineers, fintech operators, and telecommunications specialists dedicated to African merchant success."
    members={team}
    columns={4}
    background="muted"
  />

  <CTA
    title="Ready to accelerate your conversational sales?"
    description="Sign up in 30 seconds. 50 free Bulk SMS credits included on all accounts."
    action={{ label: 'Get Started Free', href: `${APP_URL}/app/auth/signup` }}
    secondaryAction={{ label: 'Explore Open Careers', href: '/careers' }}
    background="default"
  />
</MarketingLayout>
