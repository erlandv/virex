---
/**
 * IntegrationsHeroShowcase - Interconnected Ecosystem Visual Hub
 *
 * Demonstrates MarkChat as the central orchestration engine connected to
 * Kenyan mobile money, official Meta WhatsApp, Africa's Talking SMS, and developer APIs.
 */
import { Icon } from 'astro-icon/components';
import IntegrationIcon from '@/components/ui/IntegrationIcon.astro';
---

<div
  class="integrations-showcase-container relative w-full max-w-5xl mx-auto rounded-3xl border border-slate-200/90 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 p-6 sm:p-10 shadow-2xl backdrop-blur-xl overflow-hidden text-left"
>
  <!-- Ambient Inner Glows -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[500px] h-[350px] sm:h-[500px] bg-primary/10 blur-[100px] rounded-full pointer-events-none -z-10"
  >
  </div>

  <!-- Header Status Bar -->
  <div
    class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-8 border-b border-slate-200/80 dark:border-slate-800 gap-3"
  >
    <div class="flex items-center gap-2.5">
      <div class="flex gap-1.5">
        <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
      </div>
      <span
        class="font-mono text-xs font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5 ml-2"
      >
        <Icon name="lucide:network" class="w-4 h-4 text-primary" />
        ecosystem.markchat.app / live-nodes
      </span>
    </div>

    <div class="flex items-center gap-3 text-xs font-mono text-slate-500 dark:text-slate-400">
      <span
        class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-bold"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        All Connectors Operational
      </span>
      <span class="hidden sm:inline text-slate-300 dark:text-slate-700">|</span>
      <span class="hidden sm:inline">19 Verified Integrations</span>
    </div>
  </div>

  <!-- Central Hub + Radial Satellite Network -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <!-- Left Column: Communication Inboxes (4 cols) -->
    <div class="lg:col-span-4 space-y-3">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-2">
        Customer Channels
      </span>

      <!-- WhatsApp Node -->
      <div
        class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between group hover:border-emerald-500/50 transition-all shadow-xs"
      >
        <div class="flex items-center gap-3 min-w-0">
          <IntegrationIcon iconKey="whatsapp" name="WhatsApp" size="sm" />
          <div class="min-w-0">
            <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate">
              WhatsApp Cloud API
            </h4>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Official Meta Gateway</span
            >
          </div>
        </div>
        <span
          class="text-[9px] font-mono bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 px-2 py-0.5 rounded-full font-bold"
        >
          Verified
        </span>
      </div>

      <!-- SMS Node -->
      <div
        class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between group hover:border-amber-500/50 transition-all shadow-xs"
      >
        <div class="flex items-center gap-3 min-w-0">
          <IntegrationIcon iconKey="africas-talking" name="Africa's Talking" size="sm" />
          <div class="min-w-0">
            <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate">
              Africa's Talking SMS
            </h4>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">BYOC Direct Carrier</span>
          </div>
        </div>
        <span
          class="text-[9px] font-mono bg-amber-500/15 text-amber-600 dark:text-amber-400 px-2 py-0.5 rounded-full font-bold"
        >
          2-Way
        </span>
      </div>

      <!-- Social Node -->
      <div
        class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between group hover:border-rose-500/50 transition-all shadow-xs"
      >
        <div class="flex items-center gap-3 min-w-0">
          <IntegrationIcon iconKey="instagram" name="Instagram & Messenger" size="sm" />
          <div class="min-w-0">
            <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate">
              Instagram DMs &amp; FB
            </h4>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Social Commerce Queue</span
            >
          </div>
        </div>
        <span
          class="text-[9px] font-mono bg-rose-500/15 text-rose-600 dark:text-rose-400 px-2 py-0.5 rounded-full font-bold"
        >
          Unified
        </span>
      </div>
    </div>

    <!-- Center Column: MarkChat Orchestration Core (4 cols) -->
    <div class="lg:col-span-4 flex flex-col items-center justify-center py-4 sm:py-6 text-center">
      <div class="relative flex items-center justify-center">
        <!-- Outer Glowing Pulse Rings -->
        <div
          class="absolute w-28 h-28 rounded-full border-2 border-primary/30 animate-ping pointer-events-none"
        >
        </div>
        <div class="absolute w-36 h-36 rounded-full border border-primary/20 pointer-events-none">
        </div>

        <!-- Center Badge -->
        <div
          class="relative w-20 h-20 rounded-3xl bg-gradient-to-tr from-primary via-indigo-600 to-indigo-700 text-white flex flex-col items-center justify-center shadow-xl shadow-primary/30 z-10 p-2"
        >
          <Icon name="lucide:message-square" class="w-8 h-8 text-white mb-0.5" />
          <span class="font-extrabold text-[10px] tracking-wider uppercase">MarkChat</span>
        </div>
      </div>

      <div class="mt-4 space-y-1">
        <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">
          Central Workspace Hub
        </h4>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 max-w-[220px]">
          Ingests conversations, validates M-Pesa payments, and dispatches webhooks in real time.
        </p>
      </div>
    </div>

    <!-- Right Column: Payments & Business Systems (4 cols) -->
    <div class="lg:col-span-4 space-y-3">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-2">
        Payments &amp; Systems
      </span>

      <!-- M-Pesa Daraja Node -->
      <div
        class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between group hover:border-emerald-500/50 transition-all shadow-xs"
      >
        <div class="flex items-center gap-3 min-w-0">
          <IntegrationIcon iconKey="mpesa" name="Safaricom M-Pesa" size="sm" />
          <div class="min-w-0">
            <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate">
              M-Pesa Daraja C2B
            </h4>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">In-Chat /stk Checkout</span
            >
          </div>
        </div>
        <span
          class="text-[9px] font-mono bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 px-2 py-0.5 rounded-full font-bold"
        >
          TransID
        </span>
      </div>

      <!-- Developer APIs Node -->
      <div
        class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between group hover:border-blue-500/50 transition-all shadow-xs"
      >
        <div class="flex items-center gap-3 min-w-0">
          <IntegrationIcon iconKey="api" name="Developer APIs" size="sm" />
          <div class="min-w-0">
            <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate">
              REST APIs &amp; Webhooks
            </h4>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">HMAC-SHA256 Signed</span>
          </div>
        </div>
        <span
          class="text-[9px] font-mono bg-blue-500/15 text-blue-600 dark:text-blue-400 px-2 py-0.5 rounded-full font-bold"
        >
          OpenAPI
        </span>
      </div>

      <!-- Markcopilot Node -->
      <div
        class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between group hover:border-indigo-500/50 transition-all shadow-xs"
      >
        <div class="flex items-center gap-3 min-w-0">
          <IntegrationIcon iconKey="markcopilot" name="Markcopilot AI" size="sm" />
          <div class="min-w-0">
            <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate">
              Markcopilot AI
            </h4>
            <span class="text-[10px] text-slate-500 dark:text-slate-400"
              >Bilingual Agent Copilot</span
            >
          </div>
        </div>
        <span
          class="text-[9px] font-mono bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 px-2 py-0.5 rounded-full font-bold"
        >
          English/Swa
        </span>
      </div>
    </div>
  </div>

  <!-- Bottom Compatibility Pills -->
  <div
    class="mt-8 pt-5 border-t border-slate-200/80 dark:border-slate-800 flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-xs text-slate-500 dark:text-slate-400"
  >
    <span class="flex items-center gap-1.5 font-medium">
      <Icon name="lucide:check-circle" class="w-3.5 h-3.5 text-emerald-500" />
      Dedicated Paybill &amp; Till
    </span>
    <span class="flex items-center gap-1.5 font-medium">
      <Icon name="lucide:check-circle" class="w-3.5 h-3.5 text-emerald-500" />
      Shared Bank Paybill Routing
    </span>
    <span class="flex items-center gap-1.5 font-medium">
      <Icon name="lucide:check-circle" class="w-3.5 h-3.5 text-emerald-500" />
      Pochi la Biashara SMS Forwarder
    </span>
    <span class="flex items-center gap-1.5 font-medium">
      <Icon name="lucide:check-circle" class="w-3.5 h-3.5 text-emerald-500" />
      Zero Platform Markup on BYOC SMS
    </span>
  </div>
</div>

<style>
  .integrations-showcase-container {
    box-shadow:
      0 25px 60px -15px rgba(0, 0, 0, 0.12),
      0 0 45px -10px rgba(99, 102, 241, 0.1);
  }
</style>
