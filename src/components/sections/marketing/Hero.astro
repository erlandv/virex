---
import MCContainer from '@/components/design-system/MCContainer.astro';
import MCButton from '@/components/design-system/MCButton.astro';
import MCProductFrame from '@/components/design-system/MCProductFrame.astro';
import MCStatusBadge from '@/components/design-system/MCStatusBadge.astro';
import { resolveProductAsset, type CmsProductMediaOverride } from '@/data/product-assets';

interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
  cmsMedia?: CmsProductMediaOverride | null;
}

const {
  title = 'One inbox for customer conversations, AI-assisted responses, and M-Pesa payment workflows.',
  subtitle = 'Built for Kenyan businesses. Manage supported customer channels, assist your team with Markcopilot, and connect configured M-Pesa payment workflows.',
  badge = 'MARKCHAT FOR KENYAN BUSINESSES',
  primaryCTA = { label: 'Get Started', href: '/register' },
  secondaryCTA = { label: 'Book a Demo', href: '/demo' },
  cmsMedia,
} = Astro.props;

const light = resolveProductAsset('inbox', 'light', cmsMedia);
const dark = resolveProductAsset('inbox', 'dark', cmsMedia);
---

<section
  id="product-hero"
  class="border-b border-border bg-background py-14 sm:py-20 lg:py-24"
  aria-labelledby="hero-heading"
>
  <MCContainer>
    <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
      <div class="max-w-2xl">
        <p class="mb-5 text-xs font-bold uppercase tracking-widest text-primary">{badge}</p>
        <h1
          id="hero-heading"
          class="text-4xl font-extrabold leading-tight tracking-tight text-text sm:text-5xl lg:text-[3.5rem]"
        >
          {title}
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-text-muted sm:text-lg">
          {subtitle}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <MCButton href={primaryCTA.href}>{primaryCTA.label}</MCButton>
          <MCButton href={secondaryCTA.href} variant="secondary">{secondaryCTA.label}</MCButton>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-3 text-xs text-text-muted">
          <span class="rounded-md border border-border bg-surface px-3 py-2"
            >Official channel setup</span
          >
          <span class="rounded-md border border-border bg-surface px-3 py-2"
            >Human-reviewed AI assistance</span
          >
          <span class="rounded-md border border-border bg-surface px-3 py-2"
            >Configured Daraja workflows</span
          >
        </div>
      </div>
      <div class="min-w-0">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <span class="text-sm font-semibold text-text">MarkChat Shared Inbox</span>
          <MCStatusBadge status="preview" label="Synthetic demo / product preview" />
        </div>
        <div class="dark:hidden">
          <MCProductFrame
            src={light.src}
            alt={light.alt}
            label="Unified Inbox demonstration preview"
          />
        </div>
        <div class="hidden dark:block">
          <MCProductFrame
            src={dark.src}
            alt={dark.alt}
            label="Unified Inbox demonstration preview"
          />
        </div>
        <p class="mt-3 text-xs leading-relaxed text-text-muted">
          Product images are shown only after approved capture or CMS upload. Illustrative
          placeholders do not represent live customer data.
        </p>
      </div>
    </div>
  </MCContainer>
</section>
