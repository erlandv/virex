---
import MCContainer from '@/components/design-system/MCContainer.astro';
import MCSectionHeading from '@/components/design-system/MCSectionHeading.astro';
import { Icon } from 'astro-icon/components';

const industryUseCases = [
  {
    title: 'Retail, E-Commerce & Dukas',
    icon: 'lucide:shopping-bag',
    description: 'Reply to WhatsApp and Instagram inquiries, coordinate team handoffs, and guide buyers through configured checkout workflows.',
    href: '/solutions/ecommerce',
    label: 'Retail & social commerce',
  },
  {
    title: 'Clinics & Professional Services',
    icon: 'lucide:heart-pulse',
    description: 'Organize appointment questions and route conversations to the right staff. Patient details require appropriate privacy controls.',
    href: '/solutions/healthcare',
    label: 'Client care',
  },
  {
    title: 'Pharmacies',
    icon: 'lucide:briefcase-medical',
    description: 'Manage stock questions, opening hours, and customer service follow-ups without exposing sensitive medical information.',
    href: '/solutions/pharmacies',
    label: 'Pharmacy support',
  },
  {
    title: 'Education & Academies',
    icon: 'lucide:graduation-cap',
    description: 'Keep admissions, fee inquiries, and parent conversations organized during busy school seasons.',
    href: '/solutions/education',
    label: 'Education',
  },
  {
    title: 'Customer Support & Sales Teams',
    icon: 'lucide:headset',
    description: 'Share conversations, coordinate assignments, and let agents review AI-assisted replies before sending.',
    href: '/solutions/support',
    label: 'Growing teams',
  },
  {
    title: 'Financial & Payment Operations',
    icon: 'lucide:shield-check',
    description: 'Use configured M-Pesa Daraja callbacks to review payment status instead of relying on customer screenshots.',
    href: '/solutions/fintech',
    label: 'Payment workflows',
  },
  {
    title: 'Hospitality & Safari Travel',
    icon: 'lucide:compass',
    description: 'Keep booking and travel inquiries from connected messaging channels in one shared customer support workflow.',
    href: '/solutions/travel',
    label: 'Travel & hospitality',
  },
];
---

<section class="border-b border-border bg-surface py-12 sm:py-16 lg:py-24" aria-labelledby="industries-heading">
  <MCContainer>
    <div class="mb-10">
      <MCSectionHeading
        eyebrow="Tailored Industry Solutions"
        title="Engineered for How Your Sector Communicates & Sells"
        description="Straightforward tools for Kenyan retail businesses, clinics, pharmacies, schools and service teams."
      />
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        industryUseCases.map((item) => (
          <a
            href={item.href}
            class="group flex h-full flex-col gap-4 rounded-xl border border-border bg-surface-elevated p-5 transition-colors hover:border-primary/50 sm:p-7"
          >
            <div class="flex h-11 w-11 items-center justify-center rounded-lg border border-border bg-surface text-primary">
              <Icon name={item.icon} class="h-5 w-5" />
            </div>
            <div>
              <span class="text-xs font-medium text-text-muted">{item.label}</span>
              <h3 class="mt-1 text-lg font-bold text-text">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-text-muted">{item.description}</p>
            </div>
            <span class="mt-auto text-sm font-semibold text-primary">
              View workflow <Icon name="lucide:arrow-right" class="ml-1 inline h-4 w-4" />
            </span>
          </a>
        ))
      }
    </div>
    <div class="mt-9">
      <a href="/solutions" class="inline-flex min-h-11 items-center rounded-lg border border-border bg-background px-5 py-3 text-sm font-semibold text-text hover:border-primary/50">
        Explore all 19 industry workflows & team solutions
      </a>
    </div>
  </MCContainer>
</section>
