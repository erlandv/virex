---
/**
 * IntegrationsGrid - Display supported Kenyan integrations
 */
import IntegrationIcon from '@/components/ui/IntegrationIcon.astro';

export interface IntegrationCardItem {
  slug?: string;
  name: string;
  category?: string;
  iconKey?: string;
  logoUrl?: string;
  logo?: string;
  description?: string;
  shortDescription?: string;
  href?: string;
  featured?: boolean;
  popular?: boolean;
  isPopular?: boolean;
}

interface Props {
  title?: string;
  subtitle?: string;
  integrations: IntegrationCardItem[];
  showFilter?: boolean;
  variant?: 'grid' | 'compact' | 'detailed';
  columns?: 3 | 4 | 5 | 6;
  invertOnDark?: boolean;
  footerLink?: { label: string; href: string };
  background?: 'default' | 'muted' | 'accent';
}

const {
  title,
  subtitle,
  integrations,
  showFilter = false,
  variant = 'detailed',
  columns = 3,
  background = 'default',
  footerLink,
} = Astro.props;

const bgClass = {
  default: 'bg-background',
  muted: 'bg-surface/50',
  accent: 'bg-primary/5',
}[background];

const gridColsClass = {
  3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
  5: 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5',
  6: 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6',
}[columns];

const isCompact = variant === 'compact';

const categories = showFilter
  ? ['All', ...new Set(integrations.map((i) => i.category).filter(Boolean))]
  : [];
---

<section class:list={['py-16 sm:py-24 border-y border-border', bgClass]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {
      (title || subtitle) && (
        <div class="text-center max-w-3xl mx-auto mb-14">
          {title && (
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text">{title}</h2>
          )}
          {subtitle && <p class="mt-4 text-base sm:text-lg text-text-muted">{subtitle}</p>}
        </div>
      )
    }

    {
      showFilter && categories.length > 1 && (
        <div class="flex flex-wrap justify-center gap-2 mb-10" data-filter-tabs>
          {categories.map((category, index) => (
            <button
              type="button"
              class:list={[
                'px-4 py-2 rounded-full text-xs font-semibold transition-all cursor-pointer',
                index === 0
                  ? 'bg-primary text-white shadow-sm'
                  : 'bg-surface border border-border text-text-muted hover:text-text hover:bg-surface-hover',
              ]}
              data-category={category}
            >
              {category}
            </button>
          ))}
        </div>
      )
    }

    <!-- Integrations Grid -->
    <div
      class:list={['grid gap-6', gridColsClass, isCompact && 'text-center']}
      data-integrations-grid
    >
      {
        integrations.map((item) => {
          const itemHref =
            item.href || (item.slug ? `/integrations/${item.slug}` : '/integrations');
          const isItemPopular = item.isPopular ?? item.popular ?? item.featured ?? false;
          const desc = item.description || item.shortDescription || '';

          return (
            <a
              href={itemHref}
              class="group relative flex flex-col justify-between p-6 rounded-2xl border border-border bg-background hover:border-primary/50 hover:shadow-lg transition-all"
              data-category={item.category || 'All'}
            >
              <div>
                <div class="flex items-center justify-between gap-4 mb-4">
                  <IntegrationIcon
                    iconKey={item.iconKey || item.name}
                    logoUrl={item.logoUrl || item.logo}
                    name={item.name}
                    size="md"
                  />
                  {isItemPopular && (
                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-primary/10 text-primary border border-primary/20">
                      Popular
                    </span>
                  )}
                </div>

                <h3 class="text-lg font-bold text-text group-hover:text-primary transition-colors">
                  {item.name}
                </h3>
                {item.category && (
                  <p class="text-xs font-mono font-medium text-text-muted mt-1 uppercase tracking-wider">
                    {item.category}
                  </p>
                )}
                {desc && (
                  <p class="text-sm text-text-muted mt-3 line-clamp-2 leading-relaxed">{desc}</p>
                )}
              </div>

              <div class="mt-5 pt-4 border-t border-border/50 flex items-center justify-between text-xs font-semibold text-primary">
                <span>View integration architecture</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          );
        })
      }
    </div>

    {
      footerLink && (
        <div class="text-center mt-12">
          <a
            href={footerLink.href}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border bg-surface text-text hover:border-primary hover:text-primary font-semibold text-sm transition-all shadow-xs"
          >
            <span>{footerLink.label}</span>
          </a>
        </div>
      )
    }
  </div>
</section>
``
