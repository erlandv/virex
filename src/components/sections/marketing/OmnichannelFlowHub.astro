---
import MCContainer from '@/components/design-system/MCContainer.astro';
import MCSectionHeading from '@/components/design-system/MCSectionHeading.astro';
import MCIntegrationIcon from '@/components/design-system/MCIntegrationIcon.astro';
import MCStatusBadge from '@/components/design-system/MCStatusBadge.astro';

const channels = [
  { id: 'whatsapp', name: 'WhatsApp Business Cloud', status: 'integration' as const },
  { id: 'instagram', name: 'Instagram DM', status: 'integration' as const },
  { id: 'messenger', name: 'Facebook Messenger', status: 'integration' as const },
  { id: 'tiktok', name: 'TikTok Business Messaging', status: 'planned' as const },
  { id: 'telegram', name: 'Telegram', status: 'integration' as const },
  { id: 'email', name: 'Email Inbox', status: 'integration' as const },
  { id: 'mpesa', name: 'M-Pesa Daraja', status: 'integration' as const },
  { id: 'google', name: 'Google Sign-in', status: 'integration' as const },
  { id: 'shopify', name: 'Shopify', status: 'integration' as const },
  { id: 'website', name: 'Website Live Chat', status: 'integration' as const },
];
---

<section class="border-b border-border bg-background py-12 sm:py-16" aria-label="Supported communication and commerce integration channels">
  <MCContainer>
    <div class="mb-9">
      <MCSectionHeading
        eyebrow="Connected customer channels"
        title="Meet customers where they already communicate"
        description="Connect eligible channels using the relevant provider setup and approvals. Integration availability and rollout depend on your workspace and provider access."
      />
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {
        channels.map((channel) => (
          <div class="flex min-h-36 flex-col items-start justify-between gap-3 rounded-xl border border-border bg-surface-elevated p-4">
            <MCIntegrationIcon iconKey={channel.id} name={channel.name} size="sm" />
            <div class="space-y-2">
              <h3 class="text-sm font-semibold leading-snug text-text">{channel.name}</h3>
              <MCStatusBadge status={channel.status} />
            </div>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-xs leading-relaxed text-text-muted">
      Channel names and logos belong to their respective owners. Provider activation, permissions and integration readiness are verified during onboarding.
    </p>
  </MCContainer>
</section>
