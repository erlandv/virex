---
/**
 * CTA - Call-to-action section with colored background
 *
 * @description
 * A prominent call-to-action section with a primary-colored background.
 * Ideal for encouraging user engagement at the end of pages.
 *
 * @example
 * ```astro
 * <CTA
 *   title="Ready to get started?"
 *   description="Join thousands of developers shipping faster."
 *   action={{ label: "Start Free Trial", href: "/signup" }}
 * />
 * ```
 *
 * @example With background
 * ```astro
 * <CTA
 *   title="Ready to get started?"
 *   description="Join thousands of developers."
 *   action={{ label: "Start Free Trial", href: "/signup" }}
 *   background="muted"
 * />
 * ```
 */

interface Props {
  /** Headline text for the CTA section */
  title: string;
  /** Supporting description text */
  description: string;
  /** Primary action button with label and link */
  action: { label: string; href: string };
  /** Optional secondary action button */
  secondaryAction?: { label: string; href: string };
  /** Section background style */
  background?: 'default' | 'muted' | 'accent';
  variant?: 'standard' | 'dark';
}

const {
  title,
  description,
  action,
  secondaryAction,
  background = 'default',
  variant = 'standard',
} = Astro.props;

const bgClass = {
  default: 'bg-background',
  muted: 'bg-surface',
  accent: 'bg-primary/5',
}[background];
---

<section class:list={['border-b border-border py-12 sm:py-16 lg:py-24', bgClass]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class:list={[
        'rounded-2xl border px-6 py-12 text-center sm:px-10 sm:py-16',
        variant === 'dark'
          ? 'border-[#404040] bg-[#171717] text-white'
          : 'border-border bg-surface-elevated text-text',
      ]}
    >
      <h2
        class:list={[
          'text-3xl font-bold sm:text-4xl',
          variant === 'dark' ? 'text-white' : 'text-text',
        ]}
      >
        {title}
      </h2>
      <p
        class:list={[
          'mx-auto mt-4 max-w-2xl text-base leading-relaxed sm:text-lg',
          variant === 'dark' ? 'text-neutral-300' : 'text-text-muted',
        ]}
      >
        {description}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={action.href}
          class="inline-flex min-h-11 items-center justify-center rounded-lg border border-primary bg-primary px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
        >
          {action.label}
        </a>
        {
          secondaryAction && (
            <a
              href={secondaryAction.href}
              class:list={[
                'inline-flex min-h-11 items-center justify-center rounded-lg border px-6 py-3 text-sm font-semibold transition-colors',
                variant === 'dark'
                  ? 'border-neutral-500 bg-[#262626] text-white hover:border-primary'
                  : 'border-border bg-background text-text hover:border-primary/50',
              ]}
            >
              {secondaryAction.label}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
