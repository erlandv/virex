---
import MCSection from '@/components/design-system/MCSection.astro';

interface Props {
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  size?: 'default' | 'large';
  maxWidth?: 'sm' | 'md' | 'lg' | 'full';
  background?: 'default' | 'muted' | 'accent';
}

const {
  title,
  subtitle,
  align = 'center',
  size = 'default',
  maxWidth = 'lg',
  background = 'default',
} = Astro.props;

const alignClass = align === 'left' ? 'text-left' : 'text-center';
const titleSizeClass =
  size === 'large' ? 'text-4xl sm:text-5xl lg:text-6xl' : 'text-4xl sm:text-5xl';
const widths = {
  sm: 'max-w-xl',
  md: 'max-w-2xl',
  lg: 'max-w-3xl',
  full: 'max-w-none',
};
const tone = background === 'default' ? 'default' : 'muted';
---

<MCSection tone={tone}>
  <div class:list={[widths[maxWidth], alignClass, align === 'center' && 'mx-auto']}>
    <h1 class:list={['font-bold leading-tight tracking-tight text-text', titleSizeClass]}>
      {title}
    </h1>
    {subtitle && <p class="mt-6 text-lg leading-relaxed text-text-muted">{subtitle}</p>}
    <slot />
  </div>
</MCSection>
