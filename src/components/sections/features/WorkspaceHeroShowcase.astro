---
/**
 * WorkspaceHeroShowcase - Interactive-feeling 3-Pane Unified Workspace Preview
 *
 * Highlights MarkChat's collaborative team inbox, in-chat /stk M-Pesa prompt,
 * and customer 360 profile context drawer without empty boxes or placeholder imagery.
 */
import { Icon } from 'astro-icon/components';
---

<div
  class="workspace-showcase-wrapper w-full max-w-6xl mx-auto rounded-xl md:rounded-xl border border-slate-200/80 dark:border-slate-800 bg-white/90 dark:bg-surface shadow-none  overflow-hidden"
>
  <!-- Window Header Bar -->
  <div
    class="workspace-bar flex items-center justify-between px-4 py-3 bg-slate-100/80 dark:bg-slate-800/80 border-b border-slate-200 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400 select-none"
  >
    <div class="flex items-center gap-2">
      <div class="flex gap-1.5">
        <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
      </div>
      <span
        class="ml-2 font-mono text-[11px] font-medium text-slate-600 dark:text-slate-300 flex items-center gap-1.5"
      >
        <Icon name="lucide:layout" class="w-3.5 h-3.5 text-primary" />
        markchat.app / workspace / inbox / conv_849204
      </span>
    </div>
    <div class="hidden sm:flex items-center gap-3 font-mono text-[11px]">
      <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        WebSocket Live (Nairobi GMT+3)
      </span>
      <span class="text-slate-300 dark:text-slate-700">|</span>
      <span>Daraja C2B Active</span>
    </div>
  </div>

  <!-- 3-Pane Body -->
  <div
    class="grid grid-cols-1 lg:grid-cols-12 min-h-[580px] divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800 text-left"
  >
    <!-- PANE 1: Channels & Conversation Queues (3 cols on lg) -->
    <div
      class="lg:col-span-3 bg-slate-50/60 dark:bg-slate-950/40 p-3 sm:p-4 flex flex-col justify-between"
    >
      <div>
        <!-- Inboxes Header -->
        <div class="flex items-center justify-between mb-3 px-1">
          <div class="flex items-center gap-2">
            <Icon name="lucide:inbox" class="w-4 h-4 text-primary" />
            <span
              class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
            >
              Active Inboxes
            </span>
          </div>
          <span class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded-full font-bold">
            14 Unresolved
          </span>
        </div>

        <!-- Channel Filter Chips -->
        <div class="flex flex-wrap gap-1.5 mb-4 px-1">
          <span
            class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-medium text-slate-700 dark:text-slate-200 shadow-none"
          >
            <Icon name="simple-icons:whatsapp" class="w-3 h-3 text-emerald-500" /> WhatsApp
          </span>
          <span
            class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-medium text-slate-700 dark:text-slate-200 shadow-none"
          >
            <Icon name="lucide:message-square" class="w-3 h-3 text-blue-500" /> SMS
          </span>
          <span
            class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-medium text-slate-700 dark:text-slate-200 shadow-none"
          >
            <Icon name="simple-icons:instagram" class="w-3 h-3 text-rose-500" /> IG
          </span>
        </div>

        <!-- Conversation Threads List -->
        <div class="space-y-1.5">
          <!-- Active Thread: Wanjiku -->
          <div
            class="p-2.5 rounded-xl bg-primary/10 border border-primary/20 transition-all cursor-pointer shadow-none"
          >
            <div class="flex items-start justify-between gap-1">
              <div class="flex items-center gap-1.5 min-w-0">
                <Icon name="simple-icons:whatsapp" class="w-3.5 h-3.5 text-emerald-500 shrink-0" />
                <span class="text-xs font-bold text-slate-900 dark:text-white truncate"
                  >Wanjiku Kamau</span
                >
              </div>
              <span class="text-[10px] text-primary font-semibold shrink-0">Just now</span>
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-300 line-clamp-1 mt-1 font-medium">
              M-Pesa TransID QKH78219LM verified...
            </p>
            <div class="flex items-center gap-1.5 mt-2">
              <span
                class="text-[9px] bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 font-bold px-1.5 py-0.2 rounded"
              >
                KES 3,500 Paid
              </span>
              <span
                class="text-[9px] bg-slate-200/80 dark:bg-slate-800 text-slate-600 dark:text-slate-300 px-1.5 py-0.2 rounded font-medium"
              >
                Brian O.
              </span>
            </div>
          </div>

          <!-- Thread 2: Otieno Juma -->
          <div
            class="p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/50 border border-transparent transition-all cursor-pointer"
          >
            <div class="flex items-start justify-between gap-1">
              <div class="flex items-center gap-1.5 min-w-0">
                <Icon name="lucide:message-square" class="w-3.5 h-3.5 text-blue-500 shrink-0" />
                <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 truncate"
                  >Otieno Juma</span
                >
              </div>
              <span class="text-[10px] text-slate-400 shrink-0">2m ago</span>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1 mt-1">
              Do you offer wholesale bulk discounts for Kisumu?
            </p>
            <div class="flex items-center gap-1.5 mt-1.5">
              <span
                class="text-[9px] bg-blue-500/10 text-blue-500 font-semibold px-1.5 py-0.2 rounded"
              >
                SMS AT
              </span>
              <span class="text-[9px] text-slate-400">Unassigned</span>
            </div>
          </div>

          <!-- Thread 3: Zuri Beauty IG -->
          <div
            class="p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/50 border border-transparent transition-all cursor-pointer"
          >
            <div class="flex items-start justify-between gap-1">
              <div class="flex items-center gap-1.5 min-w-0">
                <Icon name="simple-icons:instagram" class="w-3.5 h-3.5 text-rose-500 shrink-0" />
                <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 truncate"
                  >Mercy Mwangi</span
                >
              </div>
              <span class="text-[10px] text-slate-400 shrink-0">14m ago</span>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1 mt-1">
              Price for the organic serum 50ml bottle?
            </p>
            <div class="flex items-center gap-1.5 mt-1.5">
              <span
                class="text-[9px] bg-rose-500/10 text-rose-500 font-semibold px-1.5 py-0.2 rounded"
              >
                IG Direct
              </span>
              <span class="text-[9px] text-slate-400">Sarah K.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Live Agent Indicator -->
      <div
        class="pt-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400"
      >
        <span class="flex items-center gap-1.5 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          3 Agents Online
        </span>
        <span class="font-mono text-[10px]">Avg SLA: 42s</span>
      </div>
    </div>

    <!-- PANE 2: Active Conversation & In-Chat M-Pesa Flow (6 cols on lg) -->
    <div class="lg:col-span-6 bg-white dark:bg-surface p-4 sm:p-5 flex flex-col justify-between">
      <!-- Chat Header -->
      <div
        class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800/80 mb-4"
      >
        <div class="flex items-center gap-2.5 min-w-0">
          <div
            class="w-8 h-8 rounded-full bg-primary/20 text-primary font-bold flex items-center justify-center text-xs shrink-0"
          >
            WK
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate">
                Wanjiku Kamau
              </h4>
              <span
                class="inline-flex items-center gap-0.5 text-[10px] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold px-1.5 py-0.2 rounded"
              >
                <Icon name="simple-icons:whatsapp" class="w-2.5 h-2.5" /> WhatsApp
              </span>
            </div>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono">
              +254 712 345 678 &bull; Assigned to Brian O.
            </span>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <span
            class="hidden sm:inline-flex items-center gap-1 text-[10px] text-amber-600 dark:text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded font-medium"
          >
            <Icon name="lucide:users" class="w-3 h-3" /> Brian &amp; Sarah viewing
          </span>
        </div>
      </div>

      <!-- Chat Messages Scroll Area -->
      <div class="space-y-3.5 text-xs">
        <!-- Customer Message -->
        <div class="flex flex-col items-start max-w-[85%]">
          <div
            class="p-3 rounded-xl rounded-tl-xs bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 shadow-none"
          >
            <p>
              Hi, I want to order the Kenyan Leather Weekender Bag (Tan). Can you deliver to
              Westlands today?
            </p>
          </div>
          <span class="text-[10px] text-slate-400 mt-1 pl-1">10:11 AM &bull; Customer</span>
        </div>

        <!-- Markcopilot Grounded AI Suggestion Pill -->
        <div
          class="p-2.5 rounded-xl bg-indigo-50/80 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800/60 text-slate-800 dark:text-slate-200"
        >
          <div class="flex items-center justify-between text-[11px] mb-1">
            <span class="font-bold text-indigo-600 dark:text-indigo-400 flex items-center gap-1">
              <Icon name="lucide:sparkles" class="w-3.5 h-3.5" /> Markcopilot Grounded Suggestion
            </span>
            <span
              class="text-[9px] font-mono bg-indigo-200/50 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 px-1.5 py-0.2 rounded font-medium"
            >
              Catalog grounded
            </span>
          </div>
          <p class="text-[11px] text-slate-600 dark:text-slate-300">
            Stock verified (4 units in Tan at CBD hub). Same-day Westlands delivery cutoff is 2:00
            PM (Fee KES 250).
          </p>
        </div>

        <!-- Agent Response -->
        <div class="flex flex-col items-end self-end max-w-[85%] ml-auto">
          <div class="p-3 rounded-xl rounded-tr-xs bg-primary text-white shadow-none">
            <p>
              Hello Wanjiku! Yes, we have 4 units in Tan ready at our hub. We can dispatch via rider
              for arrival by 3:30 PM. Total with delivery is KES 3,500.
            </p>
          </div>
          <span class="text-[10px] text-slate-400 mt-1 pr-1">10:12 AM &bull; Brian O.</span>
        </div>

        <!-- Agent In-Chat /stk Command -->
        <div class="flex flex-col items-end self-end max-w-[85%] ml-auto">
          <div
            class="p-2 px-3 rounded-xl bg-slate-900 text-emerald-400 font-mono text-[11px] border border-slate-800 shadow-none flex items-center gap-2"
          >
            <span class="text-slate-500">$</span>
            <span>/stk 3500 0712345678</span>
          </div>
          <span class="text-[10px] text-slate-400 mt-1 pr-1">10:13 AM &bull; STK Trigger</span>
        </div>

        <!-- Verified In-Chat Transaction Card -->
        <div
          class="w-full p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-slate-800 dark:text-slate-200 space-y-2"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5 font-bold text-emerald-700 dark:text-emerald-400">
              <Icon name="lucide:check-circle" class="w-4 h-4 text-emerald-500" />
              <span>M-Pesa STK Push Completed</span>
            </div>
            <span class="font-mono font-bold text-xs text-emerald-700 dark:text-emerald-400">
              KES 3,500.00
            </span>
          </div>
          <div
            class="grid grid-cols-2 gap-2 text-[10px] font-mono pt-1 border-t border-emerald-500/20 text-slate-600 dark:text-slate-300"
          >
            <div>
              <span class="text-slate-400 block">Safaricom TransID:</span>
              <span class="font-bold text-slate-900 dark:text-white">QKH78219LM</span>
            </div>
            <div>
              <span class="text-slate-400 block">Callback Status:</span>
              <span class="font-bold text-emerald-600 dark:text-emerald-400"
                >ResultCode 0 (Verified)</span
              >
            </div>
          </div>
          <div
            class="text-[10px] text-emerald-800 dark:text-emerald-300/90 bg-emerald-500/15 p-1.5 rounded-lg flex items-center gap-1.5 font-sans"
          >
            <Icon name="lucide:shield-check" class="w-3.5 h-3.5 text-emerald-500 shrink-0" />
            <span
              >Digital receipt dispatched automatically via WhatsApp template. Order marked paid.</span
            >
          </div>
        </div>
      </div>

      <!-- Chat Composer Box -->
      <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800">
        <div
          class="flex items-center gap-1.5 mb-2 overflow-x-auto text-[10px] font-mono text-slate-500 dark:text-slate-400"
        >
          <span
            class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 hover:text-primary cursor-pointer"
            >/stk &lt;amount&gt;</span
          >
          <span
            class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 hover:text-primary cursor-pointer"
            >/note &lt;internal&gt;</span
          >
          <span
            class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 hover:text-primary cursor-pointer"
            >/template</span
          >
          <span
            class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 hover:text-primary cursor-pointer"
            >/assign</span
          >
        </div>
        <div
          class="flex items-center gap-2 p-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60"
        >
          <input
            type="text"
            readonly
            value="Receipt confirmed. Rider Kiprono dispatched on motor 0798..."
            class="w-full bg-transparent text-xs text-slate-700 dark:text-slate-200 outline-none px-2"
          />
          <button
            type="button"
            class="p-1.5 rounded-lg bg-primary text-white shrink-0 hover:brightness-110"
          >
            <Icon name="lucide:send" class="w-3.5 h-3.5" />
          </button>
        </div>
      </div>
    </div>

    <!-- PANE 3: Customer 360 Context Drawer (3 cols on lg) -->
    <div
      class="lg:col-span-3 bg-slate-50/60 dark:bg-slate-950/40 p-3 sm:p-4 flex flex-col justify-between"
    >
      <div class="space-y-4">
        <!-- Customer Profile Card -->
        <div class="text-center pb-3 border-b border-slate-200 dark:border-slate-800">
          <div
            class="w-12 h-12 rounded-full bg-surface   text-white font-bold text-sm mx-auto flex items-center justify-center shadow-none mb-2"
          >
            WK
          </div>
          <h5 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Wanjiku Kamau</h5>
          <span
            class="inline-block text-[10px] bg-primary/10 text-primary font-bold px-2 py-0.5 rounded-full mt-1"
          >
            VIP Retail Client
          </span>
          <p class="text-[11px] text-slate-500 font-mono mt-1">+254 712 345 678</p>
        </div>

        <!-- 360 Stats Grid -->
        <div class="grid grid-cols-2 gap-2 text-center">
          <div
            class="p-2 rounded-xl bg-white dark:bg-surface border border-slate-200/80 dark:border-slate-800"
          >
            <span class="text-[10px] text-slate-400 block font-medium">Lifetime Spend</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white font-mono"
              >KES 24,800</span
            >
          </div>
          <div
            class="p-2 rounded-xl bg-white dark:bg-surface border border-slate-200/80 dark:border-slate-800"
          >
            <span class="text-[10px] text-slate-400 block font-medium">Total Orders</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white font-mono"
              >5 Delivered</span
            >
          </div>
        </div>

        <!-- Custom CRM Attributes -->
        <div class="space-y-2">
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">
            Customer Attributes
          </span>
          <div
            class="text-[11px] space-y-1.5 bg-white dark:bg-surface p-2.5 rounded-xl border border-slate-200/80 dark:border-slate-800"
          >
            <div class="flex justify-between">
              <span class="text-slate-400">City / Zone:</span>
              <span class="font-medium text-slate-800 dark:text-slate-200">Westlands, Nairobi</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Payment Preference:</span>
              <span class="font-medium text-emerald-600 dark:text-emerald-400">M-Pesa STK</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Preferred Channel:</span>
              <span class="font-medium text-slate-800 dark:text-slate-200">WhatsApp</span>
            </div>
          </div>
        </div>

        <!-- Verified Transaction Ledger -->
        <div class="space-y-1.5">
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">
            Verified M-Pesa Ledger
          </span>
          <div class="space-y-1 text-[10px] font-mono">
            <div
              class="p-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex justify-between items-center text-slate-700 dark:text-slate-300"
            >
              <span>Today &bull; QKH78219LM</span>
              <span class="font-bold text-emerald-600 dark:text-emerald-400">KES 3,500</span>
            </div>
            <div
              class="p-1.5 rounded-lg bg-white dark:bg-surface border border-slate-200 dark:border-slate-800 flex justify-between items-center text-slate-600 dark:text-slate-400"
            >
              <span>14 Oct &bull; QJB49102NK</span>
              <span class="font-bold">KES 7,200</span>
            </div>
            <div
              class="p-1.5 rounded-lg bg-white dark:bg-surface border border-slate-200 dark:border-slate-800 flex justify-between items-center text-slate-600 dark:text-slate-400"
            >
              <span>28 Aug &bull; QGS83910TY</span>
              <span class="font-bold">KES 4,100</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Private Note Input -->
      <div class="pt-3 border-t border-slate-200 dark:border-slate-800">
        <span
          class="text-[10px] text-slate-500 dark:text-slate-400 flex items-center gap-1 font-medium"
        >
          <Icon name="lucide:lock" class="w-3 h-3 text-amber-500" /> Private team note:
        </span>
        <p class="text-[11px] text-slate-600 dark:text-slate-300 mt-1 italic">
          "Prefers afternoon deliveries. Repeat VIP client."
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .workspace-showcase-wrapper {
    box-shadow:
      0 25px 60px -15px rgba(0, 0, 0, 0.15),
      0 0 40px -10px rgba(99, 102, 241, 0.12);
  }
</style>
