---
import MCContainer from '@/components/design-system/MCContainer.astro';
import MCProductTabs from '@/components/design-system/MCProductTabs.astro';
import MCSectionHeading from '@/components/design-system/MCSectionHeading.astro';
import MCWorkflowPreview from '@/components/design-system/MCWorkflowPreview.astro';
import type { ProductWorkflow, CmsProductMediaOverride } from '@/data/product-assets';

interface Props {
  cmsMedia?: Partial<Record<ProductWorkflow, CmsProductMediaOverride | null>>;
}
const { cmsMedia = {} } = Astro.props;
---

<section
  id="platform-workbench"
  aria-label="Explore three MarkChat product workflows"
  class="border-b border-border bg-surface py-12 sm:py-16 lg:py-24"
>
  <MCContainer class="max-w-[1360px]">
    <div class="mb-10 max-w-3xl">
      <MCSectionHeading
        eyebrow="Explore MarkChat"
        title="See the workflows behind better customer conversations"
        description="Explore three connected product experiences designed for Kenyan teams."
      />
    </div>
    <MCProductTabs>
      <MCWorkflowPreview
        slot="inbox"
        workflow="inbox"
        cmsMedia={cmsMedia.inbox}
        description="Manage eligible customer channels, shared context, and team assignments in one place."
      />
      <MCWorkflowPreview
        slot="mpesa"
        workflow="mpesa"
        cmsMedia={cmsMedia.mpesa}
        description="Explore configured Daraja checkout requests and provider-verified payment outcomes."
      />
      <MCWorkflowPreview
        slot="markcopilot"
        workflow="markcopilot"
        cmsMedia={cmsMedia.markcopilot}
        description="Draft contextual replies and let an authorized agent review them before sending."
      />
    </MCProductTabs>
  </MCContainer>
</section>
