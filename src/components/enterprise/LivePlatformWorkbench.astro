---
import MCContainer from '@/components/design-system/MCContainer.astro';
import MCProductTabs from '@/components/design-system/MCProductTabs.astro';
import MCSectionHeading from '@/components/design-system/MCSectionHeading.astro';
import MCStatusBadge from '@/components/design-system/MCStatusBadge.astro';
import MCWorkflowPreview from '@/components/design-system/MCWorkflowPreview.astro';
import type { ProductWorkflow, CmsProductMediaOverride } from '@/data/product-assets';

interface Props {
  cmsMedia?: Partial<Record<ProductWorkflow, CmsProductMediaOverride | null>>;
}

const { cmsMedia = {} } = Astro.props;
---

<section
  id="platform-workbench"
  aria-label="Explore three MarkChat product workflows"
  class="border-b border-border bg-surface py-12 sm:py-16 lg:py-24"
>
  <MCContainer>
    <div class="mb-10 flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
      <MCSectionHeading
        eyebrow="Explore MarkChat"
        title="See your customer workflows in one place"
        description="Three product views for Kenyan teams. Verified images will use synthetic demonstration data."
      />
      <MCStatusBadge status="preview" label="Illustrative demonstrations" />
    </div>
    <MCProductTabs>
      <MCWorkflowPreview
        slot="inbox"
        workflow="inbox"
        cmsMedia={cmsMedia.inbox}
        description="Manage connected conversations in one workspace, with team assignment and customer context."
      />
      <MCWorkflowPreview
        slot="mpesa"
        workflow="mpesa"
        cmsMedia={cmsMedia.mpesa}
        description="Preview an M-Pesa /stk checkout workflow. Live transactions require configured merchant credentials and provider approval."
      />
      <MCWorkflowPreview
        slot="markcopilot"
        workflow="markcopilot"
        cmsMedia={cmsMedia.markcopilot}
        description="Review Markcopilot's AI-assisted replies before an authorized agent chooses to send."
      />
    </MCProductTabs>
  </MCContainer>
</section>
