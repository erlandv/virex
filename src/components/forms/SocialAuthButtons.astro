---
/**
 * SocialAuthButtons - Federated Google Authentication Button with Virex Divider
 *
 * @description
 * Renders a full-width Google OAuth button using native Virex semantic design tokens.
 * Supports both login and register variants with accessible aria-labels and focus rings.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  /** Text to display in the divider */
  dividerText?: string;
  /** Google OAuth URL override */
  googleUrl?: string;
  /** Variant for button styling and label */
  variant?: 'login' | 'register';
}

const {
  dividerText = 'Or continue with',
  googleUrl,
  variant = 'login',
} = Astro.props;

const controlPlaneUrl = (typeof import.meta !== 'undefined' && import.meta.env?.PUBLIC_CONTROL_PLANE_API_URL) || 'http://localhost:5000';
const resolvedGoogleUrl = googleUrl || `${controlPlaneUrl}/api/v1/auth/google/start?mode=${variant}`;
const googleLabel = variant === 'register' ? 'Sign up with Google' : 'Continue with Google';
---

<div class="w-full">
  <!-- Google OAuth button -->
  <a
    href={resolvedGoogleUrl}
    id="google-auth-button"
    class="w-full h-11 flex items-center justify-center gap-3 px-4 rounded-xl border border-border bg-background hover:bg-surface text-text transition-colors text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background cursor-pointer shadow-xs"
    aria-label={googleLabel}
  >
    <Icon name="simple-icons:google" class="w-4 h-4 shrink-0 text-[#4285F4]" aria-hidden="true" />
    <span>{googleLabel}</span>
  </a>

  <!-- Divider -->
  <div class="relative my-6" aria-hidden="true">
    <div class="absolute inset-0 flex items-center">
      <div class="w-full border-t border-border"></div>
    </div>
    <div class="relative flex justify-center text-xs uppercase tracking-wider">
      <span class="px-3 bg-surface text-text-muted font-medium">{dividerText}</span>
    </div>
  </div>
</div>

<script>
  // Progressive enhancement: forward safe redirect and selected plan into Google OAuth start URL
  const googleBtn = document.getElementById('google-auth-button') as HTMLAnchorElement | null;
  if (googleBtn) {
    googleBtn.addEventListener('click', () => {
      try {
        const url = new URL(googleBtn.href, window.location.origin);
        const searchParams = new URLSearchParams(window.location.search);
        const redirectParam = searchParams.get('redirect');
        if (redirectParam && /^\/(?![/\\])/.test(redirectParam) && !redirectParam.includes(':')) {
          url.searchParams.set('redirect', redirectParam);
        }
        const planInput = document.getElementById('planId') as HTMLInputElement | null;
        if (planInput && planInput.value) {
          url.searchParams.set('plan', planInput.value.trim().toLowerCase());
        }
        googleBtn.href = url.toString();
      } catch {
        // Safe fallback; preserve default href
      }
    });
  }
</script>
