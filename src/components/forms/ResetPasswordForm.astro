---
/**
 * ResetPasswordForm - Set new password form
 *
 * Implemented using native Virex semantic design tokens and layout conventions.
 * Implements NIST SP 800-63B password guidance (entropy evaluation, dictionary rejection,
 * immediate reset-token stripping from URL bar to prevent browser history or Referer leakage),
 * WCAG 2.2 AA accessibility, open-redirect defense, and zero premature errors on load.
 */

interface Props {
  action?: string;
  method?: 'POST' | 'GET';
  token?: string;
}

const { action = '', method = 'POST', token = '' } = Astro.props;
const controlPlaneUrl =
  import.meta.env.PUBLIC_CONTROL_PLANE_URL ||
  import.meta.env.PUBLIC_CONTROL_PLANE_API_URL ||
  'http://localhost:5000';
---

<form
  id="reset-password-form"
  action={action}
  method={method}
  class="space-y-4"
  data-api-url={controlPlaneUrl}
  novalidate
>
  <!-- Honeypot field for anti-bot defense -->
  <div class="hidden" aria-hidden="true">
    <label>
      Leave this field empty:
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <!-- Token field (hidden) -->
  <input type="hidden" id="reset-token" name="token" value={token} />

  <!-- Missing token notice (if user navigates directly without token) -->
  <div
    id="missing-token-banner"
    class="hidden p-4 rounded-lg bg-warning-bg border border-warning text-warning text-sm"
    role="alert"
  >
    <div class="flex items-start gap-3">
      <svg
        class="w-5 h-5 text-warning shrink-0 mt-0.5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
        ></path>
      </svg>
      <div>
        <p class="font-semibold text-text">Missing reset token</p>
        <p class="text-xs text-text-muted mt-1">
          No recovery token was found in the link. Please request a fresh password recovery link.
        </p>
        <div class="mt-2.5">
          <a
            href="/forgot-password"
            class="text-xs font-semibold text-primary hover:text-primary-dark underline"
          >
            Request recovery link &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- New Password field -->
  <div>
    <label for="new-password" class="block text-sm font-medium text-text mb-1.5">
      New password <span class="text-error" aria-hidden="true">*</span>
    </label>
    <div class="relative">
      <input
        type="password"
        id="new-password"
        name="password"
        required
        minlength="8"
        autocomplete="new-password"
        class="w-full h-11 px-4 pr-11 rounded-xl border border-border bg-background text-text placeholder:text-text-muted/60 focus:outline-none focus-visible:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 focus-visible:ring-2 focus-visible:ring-primary transition-colors text-sm shadow-xs"
        placeholder="••••••••••••"
        aria-describedby="new-password-hint new-password-error"
        aria-invalid="false"
      />
      <button
        type="button"
        id="toggle-new-password"
        class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-text-muted hover:text-text cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded my-1.5 mr-1"
        aria-label="Show password"
        aria-pressed="false"
      >
        <svg
          id="eye-icon-new"
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Password strength meter (NIST SP 800-63B) -->
    <div class="mt-2 space-y-1.5 hidden" id="password-strength-container" aria-live="polite">
      <div class="flex items-center justify-between text-xs">
        <span class="text-text-muted">Password strength:</span>
        <span id="password-strength-label" class="font-medium text-text">Enter password</span>
      </div>
      <div class="grid grid-cols-3 gap-1.5 h-1 w-full bg-border rounded-full overflow-hidden">
        <div id="strength-bar-1" class="h-full rounded-full bg-border transition-colors"></div>
        <div id="strength-bar-2" class="h-full rounded-full bg-border transition-colors"></div>
        <div id="strength-bar-3" class="h-full rounded-full bg-border transition-colors"></div>
      </div>
    </div>
    <p id="new-password-hint" class="mt-1 text-xs text-text-muted">
      Min 8 characters (10+ recommended). Avoid common words or easily guessed phrases.
    </p>
    <p
      id="new-password-error"
      class="mt-1 text-xs text-error hidden"
      data-error="new-password"
      role="alert"
    >
    </p>
  </div>

  <!-- Confirm Password field -->
  <div>
    <label for="confirm-password" class="block text-sm font-medium text-text mb-1.5">
      Confirm new password <span class="text-error" aria-hidden="true">*</span>
    </label>
    <div class="relative">
      <input
        type="password"
        id="confirm-password"
        name="confirmPassword"
        required
        minlength="8"
        autocomplete="new-password"
        class="w-full h-11 px-4 pr-11 rounded-xl border border-border bg-background text-text placeholder:text-text-muted/60 focus:outline-none focus-visible:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 focus-visible:ring-2 focus-visible:ring-primary transition-colors text-sm shadow-xs"
        placeholder="••••••••••••"
        aria-describedby="confirm-password-error"
        aria-invalid="false"
      />
      <button
        type="button"
        id="toggle-confirm-password"
        class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-text-muted hover:text-text cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded my-1.5 mr-1"
        aria-label="Show password confirmation"
        aria-pressed="false"
      >
        <svg
          id="eye-icon-confirm"
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
          ></path>
        </svg>
      </button>
    </div>
    <p
      id="confirm-password-error"
      class="mt-1 text-xs text-error hidden"
      data-error="confirm-password"
      role="alert"
    >
    </p>
  </div>

  <!-- Form status messages -->
  <div id="reset-form-status" class="hidden" role="alert" aria-live="polite">
    <div
      id="reset-form-success"
      class="hidden p-3.5 rounded-lg bg-success-bg border border-success text-success text-sm"
    >
      <div class="flex items-start gap-3">
        <svg
          class="w-5 h-5 text-success shrink-0 mt-0.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"
          ></path>
        </svg>
        <div>
          <p class="font-semibold text-text">Password reset successfully!</p>
          <p class="text-xs text-text-muted mt-0.5">
            Your password has been updated. Redirecting you to sign in...
          </p>
        </div>
      </div>
    </div>
    <div
      id="reset-form-error"
      class="hidden p-3.5 rounded-lg bg-error-bg border border-error text-error text-sm"
    >
      <div class="flex items-start gap-3">
        <svg
          class="w-5 h-5 text-error shrink-0 mt-0.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          ></path>
        </svg>
        <div class="flex-1">
          <p class="font-semibold text-text">Password Reset Failed</p>
          <p id="reset-error-text" class="text-xs text-text-muted mt-0.5 leading-relaxed">
            The reset token is invalid or has expired. Please request a new link.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Submit button -->
  <button
    type="submit"
    id="reset-submit-button"
    class="w-full h-11 cursor-pointer px-6 rounded-xl bg-primary hover:bg-primary-dark text-white font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:opacity-50 disabled:cursor-not-allowed shadow-xs flex items-center justify-center"
  >
    <span id="reset-button-text">Update Password</span>
    <span id="reset-button-loading" class="hidden items-center gap-2">
      <svg
        class="animate-spin w-4 h-4 text-white"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
        ></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
      <span>Updating password...</span>
    </span>
  </button>

  <p class="text-center text-xs text-text-muted pt-2">
    Remember your password?{' '}
    <a href="/login" class="font-medium text-primary hover:text-primary-dark hover:underline"
      >Back to sign in &rarr;</a
    >
  </p>
</form>

<script>
  const form = document.getElementById('reset-password-form') as HTMLFormElement;
  const newPasswordInput = document.getElementById('new-password') as HTMLInputElement;
  const confirmPasswordInput = document.getElementById('confirm-password') as HTMLInputElement;
  const toggleBtn = document.getElementById('toggle-new-password') as HTMLButtonElement;
  const toggleConfirmBtn = document.getElementById('toggle-confirm-password') as HTMLButtonElement;
  const tokenInput = document.getElementById('reset-token') as HTMLInputElement;
  const submitBtn = document.getElementById('reset-submit-button') as HTMLButtonElement;
  const btnText = document.getElementById('reset-button-text');
  const btnLoading = document.getElementById('reset-button-loading');
  const statusContainer = document.getElementById('reset-form-status');
  const successContainer = document.getElementById('reset-form-success');
  const errorContainer = document.getElementById('reset-form-error');
  const resetErrorText = document.getElementById('reset-error-text');
  const missingTokenBanner = document.getElementById('missing-token-banner');

  const strengthContainer = document.getElementById('password-strength-container');
  const strengthBar1 = document.getElementById('strength-bar-1');
  const strengthBar2 = document.getElementById('strength-bar-2');
  const strengthBar3 = document.getElementById('strength-bar-3');
  const strengthLabel = document.getElementById('password-strength-label');

  // Track touched fields to strictly prevent premature errors on initial load
  const touchedFields = new Set<string>();

  // NIST SP 800-63B: Consume URL token and strip from browser URL bar immediately
  if (typeof window !== 'undefined') {
    const params = new URLSearchParams(window.location.search);
    const urlToken = params.get('token');
    if (urlToken) {
      if (tokenInput) tokenInput.value = urlToken;
      // Strip token parameter from URL bar without triggering a reload
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, document.title, cleanUrl);
    }

    if (tokenInput && !tokenInput.value && missingTokenBanner) {
      missingTokenBanner.classList.remove('hidden');
    }
  }

  // Password visibility toggle helpers
  const eyeOpenSvg = `
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
  `;
  const eyeClosedSvg = `
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
  `;

  if (toggleBtn && newPasswordInput) {
    toggleBtn.addEventListener('click', () => {
      const isPassword = newPasswordInput.type === 'password';
      newPasswordInput.type = isPassword ? 'text' : 'password';
      toggleBtn.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
      toggleBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
      const eyeIcon = document.getElementById('eye-icon-new');
      if (eyeIcon) eyeIcon.innerHTML = isPassword ? eyeClosedSvg : eyeOpenSvg;
    });
  }

  if (toggleConfirmBtn && confirmPasswordInput) {
    toggleConfirmBtn.addEventListener('click', () => {
      const isPassword = confirmPasswordInput.type === 'password';
      confirmPasswordInput.type = isPassword ? 'text' : 'password';
      toggleConfirmBtn.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
      toggleConfirmBtn.setAttribute(
        'aria-label',
        isPassword ? 'Hide password confirmation' : 'Show password confirmation'
      );
      const eyeIcon = document.getElementById('eye-icon-confirm');
      if (eyeIcon) eyeIcon.innerHTML = isPassword ? eyeClosedSvg : eyeOpenSvg;
    });
  }

  // NIST SP 800-63B Password Hygiene & Strength Evaluation
  const COMMON_PASSWORDS = new Set([
    'password',
    'password123',
    'admin',
    'administrator',
    'markchat',
    '1234567890',
    '12345678',
    'qwerty1234',
    'welcome123',
    'letmein123',
    'kenya12345',
    'nairobi123',
  ]);

  function evaluateStrength(value: string): 'empty' | 'weak' | 'fair' | 'strong' {
    if (!value) return 'empty';
    if (value.length < 8 || COMMON_PASSWORDS.has(value.toLowerCase())) return 'weak';

    let score = 0;
    if (value.length >= 10) score += 1;
    if (value.length >= 14) score += 1;
    if (/[A-Z]/.test(value) && /[a-z]/.test(value)) score += 1;
    if (/\d/.test(value)) score += 1;
    if (/[^A-Za-z0-9]/.test(value)) score += 1;

    if (score >= 4) return 'strong';
    if (score >= 2) return 'fair';
    return 'weak';
  }

  function updateStrengthMeter(val: string) {
    if (!strengthContainer) return;
    const strength = evaluateStrength(val);
    if (strength === 'empty') {
      strengthContainer.classList.add('hidden');
      return;
    }
    strengthContainer.classList.remove('hidden');

    if (!strengthLabel || !strengthBar1 || !strengthBar2 || !strengthBar3) return;

    if (strength === 'strong') {
      strengthLabel.textContent = 'Strong';
      strengthLabel.className = 'font-medium text-success';
      strengthBar1.className = 'h-full rounded-full bg-success';
      strengthBar2.className = 'h-full rounded-full bg-success';
      strengthBar3.className = 'h-full rounded-full bg-success';
    } else if (strength === 'fair') {
      strengthLabel.textContent = 'Fair';
      strengthLabel.className = 'font-medium text-warning';
      strengthBar1.className = 'h-full rounded-full bg-warning';
      strengthBar2.className = 'h-full rounded-full bg-warning';
      strengthBar3.className = 'h-full rounded-full bg-border';
    } else {
      strengthLabel.textContent = 'Weak';
      strengthLabel.className = 'font-medium text-error';
      strengthBar1.className = 'h-full rounded-full bg-error';
      strengthBar2.className = 'h-full rounded-full bg-border';
      strengthBar3.className = 'h-full rounded-full bg-border';
    }
  }

  function showError(fieldId: string, message: string) {
    const errEl = document.querySelector(`[data-error="${fieldId}"]`);
    const inputEl = document.getElementById(fieldId);
    if (errEl) {
      errEl.textContent = message;
      errEl.classList.remove('hidden');
      if (inputEl) {
        inputEl.classList.add('border-error', 'focus:border-error', 'focus:ring-error/20');
        inputEl.setAttribute('aria-invalid', 'true');
      }
    }
  }

  function hideError(fieldId: string) {
    const errEl = document.querySelector(`[data-error="${fieldId}"]`);
    const inputEl = document.getElementById(fieldId);
    if (errEl) {
      errEl.classList.add('hidden');
      if (inputEl) {
        inputEl.classList.remove('border-error', 'focus:border-error', 'focus:ring-error/20');
        inputEl.setAttribute('aria-invalid', 'false');
      }
    }
  }

  function validateNewPassword(force: boolean = false): boolean {
    if (!force && !touchedFields.has('new-password')) return true;
    const pass = newPasswordInput?.value || '';
    if (!pass) {
      showError('new-password', 'New password is required');
      return false;
    }
    if (pass.length < 8) {
      showError('new-password', 'Password must be at least 8 characters');
      return false;
    }
    if (COMMON_PASSWORDS.has(pass.toLowerCase())) {
      showError(
        'new-password',
        'This password is too common and easily guessed. Please choose a more unique phrase.'
      );
      return false;
    }
    hideError('new-password');
    return true;
  }

  function validateConfirmPassword(force: boolean = false): boolean {
    if (!force && !touchedFields.has('confirm-password')) return true;
    const pass = newPasswordInput?.value || '';
    const confirm = confirmPasswordInput?.value || '';
    if (!confirm) {
      showError('confirm-password', 'Please confirm your new password');
      return false;
    }
    if (pass !== confirm) {
      showError('confirm-password', 'Passwords do not match');
      return false;
    }
    hideError('confirm-password');
    return true;
  }

  newPasswordInput?.addEventListener('input', () => {
    updateStrengthMeter(newPasswordInput.value);
    const errEl = document.querySelector('[data-error="new-password"]');
    if (errEl && !errEl.classList.contains('hidden')) {
      validateNewPassword(true);
    }
    if (confirmPasswordInput?.value && touchedFields.has('confirm-password')) {
      validateConfirmPassword(true);
    }
  });
  newPasswordInput?.addEventListener('blur', () => {
    touchedFields.add('new-password');
    validateNewPassword(true);
  });

  confirmPasswordInput?.addEventListener('input', () => {
    const errEl = document.querySelector('[data-error="confirm-password"]');
    if (errEl && !errEl.classList.contains('hidden')) {
      validateConfirmPassword(true);
    }
  });
  confirmPasswordInput?.addEventListener('blur', () => {
    touchedFields.add('confirm-password');
    validateConfirmPassword(true);
  });

  // Safe redirect helper (CWE-601 open-redirect defense)
  function getSafeRedirect(targetUrl: string, fallback = '/login?reset=success'): string {
    if (!targetUrl) return fallback;
    if (/^\/(?![/\\])/.test(targetUrl) && !/[\\\\\u0000-\u001f:]/.test(targetUrl) && !/%(?:0[0-9a-f]|5c)/i.test(targetUrl)) {
      return targetUrl;
    }
    return fallback;
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      statusContainer?.classList.add('hidden');
      successContainer?.classList.add('hidden');
      errorContainer?.classList.add('hidden');

      const gotcha = (form.querySelector('input[name="_gotcha"]') as HTMLInputElement)?.value;
      if (gotcha) return;

      touchedFields.add('new-password');
      touchedFields.add('confirm-password');

      const p1 = validateNewPassword(true);
      const p2 = validateConfirmPassword(true);
      if (!p1 || !p2) {
        if (!p1) newPasswordInput?.focus();
        else confirmPasswordInput?.focus();
        return;
      }

      const token = tokenInput?.value?.trim();
      if (!token) {
        statusContainer?.classList.remove('hidden');
        errorContainer?.classList.remove('hidden');
        if (resetErrorText) {
          resetErrorText.textContent =
            'Recovery token is missing. Please request a new link from the forgot password page.';
        }
        return;
      }

      submitBtn.disabled = true;
      form.setAttribute('aria-busy', 'true');
      btnText?.classList.add('hidden');
      btnLoading?.classList.remove('hidden');
      btnLoading?.classList.add('inline-flex');

      const password = newPasswordInput?.value;
      const apiUrl = form.dataset.apiUrl || 'http://localhost:5000';

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 15000);

      try {
        const response = await fetch(`${apiUrl}/api/v1/auth/reset-password`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({ token, password }),
          signal: controller.signal,
        });

        clearTimeout(timeoutId);

        if (response.status === 429) {
          const retryAfter = response.headers.get('Retry-After') || '60';
          showErrorMessage(
            `Too many attempts. Please wait ${retryAfter} seconds before trying again.`
          );
          return;
        }

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          const message =
            typeof errData.message === 'string' && !errData.message.includes('stack')
              ? errData.message
              : 'The reset token is invalid or has expired. Please request a new link.';
          showErrorMessage(message);
          return;
        }

        statusContainer?.classList.remove('hidden');
        successContainer?.classList.remove('hidden');
        form.reset();

        setTimeout(() => {
          window.location.href = getSafeRedirect('/login?reset=success');
        }, 1500);
      } catch (err: unknown) {
        clearTimeout(timeoutId);
        if (err instanceof Error && err.name === 'AbortError') {
          showErrorMessage('The request timed out. Please check your network and try again.');
          return;
        }
        showErrorMessage(
          'Unable to connect to the recovery service. Please check your connection and try again.'
        );
      }
    });
  }

  function showErrorMessage(message: string) {
    statusContainer?.classList.remove('hidden');
    errorContainer?.classList.remove('hidden');
    if (resetErrorText) resetErrorText.textContent = message;
    submitBtn.disabled = false;
    form.removeAttribute('aria-busy');
    btnText?.classList.remove('hidden');
    btnLoading?.classList.add('hidden');
    btnLoading?.classList.remove('inline-flex');
  }
</script>
