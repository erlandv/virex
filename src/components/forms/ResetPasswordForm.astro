---
/**
 * ResetPasswordForm - Set new password form (Direction A + D)
 *
 * Consumes server-issued password reset token from query params or prop,
 * verifies password strength and matching confirmation, and submits securely.
 */

interface Props {
  action?: string;
  method?: 'POST' | 'GET';
  token?: string;
}

const { action = '', method = 'POST', token = '' } = Astro.props;
const controlPlaneUrl = (typeof import.meta !== 'undefined' && import.meta.env?.PUBLIC_CONTROL_PLANE_API_URL) || 'http://localhost:5000';
---

<form
  id="reset-password-form"
  action={action}
  method={method}
  class="space-y-5"
  data-api-url={controlPlaneUrl}
  novalidate
>
  <!-- Honeypot field for anti-bot spam defense -->
  <div class="hidden" aria-hidden="true">
    <label>
      Don't fill this out if you're human:
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <!-- Token field (hidden) -->
  <input type="hidden" id="reset-token" name="token" value={token} />

  <!-- New Password field -->
  <div>
    <label for="new-password" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
      New Password <span class="text-red-500">*</span>
    </label>
    <div class="relative">
      <input
        type="password"
        id="new-password"
        name="password"
        required
        minlength="8"
        autocomplete="new-password"
        class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/80 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors text-sm pr-11 shadow-2xs"
        placeholder="••••••••"
      />
      <button
        type="button"
        id="toggle-new-password"
        class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer"
        aria-label="Toggle password visibility"
      >
        <svg id="eye-icon-new" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
      </button>
    </div>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Must be at least 8 characters</p>
    <p class="mt-1 text-xs text-red-500 hidden" data-error="new-password"></p>
  </div>

  <!-- Confirm Password field -->
  <div>
    <label for="confirm-password" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
      Confirm New Password <span class="text-red-500">*</span>
    </label>
    <input
      type="password"
      id="confirm-password"
      name="confirmPassword"
      required
      minlength="8"
      autocomplete="new-password"
      class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/80 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors text-sm shadow-2xs"
      placeholder="••••••••"
    />
    <p class="mt-1 text-xs text-red-500 hidden" data-error="confirm-password"></p>
  </div>

  <!-- Form status messages -->
  <div id="reset-form-status" class="hidden">
    <div
      id="reset-form-success"
      class="hidden p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 text-sm"
    >
      <p class="font-bold flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        Password reset successfully!
      </p>
      <p class="text-xs text-emerald-700 dark:text-emerald-300 mt-1">
        Redirecting you to login...
      </p>
    </div>
    <div
      id="reset-form-error"
      class="hidden p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-200 text-sm"
    >
      <p class="font-bold flex items-center gap-2">
        <svg class="w-4 h-4 text-rose-600 dark:text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        Password Reset Failed
      </p>
      <p id="reset-error-text" class="text-xs text-rose-700 dark:text-rose-300 mt-1">
        The reset token is invalid or has expired. Please request a new link.
      </p>
    </div>
  </div>

  <!-- Submit button -->
  <button
    type="submit"
    id="reset-submit-button"
    class="w-full cursor-pointer px-6 py-3.5 rounded-xl bg-primary text-white font-semibold hover:bg-blue-600 transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background disabled:opacity-50 disabled:cursor-not-allowed text-sm shadow-md shadow-primary/25"
  >
    <span id="reset-button-text">Update Password</span>
    <span id="reset-button-loading" class="hidden">
      <svg class="animate-spin inline-block w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Updating password...
    </span>
  </button>

  <p class="text-center text-xs text-slate-500 dark:text-slate-400 pt-2">
    Remember your password?{' '}
    <a href="/login" class="text-primary font-semibold hover:underline">Back to sign in &rarr;</a>
  </p>
</form>

<script>
  const form = document.getElementById('reset-password-form') as HTMLFormElement;
  const newPasswordInput = document.getElementById('new-password') as HTMLInputElement;
  const confirmPasswordInput = document.getElementById('confirm-password') as HTMLInputElement;
  const toggleBtn = document.getElementById('toggle-new-password');
  const tokenInput = document.getElementById('reset-token') as HTMLInputElement;
  const submitBtn = document.getElementById('reset-submit-button') as HTMLButtonElement;
  const btnText = document.getElementById('reset-button-text');
  const btnLoading = document.getElementById('reset-button-loading');
  const statusContainer = document.getElementById('reset-form-status');
  const successContainer = document.getElementById('reset-form-success');
  const errorContainer = document.getElementById('reset-form-error');

  // Check URL token if not present
  if (tokenInput && !tokenInput.value) {
    const params = new URLSearchParams(window.location.search);
    const urlToken = params.get('token');
    if (urlToken) tokenInput.value = urlToken;
  }

  // Password visibility toggle
  if (toggleBtn && newPasswordInput) {
    toggleBtn.addEventListener('click', () => {
      const isPassword = newPasswordInput.type === 'password';
      newPasswordInput.type = isPassword ? 'text' : 'password';
      if (confirmPasswordInput) {
        confirmPasswordInput.type = isPassword ? 'text' : 'password';
      }
    });
  }

  function showError(fieldId: string, message: string) {
    const errEl = document.querySelector(`[data-error="${fieldId}"]`);
    const inputEl = document.getElementById(fieldId);
    if (errEl) {
      errEl.textContent = message;
      errEl.classList.remove('hidden');
      if (inputEl) inputEl.classList.add('border-red-500');
    }
  }

  function hideError(fieldId: string) {
    const errEl = document.querySelector(`[data-error="${fieldId}"]`);
    const inputEl = document.getElementById(fieldId);
    if (errEl) {
      errEl.classList.add('hidden');
      if (inputEl) inputEl.classList.remove('border-red-500');
    }
  }

  function validateNewPassword(): boolean {
    const pass = newPasswordInput?.value || '';
    if (!pass) {
      showError('new-password', 'New password is required');
      return false;
    }
    if (pass.length < 8) {
      showError('new-password', 'Password must be at least 8 characters');
      return false;
    }
    hideError('new-password');
    return true;
  }

  function validateConfirmPassword(): boolean {
    const pass = newPasswordInput?.value || '';
    const confirm = confirmPasswordInput?.value || '';
    if (!confirm) {
      showError('confirm-password', 'Please confirm your new password');
      return false;
    }
    if (pass !== confirm) {
      showError('confirm-password', 'Passwords do not match');
      return false;
    }
    hideError('confirm-password');
    return true;
  }

  newPasswordInput?.addEventListener('blur', validateNewPassword);
  newPasswordInput?.addEventListener('input', () => {
    hideError('new-password');
    if (confirmPasswordInput?.value) validateConfirmPassword();
  });

  confirmPasswordInput?.addEventListener('blur', validateConfirmPassword);
  confirmPasswordInput?.addEventListener('input', () => hideError('confirm-password'));

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      statusContainer?.classList.add('hidden');
      successContainer?.classList.add('hidden');
      errorContainer?.classList.add('hidden');

      const gotcha = (form.querySelector('input[name="_gotcha"]') as HTMLInputElement)?.value;
      if (gotcha) return;

      const p1 = validateNewPassword();
      const p2 = validateConfirmPassword();
      if (!p1 || !p2) {
        if (!p1) newPasswordInput?.focus();
        else confirmPasswordInput?.focus();
        return;
      }

      submitBtn.disabled = true;
      btnText?.classList.add('hidden');
      btnLoading?.classList.remove('hidden');

      const token = tokenInput?.value;
      const password = newPasswordInput?.value;
      const apiUrl = form.dataset.apiUrl || 'http://localhost:5000';

      try {
        const response = await fetch(`${apiUrl}/api/v1/auth/reset-password`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({ token, password }),
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          statusContainer?.classList.remove('hidden');
          errorContainer?.classList.remove('hidden');
          const errText = document.getElementById('reset-error-text');
          if (errText) {
            errText.textContent = errData.message || 'The reset token is invalid or has expired. Please request a new link.';
          }
          submitBtn.disabled = false;
          btnText?.classList.remove('hidden');
          btnLoading?.classList.add('hidden');
          return;
        }

        statusContainer?.classList.remove('hidden');
        successContainer?.classList.remove('hidden');
        setTimeout(() => {
          window.location.href = '/login?reset=success';
        }, 1500);
      } catch {
        statusContainer?.classList.remove('hidden');
        errorContainer?.classList.remove('hidden');
        submitBtn.disabled = false;
        btnText?.classList.remove('hidden');
        btnLoading?.classList.add('hidden');
      }
    });
  }
</script>
