<style>
  .mega-menu-panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 180ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 180ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 180ms;
    pointer-events: none;
  }

  .mega-menu-container[data-state='open'] .mega-menu-panel {
    visibility: visible !important;
    opacity: 1 !important;
    transform: translateY(0) !important;
    pointer-events: auto !important;
  }

  .mega-menu-container[data-state='open'] :global(.chevron-icon) {
    transform: rotate(180deg) !important;
  }

  .mega-menu-container[data-state='open'] .mega-menu-trigger {
    color: #0f172a;
  }
  :global(.dark) .mega-menu-container[data-state='open'] .mega-menu-trigger {
    color: #ffffff;
  }
</style>

<script>
  // ---------------------------------------------------------------------------
  // 1. Desktop Mega-Menu Hover & Click Controller (Resilient State Machine)
  // ---------------------------------------------------------------------------
  function initHeaderControllers() {
    const containers = document.querySelectorAll<HTMLElement>('.mega-menu-container');
    if (!containers.length) return;

    let activeMenuId: string | null = null;
    let openedBy: 'hover' | 'click' | null = null;
    let closeTimeout: ReturnType<typeof setTimeout> | null = null;
    let openTimeout: ReturnType<typeof setTimeout> | null = null;

    // Detect touchscreens / coarse pointers to avoid synthetic hover collisions
    const isTouch = () =>
      typeof window !== 'undefined' && window.matchMedia('(pointer: coarse)').matches;

    function openMenu(menuId: string, triggerType: 'hover' | 'click') {
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = null;
      }
      if (openTimeout) {
        clearTimeout(openTimeout);
        openTimeout = null;
      }

      containers.forEach((container) => {
        const id = container.getAttribute('data-menu');
        const trigger = container.querySelector<HTMLButtonElement>('.mega-menu-trigger');
        const panel = container.querySelector<HTMLElement>('.mega-menu-panel');
        const chevron = container.querySelector<HTMLElement>('.chevron-icon');

        if (id === menuId) {
          container.setAttribute('data-state', 'open');
          trigger?.setAttribute('aria-expanded', 'true');
          panel?.classList.remove('invisible', 'opacity-0', 'pointer-events-none', 'translate-y-1');
          panel?.classList.add('visible', 'opacity-100', 'pointer-events-auto', 'translate-y-0');
          chevron?.classList.add('rotate-180');
        } else {
          container.setAttribute('data-state', 'closed');
          trigger?.setAttribute('aria-expanded', 'false');
          panel?.classList.add('invisible', 'opacity-0', 'pointer-events-none', 'translate-y-1');
          panel?.classList.remove('visible', 'opacity-100', 'pointer-events-auto', 'translate-y-0');
          chevron?.classList.remove('rotate-180');
        }
      });

      activeMenuId = menuId;
      openedBy = triggerType;
    }

    function closeAllMenus() {
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = null;
      }
      if (openTimeout) {
        clearTimeout(openTimeout);
        openTimeout = null;
      }

      containers.forEach((container) => {
        const trigger = container.querySelector<HTMLButtonElement>('.mega-menu-trigger');
        const panel = container.querySelector<HTMLElement>('.mega-menu-panel');
        const chevron = container.querySelector<HTMLElement>('.chevron-icon');

        container.setAttribute('data-state', 'closed');
        trigger?.setAttribute('aria-expanded', 'false');
        panel?.classList.add('invisible', 'opacity-0', 'pointer-events-none', 'translate-y-1');
        panel?.classList.remove('visible', 'opacity-100', 'pointer-events-auto', 'translate-y-0');
        chevron?.classList.remove('rotate-180');
      });

      activeMenuId = null;
      openedBy = null;
    }

    function scheduleClose(delay = 180) {
      if (closeTimeout) clearTimeout(closeTimeout);
      closeTimeout = setTimeout(() => {
        closeAllMenus();
      }, delay);
    }

    containers.forEach((container) => {
      const menuId = container.getAttribute('data-menu');
      if (!menuId) return;

      const trigger = container.querySelector<HTMLButtonElement>('.mega-menu-trigger');
      const panel = container.querySelector<HTMLElement>('.mega-menu-panel');

      // Hover Handling (Mouse / fine pointers only)
      container.addEventListener('mouseenter', () => {
        if (isTouch()) return;

        if (closeTimeout) {
          clearTimeout(closeTimeout);
          closeTimeout = null;
        }

        if (activeMenuId === menuId) {
          // Already on this menu, keep open
          return;
        }

        if (activeMenuId !== null) {
          // Rapidly switching between open menus
          openMenu(menuId, 'hover');
        } else {
          // Opening from cold hover: short debounce buffer
          if (openTimeout) clearTimeout(openTimeout);
          openTimeout = setTimeout(() => {
            openMenu(menuId, 'hover');
          }, 100);
        }
      });

      container.addEventListener('mouseleave', () => {
        if (isTouch()) return;

        if (openTimeout) {
          clearTimeout(openTimeout);
          openTimeout = null;
        }

        scheduleClose(200);
      });

      // Click Handling (Universal: Mouse, Touch, & Keyboard activation)
      trigger?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        if (openTimeout) {
          clearTimeout(openTimeout);
          openTimeout = null;
        }
        if (closeTimeout) {
          clearTimeout(closeTimeout);
          closeTimeout = null;
        }

        if (activeMenuId !== menuId) {
          // Menu was closed or a different menu was open -> OPEN and lock with 'click'
          openMenu(menuId, 'click');
        } else {
          // Menu was currently open for this id
          if (openedBy === 'hover') {
            // User hovered and now clicked to lock open
            openedBy = 'click';
          } else {
            // Already opened by click -> TOGGLE CLOSED
            closeAllMenus();
          }
        }
      });

      // Keyboard navigation: Escape closes and focuses trigger
      container.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          e.stopPropagation();
          closeAllMenus();
          trigger?.focus();
        }
      });

      // Close menu when navigating through any child link
      panel?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          closeAllMenus();
        });
      });
    });

    // Global click outside closes any open mega-menu
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && !target.closest('.mega-menu-container')) {
        closeAllMenus();
      }
    });

    // ---------------------------------------------------------------------------
    // 2. Mobile Drawer Controller
    // ---------------------------------------------------------------------------
    const header = document.getElementById('site-header');
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuPanel = document.getElementById('mobile-menu-panel');
    const mobileMenuBackdrop = document.getElementById('mobile-menu-backdrop');
    const menuIconOpen = document.getElementById('menu-icon-open');
    const menuIconClose = document.getElementById('menu-icon-close');

    function updateMenuPosition() {
      if (header && mobileMenuPanel) {
        const headerRect = header.getBoundingClientRect();
        mobileMenuPanel.style.top = `${headerRect.bottom}px`;
      }
    }

    function openMobileMenu() {
      updateMenuPosition();
      mobileMenu?.classList.remove('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'true');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
      mobileMenu?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function toggleMobileMenu() {
      const isExpanded = mobileMenuButton?.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    }

    mobileMenuButton?.addEventListener('click', toggleMobileMenu);
    mobileMenuBackdrop?.addEventListener('click', closeMobileMenu);

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && mobileMenuButton?.getAttribute('aria-expanded') === 'true') {
        closeMobileMenu();
        mobileMenuButton?.focus();
      }
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });
  }

  // Initialize on initial page load and on Astro page-load / View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderControllers);
  } else {
    initHeaderControllers();
  }
  document.addEventListener('astro:page-load', initHeaderControllers);
</script>
