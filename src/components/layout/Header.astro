                      ))
                    }
                  </div>
                </div>

                <!-- Col 3: Ecosystem -->
                <div class="pl-6">
                  <div
                    class="text-[11px] font-bold text-slate-400 dark:text-slate-400 tracking-wider uppercase mb-3"
                  >
                    Ecosystem & Support
                  </div>
                  <div class="space-y-3.5">
                    {
                      resourcesMegaMenu.columns[2]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
