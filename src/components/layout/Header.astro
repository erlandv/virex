---
/**
 * Header.astro - MarkChat Site Header & Responsive Mega-Menus
 *
 * Implements refined 3-column mega-menus for Product, Solutions, and Resources
 * with verified destinations, high-contrast dual-theme styling (light mode and
 * authentic dark navy), viewport-constrained internal scrolling, and resilient
 * keyboard & mouse interaction.
 */
import { siteConfig } from '@/config';
import { Icon } from 'astro-icon/components';
import ThemeToggle from '@ui/ThemeToggle.astro';
import {
  productMegaMenu,
  solutionsMegaMenu,
  resourcesMegaMenu,
  directNavLinks,
  headerCtas,
} from '@/data/navigation';

const ghostCTAs = headerCtas.filter((cta) => cta.variant === 'ghost');
const primaryCTA = headerCtas.find((cta) => cta.variant === 'primary');
---

<header id="site-header" class="sticky top-0 z-50 p-1.5 bg-background border-b border-border">
  <nav class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16">
      <!-- Logo / Site Name -->
      <a href="/" class="flex items-center gap-2 font-semibold text-lg text-text shrink-0">
        {
          siteConfig.logo ? (
            <img src={siteConfig.logo} alt={siteConfig.name} class="h-8 w-auto" />
          ) : (
            siteConfig.name
          )
        }
      </a>

      <!-- Desktop Navigation with 3-Column Mega-Menus -->
      <div class="hidden lg:flex items-center gap-1 xl:gap-2">
        <!-- 1. Product Mega-Menu Trigger & Container -->
        <div
          class="h-16 flex items-center relative mega-menu-container group"
          data-menu="product"
          data-state="closed"
        >
          <button
            type="button"
            class="mega-menu-trigger flex items-center gap-1.5 text-text-muted hover:text-text transition-colors text-sm font-medium rounded-lg px-3 py-2 focus-visible:ring-2 focus-visible:ring-primary focus:outline-none cursor-pointer"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="mega-panel-product"
          >
            <span>{productMegaMenu.label}</span>
            <Icon
              name="lucide:chevron-down"
              class="w-3.5 h-3.5 transition-transform duration-200 text-slate-400 dark:text-slate-500 chevron-icon"
            />
          </button>

          <!-- Dropdown bridge & container -->
          <div
            id="mega-panel-product"
            class="mega-menu-panel invisible opacity-0 translate-y-1 transition-all duration-200 pointer-events-none absolute left-1/2 -translate-x-1/2 top-full pt-1.5 z-50 w-[880px] xl:w-[920px] max-w-[calc(100vw-2rem)]"
            role="region"
            aria-label="Product navigation menu"
          >
            <div
              class="w-full bg-background border border-border rounded-xl overflow-hidden flex flex-col max-h-[calc(100vh-5.5rem)]"
            >
              <div
                class="p-6 grid grid-cols-3 divide-x divide-slate-100 dark:divide-slate-800/80 overflow-y-auto"
              >
                <!-- Col 1: Products & Pricing -->
                <div class="pr-6 space-y-6">
                  {
                    productMegaMenu.columns[0]?.sections.map((section) => (
                      <div>
                        {section.title && (
                          <div class="text-[11px] font-bold text-slate-400 dark:text-slate-400 tracking-wider uppercase mb-3">
                            {section.title}
                          </div>
                        )}
                        <div class="space-y-3.5">
                          {section.items.map((item) => (
                            <a
                              href={item.href}
                              class="group/item flex items-start gap-3 p-2 -mx-2 rounded-xl transition-all duration-150 hover:bg-surface/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                            >
                              <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border flex items-center justify-center text-text-muted group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 group-hover/item:bg-blue-50/60 dark:group-hover/item:bg-blue-950/40 transition-colors mt-0.5 ">
                                <Icon name={item.icon} class="w-4 h-4" />
                              </div>
                              <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-1.5">
                                  <span class="text-sm font-semibold text-text group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                                    {item.label}
                                  </span>
                                  {item.badge && (
                                    <span class="text-[10px] font-bold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                      {item.badge}
                                    </span>
                                  )}
                                </div>
                                <p class="text-xs text-slate-500 dark:text-slate-400 group-hover/item:text-slate-700 dark:group-hover/item:text-slate-300 whitespace-normal leading-relaxed mt-0.5 transition-colors line-clamp-2">
                                  {item.description}
                                </p>
                              </div>
                            </a>
                          ))}
                        </div>
                      </div>
                    ))
                  }
                </div>

                <!-- Col 2: Features -->
                <div class="px-6">
                  <div
                    class="text-[11px] font-bold text-slate-400 dark:text-slate-400 tracking-wider uppercase mb-3"
                  >
                    Features
                  </div>
                  <div class="space-y-3.5">
                    {
                      productMegaMenu.columns[1]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-2 -mx-2 rounded-xl transition-all duration-150 hover:bg-surface/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border flex items-center justify-center text-text-muted group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 group-hover/item:bg-blue-50/60 dark:group-hover/item:bg-blue-950/40 transition-colors mt-0.5 ">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                                {item.label}
                              </span>
                              {item.badge && (
                                <span class="text-[10px] font-bold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                  {item.badge}
                                </span>
                              )}
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 group-hover/item:text-slate-700 dark:group-hover/item:text-slate-300 whitespace-normal leading-relaxed mt-0.5 transition-colors line-clamp-2">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>

                <!-- Col 3: Use Cases -->
                <div class="pl-6">
                  <div
                    class="text-[11px] font-bold text-slate-400 dark:text-slate-400 tracking-wider uppercase mb-3"
                  >
                    Use Cases
                  </div>
                  <div class="space-y-3.5">
                    {
                      productMegaMenu.columns[2]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-2 -mx-2 rounded-xl transition-all duration-150 hover:bg-surface/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border flex items-center justify-center text-text-muted group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 group-hover/item:bg-blue-50/60 dark:group-hover/item:bg-blue-950/40 transition-colors mt-0.5 ">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                                {item.label}
                              </span>
                              {item.badge && (
                                <span class="text-[10px] font-bold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                  {item.badge}
                                </span>
                              )}
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 group-hover/item:text-slate-700 dark:group-hover/item:text-slate-300 whitespace-normal leading-relaxed mt-0.5 transition-colors line-clamp-2">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>
              </div>

              <!-- Bottom Action Footer -->
              <div
                class="bg-surface border-t border-border px-6 py-3.5 flex items-center justify-between"
              >
                <div class="flex items-center gap-6">
                  <a
                    href="/features"
                    class="text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1.5"
                  >
                    <span>View all features</span>
                    <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
                  </a>
                  <a
                    href="/solutions"
                    class="text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1.5"
                  >
                    <span>View all use cases</span>
                    <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
                  </a>
                </div>
                <span
                  class="text-[11px] text-slate-400 dark:text-slate-500 font-mono hidden sm:inline"
                >
                  Safaricom Daraja & Meta Cloud API Ready
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Solutions Mega-Menu Trigger & Container -->
        <div
          class="h-16 flex items-center relative mega-menu-container group"
          data-menu="solutions"
          data-state="closed"
        >
          <button
            type="button"
            class="mega-menu-trigger flex items-center gap-1.5 text-text-muted hover:text-text transition-colors text-sm font-medium rounded-lg px-3 py-2 focus-visible:ring-2 focus-visible:ring-primary focus:outline-none cursor-pointer"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="mega-panel-solutions"
          >
            <span>{solutionsMegaMenu.label}</span>
            <Icon
              name="lucide:chevron-down"
              class="w-3.5 h-3.5 transition-transform duration-200 text-slate-400 dark:text-slate-500 chevron-icon"
            />
          </button>

          <!-- Dropdown bridge & container -->
          <div
            id="mega-panel-solutions"
            class="mega-menu-panel invisible opacity-0 translate-y-1 transition-all duration-200 pointer-events-none absolute left-1/2 -translate-x-1/2 top-full pt-1.5 z-50 w-[880px] xl:w-[920px] max-w-[calc(100vw-2rem)]"
            role="region"
            aria-label="Solutions navigation menu"
          >
            <div
              class="w-full bg-background border border-border rounded-xl overflow-hidden flex flex-col max-h-[calc(100vh-5.5rem)]"
            >
              <div
                class="p-6 grid grid-cols-3 divide-x divide-slate-100 dark:divide-slate-800/80 overflow-y-auto"
              >
                <!-- Col 1: Teams & Size -->
                <div class="pr-6 space-y-6">
                  {
                    solutionsMegaMenu.columns[0]?.sections.map((section) => (
                      <div>
                        {section.title && (
                          <div class="text-[11px] font-bold text-slate-400 dark:text-slate-400 tracking-wider uppercase mb-3">
                            {section.title}
                          </div>
                        )}
                        <div class="space-y-3.5">
                          {section.items.map((item) => (
                            <a
                              href={item.href}
                              class="group/item flex items-start gap-3 p-2 -mx-2 rounded-xl transition-all duration-150 hover:bg-surface/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                            >
                              <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border flex items-center justify-center text-text-muted group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 group-hover/item:bg-blue-50/60 dark:group-hover/item:bg-blue-950/40 transition-colors mt-0.5 ">
                                <Icon name={item.icon} class="w-4 h-4" />
                              </div>
                              <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-1.5">
                                  <span class="text-sm font-semibold text-text group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                                    {item.label}
                                  </span>
                                  {item.badge && (
                                    <span class="text-[10px] font-bold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                      {item.badge}
                                    </span>
                                  )}
                                </div>
                                <p class="text-xs text-slate-500 dark:text-slate-400 group-hover/item:text-slate-700 dark:group-hover/item:text-slate-300 whitespace-normal leading-relaxed mt-0.5 transition-colors line-clamp-2">
                                  {item.description}
                                </p>
                              </div>
                            </a>
                          ))}
                        </div>
                      </div>
                    ))
                  }
                </div>

                <!-- Col 2: Industries A -->
                <div class="px-6">
                  <div
                    class="text-[11px] font-bold text-slate-400 dark:text-slate-400 tracking-wider uppercase mb-3"
                  >
                    Key Industries
                  </div>
                  <div class="space-y-3.5">
                    {
                      solutionsMegaMenu.columns[1]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-2 -mx-2 rounded-xl transition-all duration-150 hover:bg-surface/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border flex items-center justify-center text-text-muted group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 group-hover/item:bg-blue-50/60 dark:group-hover/item:bg-blue-950/40 transition-colors mt-0.5 ">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                                {item.label}
                              </span>
                              {item.badge && (
                                <span class="text-[10px] font-bold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                  {item.badge}
                                </span>
                              )}
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 group-hover/item:text-slate-700 dark:group-hover/item:text-slate-300 whitespace-normal leading-relaxed mt-0.5 transition-colors line-clamp-2">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>

                <!-- Col 3: Industries B -->
                <div class="pl-6">
                  <div
                    class="text-[11px] font-bold text-slate-400 dark:text-slate-400 tracking-wider uppercase mb-3"
                  >
                    Commercial Sectors
                  </div>
                  <div class="space-y-3.5">
                    {
                      solutionsMegaMenu.columns[2]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-2 -mx-2 rounded-xl transition-all duration-150 hover:bg-surface/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border flex items-center justify-center text-text-muted group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 group-hover/item:bg-blue-50/60 dark:group-hover/item:bg-blue-950/40 transition-colors mt-0.5 ">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                                {item.label}
                              </span>
                              {item.badge && (
                                <span class="text-[10px] font-bold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                  {item.badge}
                                </span>
                              )}
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 group-hover/item:text-slate-700 dark:group-hover/item:text-slate-300 whitespace-normal leading-relaxed mt-0.5 transition-colors line-clamp-2">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>
              </div>

              <!-- Bottom Action Footer -->
              <div
                class="bg-surface border-t border-border px-6 py-3.5 flex items-center justify-between"
              >
                <div class="flex items-center gap-6">
                  <a
                    href="/solutions"
                    class="text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1.5"
                  >
                    <span>Explore all industry solutions</span>
                    <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
                  </a>
                  <a
                    href="/demo"
                    class="text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1.5"
                  >
                    <span>Book tailored merchant demo</span>
                    <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
                  </a>
                </div>
                <span
                  class="text-[11px] text-slate-400 dark:text-slate-500 font-mono hidden sm:inline"
                >
                  Customized for Nairobi, Mombasa & Regional Hubs
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Resources Mega-Menu Trigger & Container -->
        <div
          class="h-16 flex items-center relative mega-menu-container group"
          data-menu="resources"
          data-state="closed"
        >
          <button
            type="button"
            class="mega-menu-trigger flex items-center gap-1.5 text-text-muted hover:text-text transition-colors text-sm font-medium rounded-lg px-3 py-2 focus-visible:ring-2 focus-visible:ring-primary focus:outline-none cursor-pointer"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="mega-panel-resources"
