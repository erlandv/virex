            role="region"
            aria-label="Resources navigation menu"
          >
            <div
              class="w-full bg-background border border-border rounded-xl overflow-hidden flex flex-col max-h-[calc(100vh-5.5rem)]"
            >
              <div
                class="p-6 grid grid-cols-3 divide-x divide-slate-100 dark:divide-slate-800/80 overflow-y-auto"
              >
                <!-- Col 1: Spotlight -->
                <div class="pr-6">
                  <div
                    class="text-[11px] font-bold text-slate-400 dark:text-slate-400 tracking-wider uppercase mb-3"
                  >
                    Spotlight
                  </div>
                  <div class="space-y-3.5">
                    {
                      resourcesMegaMenu.columns[0]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-2 -mx-2 rounded-xl transition-all duration-150 hover:bg-surface/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border flex items-center justify-center text-text-muted group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 group-hover/item:bg-blue-50/60 dark:group-hover/item:bg-blue-950/40 transition-colors mt-0.5 ">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                                {item.label}
                              </span>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 group-hover/item:text-slate-700 dark:group-hover/item:text-slate-300 whitespace-normal leading-relaxed mt-0.5 transition-colors line-clamp-2">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>

                <!-- Col 2: Docs & Tools -->
                <div class="px-6">
                  <div
                    class="text-[11px] font-bold text-slate-400 dark:text-slate-400 tracking-wider uppercase mb-3"
                  >
                    Documentation & Tools
                  </div>
                  <div class="space-y-3.5">
                    {
                      resourcesMegaMenu.columns[1]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-2 -mx-2 rounded-xl transition-all duration-150 hover:bg-surface/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border flex items-center justify-center text-text-muted group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 group-hover/item:bg-blue-50/60 dark:group-hover/item:bg-blue-950/40 transition-colors mt-0.5 ">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                                {item.label}
                              </span>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 group-hover/item:text-slate-700 dark:group-hover/item:text-slate-300 whitespace-normal leading-relaxed mt-0.5 transition-colors line-clamp-2">
                              {item.description}
                            </p>
                          </div>
