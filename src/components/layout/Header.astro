---
/**
 * Header - Site header with responsive navigation and Chatwoot-style mega-menus
 *
 * Implements expansive hover mega-menus for Product, Solutions, and Resources,
 * direct navigation links, and full mobile accordion support while preserving
 * Virex typography and minimalist borders.
 */
import { siteConfig } from '@/config';
import { Icon } from 'astro-icon/components';
import ThemeToggle from '@ui/ThemeToggle.astro';
import {
  productMegaMenu,
  solutionsMegaMenu,
  resourcesMegaMenu,
  directNavLinks,
  headerCtas,
} from '@/data/navigation';

const ghostCTAs = headerCtas.filter((cta) => cta.variant === 'ghost');
const primaryCTA = headerCtas.find((cta) => cta.variant === 'primary');
---

<header
  id="site-header"
  class="sticky top-0 z-50 p-1.5 bg-background/80 backdrop-blur-md border-b border-surface"
>
  <nav class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16">
      <!-- Logo / Site Name -->
      <a href="/" class="flex items-center gap-2 font-semibold text-lg text-text shrink-0">
        {
          siteConfig.logo ? (
            <img src={siteConfig.logo} alt={siteConfig.name} class="h-8 w-auto" />
          ) : (
            siteConfig.name
          )
        }
      </a>

      <!-- Desktop Navigation with Chatwoot-Style Mega-Menus -->
      <div class="hidden lg:flex items-center gap-1 xl:gap-2">
        <!-- 1. Product Mega-Menu Trigger & Container -->
        <div class="h-16 flex items-center group/product">
          <button
            type="button"
            class="flex items-center gap-1.5 text-text-muted hover:text-text group-hover/product:text-text transition-colors text-sm font-medium rounded-md px-3 py-2 focus-visible:ring-2 focus-visible:ring-primary focus:outline-none cursor-pointer"
            aria-expanded="false"
          >
            <span>{productMegaMenu.label}</span>
            <Icon
              name="lucide:chevron-down"
              class="w-3.5 h-3.5 transition-transform duration-200 group-hover/product:rotate-180 text-text-muted group-hover/product:text-text"
            />
          </button>

          <!-- Dropdown bridge & container -->
          <div
            class="invisible opacity-0 translate-y-2 group-hover/product:visible group-hover/product:opacity-100 group-hover/product:translate-y-0 group-focus-within/product:visible group-focus-within/product:opacity-100 group-focus-within/product:translate-y-0 transition-all duration-200 pointer-events-none group-hover/product:pointer-events-auto group-focus-within/product:pointer-events-auto absolute left-1/2 -translate-x-1/2 top-full pt-2 z-50 w-[900px] max-w-[calc(100vw-2rem)]"
            style="width: 900px; max-width: calc(100vw - 2rem);"
          >
            <div
              class="w-full bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 shadow-xl rounded-2xl overflow-hidden"
            >
              <div class="p-8 grid grid-cols-3">
                <!-- Col 1: Products & Pricing -->
                <div class="pr-8 border-r border-gray-100 dark:border-gray-800">
                  {
                    productMegaMenu.columns[0]?.sections.map((section, sIdx) => (
                      <div>
                        {section.title && (
                          <div
                            class:list={[
                              'text-xs font-semibold text-gray-400 tracking-wider uppercase',
                              sIdx === 0 ? 'mb-4' : 'mt-8 mb-4',
                            ]}
                          >
                            {section.title}
                          </div>
                        )}
                        <div class="space-y-6">
                          {section.items.map((item) => (
                            <a
                              href={item.href}
                              class="group/item flex items-start gap-3 p-1.5 -mx-1.5 rounded-xl hover:bg-surface transition-colors"
                            >
                              <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border/60 flex items-center justify-center text-text-muted group-hover/item:text-primary group-hover/item:border-primary/30 group-hover/item:bg-primary/5 transition-colors mt-0.5">
                                <Icon name={item.icon} class="w-4 h-4" />
                              </div>
                              <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-1.5">
                                  <span class="text-sm font-semibold text-text group-hover/item:text-primary transition-colors">
                                    {item.label}
                                  </span>
                                  {item.badge && (
                                    <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                      {item.badge}
                                    </span>
                                  )}
                                </div>
                                <p class="text-sm text-slate-500 dark:text-slate-400 whitespace-normal leading-relaxed mt-1">
                                  {item.description}
                                </p>
                              </div>
                            </a>
                          ))}
                        </div>
                      </div>
                    ))
                  }
                </div>

                <!-- Col 2: Features -->
                <div class="px-8 border-r border-gray-100 dark:border-gray-800">
                  <div class="text-xs font-semibold text-gray-400 tracking-wider uppercase mb-4">
                    Features
                  </div>
                  <div class="space-y-6">
                    {
                      productMegaMenu.columns[1]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-1.5 -mx-1.5 rounded-xl hover:bg-surface transition-colors"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border/60 flex items-center justify-center text-text-muted group-hover/item:text-primary group-hover/item:border-primary/30 group-hover/item:bg-primary/5 transition-colors mt-0.5">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-primary transition-colors">
                                {item.label}
                              </span>
                              {item.badge && (
                                <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                  {item.badge}
                                </span>
                              )}
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400 whitespace-normal leading-relaxed mt-1">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>

                <!-- Col 3: Use Cases -->
                <div class="pl-8">
                  <div class="text-xs font-semibold text-gray-400 tracking-wider uppercase mb-4">
                    Use Cases
                  </div>
                  <div class="space-y-6">
                    {
                      productMegaMenu.columns[2]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-1.5 -mx-1.5 rounded-xl hover:bg-surface transition-colors"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border/60 flex items-center justify-center text-text-muted group-hover/item:text-primary group-hover/item:border-primary/30 group-hover/item:bg-primary/5 transition-colors mt-0.5">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-primary transition-colors">
                                {item.label}
                              </span>
                              {item.badge && (
                                <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                  {item.badge}
                                </span>
                              )}
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400 whitespace-normal leading-relaxed mt-1">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>
              </div>

              <!-- Bottom Action Footer -->
              <div
                class="bg-gray-50 dark:bg-gray-800/40 border-t border-gray-100 dark:border-gray-800 px-8 py-4 flex gap-6"
              >
                <a
                  href="/features"
                  class="text-sm font-medium text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1.5"
                >
                  <span>View all features</span>
                  <span>&rarr;</span>
                </a>
                <a
                  href="/solutions"
                  class="text-sm font-medium text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1.5"
                >
                  <span>View all use cases</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Solutions Mega-Menu Trigger & Container -->
        <div class="h-16 flex items-center group/solutions">
          <button
            type="button"
            class="flex items-center gap-1.5 text-text-muted hover:text-text group-hover/solutions:text-text transition-colors text-sm font-medium rounded-md px-3 py-2 focus-visible:ring-2 focus-visible:ring-primary focus:outline-none cursor-pointer"
            aria-expanded="false"
          >
            <span>{solutionsMegaMenu.label}</span>
            <Icon
              name="lucide:chevron-down"
              class="w-3.5 h-3.5 transition-transform duration-200 group-hover/solutions:rotate-180 text-text-muted group-hover/solutions:text-text"
            />
          </button>

          <!-- Dropdown bridge & container -->
          <div
            class="invisible opacity-0 translate-y-2 group-hover/solutions:visible group-hover/solutions:opacity-100 group-hover/solutions:translate-y-0 group-focus-within/solutions:visible group-focus-within/solutions:opacity-100 group-focus-within/solutions:translate-y-0 transition-all duration-200 pointer-events-none group-hover/solutions:pointer-events-auto group-focus-within/solutions:pointer-events-auto absolute left-1/2 -translate-x-1/2 top-full pt-2 z-50 w-[900px] max-w-[calc(100vw-2rem)]"
            style="width: 900px; max-width: calc(100vw - 2rem);"
          >
            <div
              class="w-full bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 shadow-xl rounded-2xl overflow-hidden"
            >
              <div class="p-8 grid grid-cols-3">
                <!-- Col 1: Teams & Size -->
                <div class="pr-8 border-r border-gray-100 dark:border-gray-800">
                  {
                    solutionsMegaMenu.columns[0]?.sections.map((section, sIdx) => (
                      <div>
                        {section.title && (
                          <div
                            class:list={[
                              'text-xs font-semibold text-gray-400 tracking-wider uppercase',
                              sIdx === 0 ? 'mb-4' : 'mt-8 mb-4',
                            ]}
                          >
                            {section.title}
                          </div>
                        )}
                        <div class="space-y-6">
                          {section.items.map((item) => (
                            <a
                              href={item.href}
                              class="group/item flex items-start gap-3 p-1.5 -mx-1.5 rounded-xl hover:bg-surface transition-colors"
                            >
                              <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border/60 flex items-center justify-center text-text-muted group-hover/item:text-primary group-hover/item:border-primary/30 group-hover/item:bg-primary/5 transition-colors mt-0.5">
                                <Icon name={item.icon} class="w-4 h-4" />
                              </div>
                              <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-1.5">
                                  <span class="text-sm font-semibold text-text group-hover/item:text-primary transition-colors">
                                    {item.label}
                                  </span>
                                  {item.badge && (
                                    <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                      {item.badge}
                                    </span>
                                  )}
                                </div>
                                <p class="text-sm text-slate-500 dark:text-slate-400 whitespace-normal leading-relaxed mt-1">
                                  {item.description}
                                </p>
                              </div>
                            </a>
                          ))}
                        </div>
                      </div>
                    ))
                  }
                </div>

                <!-- Col 2: Industries A -->
                <div class="px-8 border-r border-gray-100 dark:border-gray-800">
                  <div class="text-xs font-semibold text-gray-400 tracking-wider uppercase mb-4">
                    Industries
                  </div>
                  <div class="space-y-6">
                    {
                      solutionsMegaMenu.columns[1]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-1.5 -mx-1.5 rounded-xl hover:bg-surface transition-colors"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border/60 flex items-center justify-center text-text-muted group-hover/item:text-primary group-hover/item:border-primary/30 group-hover/item:bg-primary/5 transition-colors mt-0.5">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-primary transition-colors">
                                {item.label}
                              </span>
                              {item.badge && (
                                <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                  {item.badge}
                                </span>
                              )}
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400 whitespace-normal leading-relaxed mt-1">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>

                <!-- Col 3: Industries B -->
                <div class="pl-8">
                  <div class="text-xs font-semibold text-gray-400 tracking-wider uppercase mb-4">
                    More Industries
                  </div>
                  <div class="space-y-6">
                    {
                      solutionsMegaMenu.columns[2]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-1.5 -mx-1.5 rounded-xl hover:bg-surface transition-colors"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border/60 flex items-center justify-center text-text-muted group-hover/item:text-primary group-hover/item:border-primary/30 group-hover/item:bg-primary/5 transition-colors mt-0.5">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-primary transition-colors">
                                {item.label}
                              </span>
                              {item.badge && (
                                <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                                  {item.badge}
                                </span>
                              )}
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400 whitespace-normal leading-relaxed mt-1">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>
              </div>

              <!-- Bottom Action Footer -->
              <div
                class="bg-gray-50 dark:bg-gray-800/40 border-t border-gray-100 dark:border-gray-800 px-8 py-4 flex gap-6"
              >
                <a
                  href="/features"
                  class="text-sm font-medium text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1.5"
                >
                  <span>View all features</span>
                  <span>&rarr;</span>
                </a>
                <a
                  href="/solutions"
                  class="text-sm font-medium text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1.5"
                >
                  <span>View all use cases</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Resources Mega-Menu Trigger & Container -->
        <div class="h-16 flex items-center group/resources">
          <button
            type="button"
            class="flex items-center gap-1.5 text-text-muted hover:text-text group-hover/resources:text-text transition-colors text-sm font-medium rounded-md px-3 py-2 focus-visible:ring-2 focus-visible:ring-primary focus:outline-none cursor-pointer"
            aria-expanded="false"
          >
            <span>{resourcesMegaMenu.label}</span>
            <Icon
              name="lucide:chevron-down"
              class="w-3.5 h-3.5 transition-transform duration-200 group-hover/resources:rotate-180 text-text-muted group-hover/resources:text-text"
            />
          </button>

          <!-- Dropdown bridge & container -->
          <div
            class="invisible opacity-0 translate-y-2 group-hover/resources:visible group-hover/resources:opacity-100 group-hover/resources:translate-y-0 group-focus-within/resources:visible group-focus-within/resources:opacity-100 group-focus-within/resources:translate-y-0 transition-all duration-200 pointer-events-none group-hover/resources:pointer-events-auto group-focus-within/resources:pointer-events-auto absolute left-1/2 -translate-x-1/2 top-full pt-2 z-50 w-[900px] max-w-[calc(100vw-2rem)]"
            style="width: 900px; max-width: calc(100vw - 2rem);"
          >
            <div
              class="w-full bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 shadow-xl rounded-2xl overflow-hidden"
            >
              <div class="p-8 grid grid-cols-3">
                <!-- Col 1: Spotlight -->
                <div class="pr-8 border-r border-gray-100 dark:border-gray-800">
                  <div class="text-xs font-semibold text-gray-400 tracking-wider uppercase mb-4">
                    Spotlight
                  </div>
                  <div class="space-y-6">
                    {
                      resourcesMegaMenu.columns[0]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-1.5 -mx-1.5 rounded-xl hover:bg-surface transition-colors"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border/60 flex items-center justify-center text-text-muted group-hover/item:text-primary group-hover/item:border-primary/30 group-hover/item:bg-primary/5 transition-colors mt-0.5">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-primary transition-colors">
                                {item.label}
                              </span>
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400 whitespace-normal leading-relaxed mt-1">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>

                <!-- Col 2: Docs & Community -->
                <div class="px-8 border-r border-gray-100 dark:border-gray-800">
                  <div class="text-xs font-semibold text-gray-400 tracking-wider uppercase mb-4">
                    Docs & Community
                  </div>
                  <div class="space-y-6">
                    {
                      resourcesMegaMenu.columns[1]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          class="group/item flex items-start gap-3 p-1.5 -mx-1.5 rounded-xl hover:bg-surface transition-colors"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border/60 flex items-center justify-center text-text-muted group-hover/item:text-primary group-hover/item:border-primary/30 group-hover/item:bg-primary/5 transition-colors mt-0.5">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-primary transition-colors">
                                {item.label}
                              </span>
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400 whitespace-normal leading-relaxed mt-1">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>

                <!-- Col 3: Ecosystem -->
                <div class="pl-8">
                  <div class="text-xs font-semibold text-gray-400 tracking-wider uppercase mb-4">
                    Ecosystem
                  </div>
                  <div class="space-y-6">
                    {
                      resourcesMegaMenu.columns[2]?.sections[0]?.items.map((item) => (
                        <a
                          href={item.href}
                          target={item.external ? '_blank' : undefined}
                          rel={item.external ? 'noopener noreferrer' : undefined}
                          class="group/item flex items-start gap-3 p-1.5 -mx-1.5 rounded-xl hover:bg-surface transition-colors"
                        >
                          <div class="shrink-0 w-8 h-8 rounded-lg bg-surface border border-border/60 flex items-center justify-center text-text-muted group-hover/item:text-primary group-hover/item:border-primary/30 group-hover/item:bg-primary/5 transition-colors mt-0.5">
                            <Icon name={item.icon} class="w-4 h-4" />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-sm font-semibold text-text group-hover/item:text-primary transition-colors">
                                {item.label}
                              </span>
                              {item.external && (
                                <Icon name="lucide:external-link" class="w-3 h-3 text-text-muted" />
                              )}
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400 whitespace-normal leading-relaxed mt-1">
                              {item.description}
                            </p>
                          </div>
                        </a>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Direct Navigation Links -->
        {
          directNavLinks.map((link) => (
            <a
              href={link.href}
              class="inline-flex items-center gap-1.5 text-text-muted hover:text-text transition-colors text-sm font-medium rounded-md px-3 py-2 focus-visible:ring-2 focus-visible:ring-primary focus:outline-none"
            >
              <span>{link.label}</span>
              {link.badge && (
                <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded-full bg-primary/10 text-primary border border-primary/20">
                  {link.badge}
                </span>
              )}
            </a>
          ))
        }
      </div>

      <!-- Desktop Actions - Right -->
      <div class="hidden md:flex items-center gap-3">
        <ThemeToggle />
        {
          ghostCTAs.map((cta) => (
            <a
              href={cta.href}
              class="text-text-muted hover:text-text transition-colors text-sm font-medium rounded-md px-3 py-2 focus-visible:ring-2 focus-visible:ring-primary focus:outline-none"
            >
              {cta.label}
            </a>
          ))
        }
        {
          primaryCTA && (
            <a
              href={primaryCTA.href}
              class="px-4 py-2 rounded-xl bg-primary text-white text-sm font-semibold hover:bg-primary-dark transition-colors shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              {primaryCTA.label}
            </a>
          )
        }
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center gap-2 lg:hidden">
        <ThemeToggle />
        <button
          id="mobile-menu-button"
          type="button"
          aria-label="Toggle mobile menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2 rounded-md hover:bg-surface transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          <Icon name="lucide:menu" id="menu-icon-open" class="w-6 h-6 text-text" />
          <Icon name="lucide:x" id="menu-icon-close" class="hidden w-6 h-6 text-text" />
        </button>
      </div>
