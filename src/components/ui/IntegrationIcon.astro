---
/**
 * Authentic Full-Color Brand Icon for Kenyan & Global Integrations
 *
 * Provides crisp, high-fidelity brand SVGs for all 18 MarkChat integrations:
 * 1. Safaricom M-Pesa (Daraja C2B & STK)
 * 2. WhatsApp Business (Cloud API & Embedded)
 * 3. Africa's Talking Bulk SMS & BYOC
 * 4. Markcopilot AI Assistant
 * 5. Shopify
 * 6. Instagram & Facebook Messenger
 * 7. Pochi la Biashara & Personal Till Sync
 * 8. Shared Bank Paybill (KCB, Equity, Co-op)
 * 9. TikTok Business Messaging
 * 10. Telegram
 * 11. Website Live Chat & Help Center
 * 12. Email (Gmail, Outlook & Custom SMTP)
 * 13. LINE
 * 14. Stripe
 * 15. Slack
 * 16. Linear
 * 17. Notion
 * 18. Google & Microsoft SSO
 */

interface Props {
  iconKey?: string;
  logoUrl?: string;
  name?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const {
  iconKey = '',
  logoUrl,
  name = 'Integration',
  size = 'md',
  class: className = '',
} = Astro.props;

const containerSizes = {
  sm: 'w-9 h-9 rounded-lg p-1.5',
  md: 'w-12 h-12 rounded-xl p-2.5',
  lg: 'w-14 h-14 rounded-2xl p-3',
  xl: 'w-16 h-16 rounded-2xl p-3.5',
}[size];

const iconSizes = {
  sm: 'w-5 h-5',
  md: 'w-7 h-7',
  lg: 'w-8 h-8',
  xl: 'w-9 h-9',
}[size];

const normalizedKey = iconKey.toLowerCase().replace(/[^a-z0-9]/g, '-');
---

<div
  class:list={[
    'shrink-0 flex items-center justify-center bg-gray-50 dark:bg-gray-800/80 border border-gray-200/60 dark:border-gray-700/60 shadow-xs transition-transform group-hover:scale-105',
    containerSizes,
    className,
  ]}
>
  {
    logoUrl ? (
      <img
        src={logoUrl}
        alt={name}
        class:list={['object-contain max-w-full max-h-full', iconSizes]}
        loading="lazy"
      />
    ) : normalizedKey.includes('mpesa') ||
      normalizedKey.includes('daraja') ||
      normalizedKey.includes('safaricom') ? (
      <svg class={iconSizes} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="48" height="48" rx="10" fill="#43B02A" />
        <path
          d="M12 36V12L24 24L36 12V36"
          stroke="#FFFFFF"
          stroke-width="4.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="36" cy="14" r="3.5" fill="#E11414" />
        <circle cx="12" cy="14" r="3.5" fill="#E11414" />
      </svg>
    ) : normalizedKey.includes('whatsapp') ? (
      <svg class={iconSizes} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="48" height="48" rx="10" fill="#25D366" />
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M24 10C16.268 10 10 16.268 10 24C10 26.696 10.764 29.214 12.086 31.354L10.5 37.5L16.828 35.882C18.91 37.034 21.374 37.7 24 37.7C31.732 37.7 38 31.432 38 23.7C38 15.968 31.732 10 24 10ZM31.854 28.536C31.528 29.452 30.238 30.224 29.28 30.33C28.628 30.402 27.784 30.438 24.918 29.248C21.254 27.728 18.892 24.016 18.708 23.774C18.53 23.532 17.228 21.802 17.228 20.02C17.228 18.238 18.134 17.368 18.46 17.006C18.786 16.644 19.184 16.554 19.438 16.554C19.692 16.554 19.946 16.558 20.162 16.568C20.398 16.58 20.706 16.49 21.014 17.234C21.34 18.014 22.118 19.932 22.208 20.132C22.3 20.332 22.372 20.584 22.246 20.826C22.118 21.07 22.028 21.196 21.846 21.414C21.666 21.632 21.466 21.884 21.304 22.048C21.122 22.23 20.932 22.428 21.132 22.772C21.332 23.116 22.02 24.238 23.034 25.142C24.34 26.304 25.398 26.674 25.76 26.856C26.122 27.038 26.34 27.002 26.556 26.748C26.774 26.494 27.498 25.644 27.77 25.264C28.042 24.884 28.314 24.938 28.676 25.082C29.038 25.228 30.976 26.188 31.374 26.388C31.772 26.588 32.044 26.684 32.134 26.838C32.226 26.992 32.18 27.62 31.854 28.536Z"
