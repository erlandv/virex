---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const tabs = [
  { id: 'inbox', label: 'Unified Inbox' },
  { id: 'mpesa', label: 'M-Pesa /stk' },
  { id: 'markcopilot', label: 'Markcopilot AI' },
];
---

<div
  data-mc-product-tabs
  class:list={['rounded-xl border border-border bg-surface-elevated', className]}
>
  <div
    role="tablist"
    aria-label="MarkChat product workflows"
    class="flex flex-wrap gap-1 border-b border-border p-2"
  >
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          data-mc-tab={tab.id}
          id={'mc-tab-' + tab.id}
          aria-controls={'mc-panel-' + tab.id}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          class:list={[
            'min-h-11 flex-1 rounded-lg border px-3 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-primary',
            index === 0
              ? 'border-primary bg-surface text-text'
              : 'border-transparent text-text-muted',
          ]}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  <div
    id="mc-panel-inbox"
    data-mc-panel="inbox"
    role="tabpanel"
    aria-labelledby="mc-tab-inbox"
    class="p-3 sm:p-5"
  >
    <slot name="inbox" />
  </div>
  <div
    id="mc-panel-mpesa"
    data-mc-panel="mpesa"
    role="tabpanel"
    aria-labelledby="mc-tab-mpesa"
    class="p-3 sm:p-5"
    hidden
  >
    <slot name="mpesa" />
  </div>
  <div
    id="mc-panel-markcopilot"
    data-mc-panel="markcopilot"
    role="tabpanel"
    aria-labelledby="mc-tab-markcopilot"
    class="p-3 sm:p-5"
    hidden
  >
    <slot name="markcopilot" />
  </div>
</div>
<script>
  function initMCProductTabs() {
    document.querySelectorAll<HTMLElement>('[data-mc-product-tabs]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mc-tab]'));
      const activate = (index: number) => {
        tabs.forEach((tab, i) => {
          const active = index === i;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          tab.classList.toggle('border-primary', active);
          tab.classList.toggle('bg-surface', active);
          tab.classList.toggle('text-text', active);
          tab.classList.toggle('border-transparent', !active);
          tab.classList.toggle('text-text-muted', !active);
        });
        root.querySelectorAll<HTMLElement>('[data-mc-panel]').forEach((panel) => {
          panel.hidden = panel.dataset.mcPanel !== tabs[index]?.dataset.mcTab;
        });
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(index));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          const next =
            event.key === 'Home'
              ? 0
              : event.key === 'End'
                ? tabs.length - 1
                : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
          activate(next);
          tabs[next]?.focus();
        });
      });
    });
  }
  initMCProductTabs();
  document.addEventListener('astro:page-load', initMCProductTabs);
</script>
