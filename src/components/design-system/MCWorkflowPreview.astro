---
import MCProductFrame from '@/components/design-system/MCProductFrame.astro';
import MCConceptualPreview from '@/components/design-system/MCConceptualPreview.astro';
import type { ProductWorkflow, CmsProductMediaOverride } from '@/data/product-assets';
import { resolveProductAsset, productWorkflows } from '@/data/product-assets';

interface Props {
  workflow: ProductWorkflow;
  description: string;
  cmsMedia?: CmsProductMediaOverride | null;
}
const { workflow, description, cmsMedia } = Astro.props;
const name = productWorkflows[workflow].title;
const light = resolveProductAsset(workflow, 'light', cmsMedia);
const dark = resolveProductAsset(workflow, 'dark', cmsMedia);
---

<div class="space-y-4">
  <div class="overflow-hidden rounded-xl border border-border bg-background">
    {
      light.src || dark.src ? (
        <>
          <div class="dark:hidden">
            <MCProductFrame src={light.src} alt={light.alt} label={name + ' demonstration'} />
          </div>
          <div class="hidden dark:block">
            <MCProductFrame src={dark.src} alt={dark.alt} label={name + ' demonstration'} />
          </div>
        </>
      ) : (
        <MCConceptualPreview kind={workflow} class="border-0" />
      )
    }
  </div>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h3 class="text-xl font-bold text-text">{name}</h3>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-text-muted">{description}</p>
    </div>
    {
      !light.src && !dark.src && (
        <span class="text-xs font-medium text-text-muted">
          Conceptual illustration · not a live screenshot
        </span>
      )
    }
  </div>
</div>
