---
/**
 * Concept illustration only; no real chats, transactions, or dashboards.
 * Replaced by CMS-approved/verified Core screenshots via the hero and workbench.
 */
interface Props {
  kind?: 'inbox' | 'mpesa' | 'markcopilot';
  class?: string;
}
const { kind = 'inbox', class: className = '' } = Astro.props;
---

<div
  data-mc-conceptual-product
  class:list={['overflow-hidden rounded-xl border border-border bg-background', className]}
  role="img"
  aria-label={'Conceptual ' + kind + ' workflow illustration, using synthetic example content'}
>
  {
    kind === 'inbox' ? (
      <div class="overflow-hidden rounded-lg bg-[#171717] p-2 text-neutral-100 sm:p-3">
        <div class="flex items-center justify-between border-b border-neutral-700 px-2 pb-3">
          <div class="flex items-center gap-2 text-xs font-semibold">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary font-black">
              M
            </span>
            MarkChat <span class="font-normal text-neutral-400">/ Shared inbox</span>
          </div>
          <span class="flex items-center gap-1 text-[10px] text-neutral-300">
            <span class="h-1.5 w-1.5 rounded-full bg-primary" /> Demo workspace
          </span>
        </div>
        <div class="grid min-h-60 grid-cols-[31%_69%]">
          <div class="space-y-2 border-r border-neutral-700 py-3 pr-2">
            <p class="px-2 text-[10px] font-bold tracking-wider text-neutral-400">CONVERSATIONS</p>
            <div class="rounded-md bg-neutral-700 px-2 py-2">
              <p class="truncate text-xs font-semibold">Demo shopper</p>
              <p class="mt-1 truncate text-[10px] text-neutral-300">Is this available?</p>
            </div>
            <div class="px-2 py-2">
              <p class="truncate text-xs font-semibold">Example customer</p>
              <p class="mt-1 truncate text-[10px] text-neutral-400">Thank you!</p>
            </div>
          </div>
          <div class="flex flex-col justify-between p-3">
            <div>
              <div class="flex items-center justify-between border-b border-neutral-700 pb-3">
                <span class="text-xs font-semibold">Demo shopper</span>
                <span class="rounded-md border border-neutral-600 px-2 py-1 text-[10px]">
                  Assigned
                </span>
              </div>
              <div class="mt-5 max-w-[85%] rounded-xl rounded-tl-sm bg-neutral-700 p-3 text-xs leading-relaxed">
                Hi, can I check availability before ordering?
              </div>
              <div class="ml-auto mt-3 max-w-[85%] rounded-xl rounded-tr-sm bg-primary p-3 text-xs leading-relaxed text-white">
                Yes! Let me help with the options.
              </div>
            </div>
            <div class="mt-5 flex items-center justify-between rounded-lg border border-neutral-600 bg-neutral-800 p-3 text-[11px] text-neutral-400">
              <>
                <span>Write a reply...</span>
                <span class="font-semibold text-neutral-200">Send ↗</span>
              </>
            </div>
          </div>
        </div>
      </div>
    ) : kind === 'mpesa' ? (
      <div class="p-5">
        <div class="mb-5 flex items-center justify-between">
          <p class="text-xs font-bold text-text">M-Pesa checkout</p>
          <span class="rounded-md bg-primary/10 px-2 py-1 text-[10px] font-semibold text-primary">
            Demo only
          </span>
        </div>
        <div class="rounded-xl border border-border bg-surface p-4">
          <p class="text-xs text-text-muted">Example merchant checkout</p>
          <p class="mt-2 text-3xl font-bold text-text">KES 2,500</p>
          <div class="mt-4 flex items-center justify-between border-t border-border pt-4">
            <span class="text-xs text-text-muted">STK request</span>
            <span class="text-xs font-semibold text-primary">Awaiting approval</span>
          </div>
        </div>
        <p class="mt-3 text-xs text-text-muted">
          Provider verification required for real payments.
        </p>
      </div>
    ) : (
      <div class="p-5">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-text">Markcopilot AI</span>
          <span class="rounded-md border border-border px-2 py-1 text-[10px] text-text-muted">
            Suggestion
          </span>
        </div>
        <p class="mt-5 text-xs text-text-muted">Suggested response · example only</p>
        <div class="mt-3 rounded-lg border border-border bg-surface p-4 text-sm leading-relaxed text-text">
          Hello! I can help you with availability, delivery, and checkout information.
        </div>
        <span class="mt-4 inline-flex rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-white">
          Review before sending
        </span>
      </div>
    )
  }
</div>
