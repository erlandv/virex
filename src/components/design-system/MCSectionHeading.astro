---
interface Props { eyebrow?: string; title: string; description?: string; align?: 'left'|'center'; level?: 'h1'|'h2'|'h3'; class?: string; }
const { eyebrow, title, description, align = 'left', level: Heading = 'h2', class: className = '' } = Astro.props;
---
<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow && <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">{eyebrow}</p>}
  <Heading class="text-3xl font-bold leading-tight tracking-tight text-text sm:text-4xl">{title}</Heading>
  {description && <p class="mt-4 text-base leading-relaxed text-text-muted sm:text-lg">{description}</p>}
</div>
