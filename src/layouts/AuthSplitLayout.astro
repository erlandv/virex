---
/**
 * AuthSplitLayout - Split-Screen SaaS Authentication Layout (Direction A + D)
 *
 * Implements a modern B2B SaaS authentication layout:
 * - Left Panel (Desktop): Product Value Showcase with authentic MarkChat features,
 *   live in-chat commerce preview, and enterprise trust/compliance badges.
 * - Right Panel: Spacious form container with clean, light-themed presentation,
 *   accessible input hierarchy, and mobile responsive brand header.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  headline: string;
  subheadline?: string;
  pageType?: 'register' | 'login' | 'forgot-password' | 'reset-password';
  noindex?: boolean;
}

const {
  title,
  description,
  headline,
  subheadline = 'The customer communications and in-chat commerce platform for Kenyan enterprises.',
  pageType = 'register',
  noindex = false,
} = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div
    class="min-h-screen w-full bg-slate-50 dark:bg-[#0B1120] text-slate-900 dark:text-slate-100 flex flex-col justify-center"
    data-page-type={pageType}
  >
    <!-- Grid Container: 12-column grid on desktop -->
    <div class="w-full min-h-screen grid grid-cols-1 lg:grid-cols-12">
      
      <!-- =================================================================== -->
      <!-- LEFT PANEL: Brand & Product Value Showcase (Visible on lg and up)    -->
      <!-- =================================================================== -->
      <aside
        class="hidden lg:flex lg:col-span-5 xl:col-span-5 bg-gradient-to-br from-slate-900 via-[#0B132B] to-[#1C2541] text-white p-8 xl:p-12 flex-col justify-between relative overflow-hidden border-r border-slate-800 select-none"
        aria-label="MarkChat Product Showcase"
      >
        <!-- Atmospheric Ambient Glows -->
        <div class="pointer-events-none absolute -top-24 -left-24 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute bottom-12 right-0 w-80 h-80 bg-emerald-500/15 rounded-full blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute top-1/2 left-1/3 w-64 h-64 bg-indigo-500/15 rounded-full blur-2xl" aria-hidden="true"></div>

        <!-- Top: Brand Logo -->
        <div class="relative z-10">
          <a href="/" class="inline-flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-blue-400 rounded-xl p-1" aria-label="MarkChat Home">
            <div class="w-11 h-11 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-lg shadow-blue-500/30 group-hover:scale-105 transition-transform duration-200">
              <svg class="w-7 h-7" viewBox="0 0 54 54" fill="none">
                <path d="M12 16C12 13.7909 13.7909 12 16 12H38C40.2091 12 42 13.7909 42 16V32C42 34.2091 40.2091 36 38 36H30L22 43V36H16C13.7909 36 12 34.2091 12 32V16Z" fill="white" fill-opacity="0.18" />
                <path d="M18 32V18L24.5 26L31 18V32" stroke="white" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="37" cy="25" r="2.5" fill="#4ADE80" />
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="font-extrabold text-xl tracking-tight text-white leading-none">
                Mark<span class="text-blue-400">Chat</span>
              </span>
              <span class="text-[10px] uppercase font-semibold tracking-wider text-slate-400 mt-0.5">SaaS Platform</span>
            </div>
          </a>
        </div>

        <!-- Middle: Value Proposition & Product Experience Preview -->
        <div class="relative z-10 my-auto py-8">
          <!-- Top Category Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/15 border border-blue-400/25 text-blue-300 text-xs font-semibold mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Omnichannel Conversational Commerce</span>
          </div>

          <h2 class="text-2xl xl:text-3xl font-bold tracking-tight text-white leading-tight">
            Connect Conversations to Revenue Across Kenya
          </h2>
          <p class="text-slate-300 text-sm xl:text-base mt-3 leading-relaxed">
            Collaborative team inboxes unifying official WhatsApp Business Cloud, Safaricom Daraja M-Pesa, Live Chat, and your own SMS gateway.
          </p>

          <!-- Authentic Live In-Chat Mini-Preview Card -->
          <div class="mt-8 rounded-2xl bg-slate-900/80 border border-slate-700/80 p-4 shadow-2xl backdrop-blur-md">
            <!-- Simulated Chat Header -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-800 text-xs">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-emerald-600/30 border border-emerald-500/40 flex items-center justify-center text-emerald-300 font-bold text-xs">
                  WA
                </div>
                <div>
                  <div class="font-semibold text-slate-200 flex items-center gap-1.5">
                    +254 712 *** 890
                    <span class="text-[10px] px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-400 font-medium">WhatsApp</span>
                  </div>
                  <div class="text-[11px] text-slate-400">Nairobi Customer • Active Now</div>
                </div>
              </div>
              <span class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
                Daraja Active
              </span>
            </div>

            <!-- Chat Messages Stream -->
            <div class="space-y-2.5 pt-3 text-xs">
              <!-- Customer Bubble -->
              <div class="flex flex-col items-start">
                <div class="bg-slate-800 text-slate-200 px-3 py-2 rounded-2xl rounded-tl-sm max-w-[85%] border border-slate-700/60">
                  Hello! I want to confirm my order for the Growth Package.
                </div>
                <span class="text-[10px] text-slate-500 mt-0.5 pl-1">10:42 AM</span>
              </div>

              <!-- Agent Action Bubble with In-Chat M-Pesa STK -->
              <div class="flex flex-col items-end">
                <div class="bg-blue-600/20 text-blue-100 px-3 py-2.5 rounded-2xl rounded-tr-sm max-w-[90%] border border-blue-500/40">
                  <div class="flex items-center justify-between gap-3 text-[11px] font-semibold text-blue-300 mb-1">
                    <span>M-Pesa STK Prompt Dispatched</span>
                    <span class="text-emerald-400 font-bold">KES 3,500</span>
                  </div>
                  <p class="text-[11px] text-slate-300">
                    PIN prompt sent to phone. Awaiting customer confirmation.
                  </p>
                  <div class="mt-2 pt-1.5 border-t border-blue-500/30 flex items-center gap-1.5 text-[10px] text-emerald-400 font-medium">
                    <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    Payment Confirmed (Receipt: QBL89204)
                  </div>
                </div>
                <span class="text-[10px] text-slate-500 mt-0.5 pr-1">10:43 AM • Auto-verified</span>
              </div>
            </div>
          </div>

          <!-- Authentic Capability Bullets -->
          <ul class="mt-6 space-y-2.5 text-xs text-slate-300">
            <li class="flex items-center gap-2.5">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </span>
              <span><strong>Official WhatsApp Cloud API:</strong> High-speed team inbox without phone pairing disconnections.</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </span>
              <span><strong>Bring Your Own SMS Gateway:</strong> Direct connectivity to Africa's Talking or custom SMPP.</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </span>
              <span><strong>Bilingual Markcopilot AI:</strong> Intelligent contextual assistance in Sheng, Swahili & English.</span>
            </li>
          </ul>
        </div>

        <!-- Bottom: Security, Compliance & Trust Badges -->
        <div class="relative z-10 pt-6 border-t border-slate-800 text-xs text-slate-400 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-4">
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              KDPA 2019 Compliant
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              256-Bit SSL Encryption
            </span>
          </div>
          <span class="text-slate-500 font-mono text-[11px]">Nairobi, Kenya</span>
        </div>
      </aside>

      <!-- =================================================================== -->
      <!-- RIGHT PANEL: Spacious Light-Themed Authentication Form Area          -->
      <!-- =================================================================== -->
      <main class="col-span-1 lg:col-span-7 xl:col-span-7 flex flex-col justify-center px-4 py-8 sm:px-8 sm:py-12 md:px-12 lg:px-16 xl:px-20 relative overflow-y-auto">
        <!-- Subtle Ambient Background Light for Right Panel -->
        <div class="pointer-events-none absolute top-0 right-0 w-80 h-80 bg-blue-500/5 dark:bg-blue-600/10 rounded-full blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute bottom-0 left-0 w-80 h-80 bg-indigo-500/5 dark:bg-indigo-600/10 rounded-full blur-3xl" aria-hidden="true"></div>

        <div class="w-full max-w-xl mx-auto relative z-10">
          <!-- Mobile Brand Header (Visible only on < lg) -->
          <div class="lg:hidden text-center mb-8">
            <a href="/" class="inline-flex justify-center mb-3 group" aria-label="MarkChat Home">
              <div class="w-12 h-12 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-lg shadow-blue-500/25 ring-4 ring-blue-500/10">
                <svg class="w-7 h-7" viewBox="0 0 54 54" fill="none">
                  <path d="M12 16C12 13.7909 13.7909 12 16 12H38C40.2091 12 42 13.7909 42 16V32C42 34.2091 40.2091 36 38 36H30L22 43V36H16C13.7909 36 12 34.2091 12 32V16Z" fill="white" fill-opacity="0.18" />
                  <path d="M18 32V18L24.5 26L31 18V32" stroke="white" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="37" cy="25" r="2.5" fill="#4ADE80" />
                </svg>
              </div>
            </a>
            <div class="font-extrabold text-xl text-slate-900 dark:text-white">
              Mark<span class="text-blue-600 dark:text-blue-400">Chat</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
              Customer Communications & Conversational Commerce
            </p>
          </div>

          <!-- Form Header -->
          <div class="mb-6 sm:mb-8 text-left">
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
              {headline}
            </h1>
            {subheadline && (
              <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
                {subheadline}
              </p>
            )}
          </div>

          <!-- Form Container Card -->
          <div class="bg-white dark:bg-slate-900/90 rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-xl shadow-slate-200/50 dark:shadow-none p-6 sm:p-8 md:p-10 transition-colors duration-200">
            <slot />
          </div>

          <!-- Bottom Footer Navigation -->
          <div class="mt-8 text-center text-xs text-slate-500 dark:text-slate-400 flex flex-col sm:flex-row items-center justify-between gap-3 px-2">
            <a href="/" class="hover:text-slate-700 dark:hover:text-slate-300 transition-colors">
              &larr; Back to MarkChat Homepage
            </a>
            <div class="flex items-center gap-4">
              <a href="/terms" class="hover:underline">Terms of Service</a>
              <span>•</span>
              <a href="/privacy" class="hover:underline">Privacy Policy (KDPA)</a>
            </div>
          </div>
        </div>
      </main>

    </div>
  </div>
</BaseLayout>
