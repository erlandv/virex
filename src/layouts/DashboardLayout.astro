---
/**
 * DashboardLayout - Main layout component for dashboard pages
 *
 * @description
 * Wraps BaseLayout to provide SEO and meta tags, then renders DashboardShell
 * with sidebar navigation and content area. This layout should be used for
 * all authenticated dashboard pages.
 *
 * @example
 * ```astro
 * ---
 * import DashboardLayout from '@/layouts/DashboardLayout.astro';
 * ---
 * <DashboardLayout
 *   title="Dashboard Overview"
 *   description="View your analytics and metrics"
 *   breadcrumbs={[
 *     { label: 'Dashboard', href: '/dashboard' },
 *     { label: 'Overview' }
 *   ]}
 * >
 *   <h1>Dashboard Content</h1>
 * </DashboardLayout>
 * ```
 */

import BaseLayout from './BaseLayout.astro';
import DashboardShell from '@dashboard/DashboardShell.astro';
import Toast from '@dashboard-ui/Toast.astro';

interface Props {
  /** Page title for SEO and browser tab */
  title: string;
  /** Page description for SEO */
  description: string;
  /** Breadcrumb navigation items */
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const { title, description, breadcrumbs } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={true}>
  <DashboardShell breadcrumbs={breadcrumbs}>
    <slot />
  </DashboardShell>

  <!-- Toast Notification Container -->
  <Toast />

  <script is:inline>
    (function () {
      if (typeof window !== 'undefined') {
        var path = window.location.pathname;
        var isProtectedAdminRoute =
          (path.startsWith('/dashboard') || path.startsWith('/dashboardMain')) &&
          path !== '/dashboard/login' &&
          path !== '/dashboard/login/';

        if (isProtectedAdminRoute) {
          // Client-side UX navigation guard.
          // Note: True security enforcement occurs at the central CMS API layer
          // via Bearer token verification on all protected administrative operations.
          var token =
            sessionStorage.getItem('markchat_admin_token') ||
            document.cookie
              .split('; ')
              .find(function (row) {
                return row.startsWith('markchat_admin_token=');
              })
              ?.split('=')[1];

          if (!token) {
            window.location.href = '/dashboard/login?redirect=' + encodeURIComponent(path);
          }
        }
      }
    })();
  </script>
</BaseLayout>
