---
/**
 * BlogLayout - Production-Ready Single Blog Post Layout Wrapper
 *
 * Implements strict constraints:
 * - max-w-3xl reading column
 * - Tailwind typography (prose prose-lg dark:prose-invert prose-blue)
 * - Automatic 16:9 aspect ratio and responsive scaling for all images, videos, and iframes
 * - Seamless dark mode inversion
 */
import MarketingLayout from './MarketingLayout.astro';
import { Icon } from 'astro-icon/components';
import { calculateReadingTime, formatDate } from '@/lib/utils';

interface Props {
  title: string;
  description: string;
  excerpt?: string;
  publishedDate: Date;
  author: string | { name: string; role?: string; avatar?: string };
  image?: string;
  coverImage?: string;
  category?: string;
  tags?: string[];
  content?: string;
}

const {
  title,
  description,
  excerpt,
  publishedDate,
  author,
  image,
  coverImage,
  category,
  tags = [],
  content = '',
} = Astro.props;

const authorName = typeof author === 'string' ? author : author.name;
const authorRole = typeof author === 'object' ? author.role : 'MarkChat Editorial';
const authorAvatar = typeof author === 'object' ? author.avatar : undefined;

// Initials for avatar fallback
const initials = authorName
  .split(' ')
  .map((n) => n[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

const readingTime = calculateReadingTime(content);
const formattedDate = formatDate(publishedDate, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const heroImage = coverImage || image;
const postCategory = category || (tags.length > 0 ? tags[0] : 'Kenyan Commerce');
---

<MarketingLayout
  title={title}
  description={description || excerpt || ''}
  image={heroImage}
  type="article"
  publishedDate={publishedDate}
  author={authorName}
  tags={tags}
>
  <article
    class="py-16 sm:py-24 bg-white dark:bg-[#0B1120] text-slate-800 dark:text-slate-200 transition-colors duration-200"
  >
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* 1. Breadcrumb / Navigation Back */}
      <nav class="mb-8 flex items-center gap-2">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors group"
        >
          <svg
            class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
          </svg>
          <span>Back to all articles</span>
        </a>
      </nav>

      {/* 2. Article Header */}
      <header class="mb-10">
        {/* Category Pill */}
        <div class="mb-4">
          <span
            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-50 dark:bg-blue-950/70 text-blue-700 dark:text-blue-300 border border-blue-200/80 dark:border-blue-800/80"
          >
            {postCategory}
          </span>
        </div>

        {/* Title */}
        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.18] mb-6"
        >
          {title}
        </h1>

        {/* Excerpt / Lead */}
        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
          {description || excerpt}
        </p>

        {/* Metadata & Author Bar */}
        <div
          class="flex flex-wrap items-center justify-between gap-4 py-4 border-y border-slate-200 dark:border-slate-800 text-sm"
        >
          {/* Author Block */}
          <div class="flex items-center gap-3">
            {
              authorAvatar ? (
                <img
                  src={authorAvatar}
                  alt={authorName}
                  class="w-10 h-10 rounded-full object-cover border border-slate-200 dark:border-slate-700"
                />
              ) : (
                <div class="w-10 h-10 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shadow-xs">
                  {initials}
                </div>
              )
            }
            <div>
              <p class="font-semibold text-slate-900 dark:text-white">{authorName}</p>
              <p class="text-xs text-slate-500 dark:text-slate-400">{authorRole}</p>
            </div>
          </div>

          {/* Date & Reading Time */}
          <div
            class="flex items-center gap-4 text-xs sm:text-sm text-slate-500 dark:text-slate-400"
          >
            <span class="flex items-center gap-1.5">
              <Icon name="lucide:calendar" class="w-4 h-4 text-slate-400" />
              <time datetime={publishedDate.toISOString()}>{formattedDate}</time>
            </span>
            <span>•</span>
            <span class="flex items-center gap-1.5">
              <Icon name="lucide:clock" class="w-4 h-4 text-slate-400" />
              <span>{readingTime} min read</span>
            </span>
          </div>
        </div>
      </header>

      {/* 3. Hero Featured Cover Image */}
      {
        heroImage && (
          <div class="my-8 rounded-2xl overflow-hidden shadow-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
            <img
              src={heroImage}
              alt={title}
              class="w-full h-auto aspect-video object-cover"
              loading="eager"
            />
          </div>
        )
      }

      {/* 4. Article Prose Content (Strictly max-w-3xl constrained) */}
      <div class="blog-prose-wrapper">
        <div
          class="prose prose-lg dark:prose-invert prose-blue max-w-none text-slate-700 dark:text-slate-300 leading-relaxed prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline prose-code:text-blue-600 dark:prose-code:text-blue-400 prose-pre:bg-slate-900 dark:prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800"
        >
          <slot name="content" />
          <slot />
        </div>
      </div>

      {/* 5. Tags & Topics */}
      {
        tags.length > 0 && (
          <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider mr-2">
                Tagged in:
              </span>
              {tags.map((tag) => (
                <a
                  href={`/blog/tag/${tag}`}
                  class="px-3 py-1 text-xs font-medium bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-blue-950/60 dark:hover:text-blue-400 rounded-lg transition-colors border border-slate-200 dark:border-slate-700"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )
      }

      {/* 6. Author Bio Card */}
      <div
        class="mt-12 p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left"
      >
        <div
          class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white font-bold text-lg flex items-center justify-center shrink-0 shadow-md"
        >
          {initials}
        </div>
        <div>
          <h3 class="font-bold text-base text-slate-900 dark:text-white">
            Written by {authorName}
          </h3>
          <p class="text-xs text-blue-600 dark:text-blue-400 font-medium mt-0.5">{authorRole}</p>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
            Writing about omnichannel retail, Safaricom Daraja API automation, and high-conversion
            customer support systems for Kenyan commerce.
          </p>
        </div>
      </div>

      {/* 7. Conversion CTA Box */}
      <div
        class="mt-12 p-8 rounded-2xl bg-gradient-to-br from-blue-600 via-indigo-600 to-blue-700 text-white shadow-xl relative overflow-hidden"
      >
        <div
          class="absolute -right-12 -bottom-12 w-48 h-48 bg-white/10 rounded-full blur-2xl pointer-events-none"
        >
        </div>
        <h3 class="text-2xl font-bold tracking-tight text-white mb-2">
          Ready to Automate In-Chat Sales & M-Pesa?
        </h3>
        <p class="text-blue-100 text-sm leading-relaxed mb-6 max-w-xl">
          Connect your WhatsApp Business Cloud number, Africa’s Talking Bulk SMS, and Daraja C2B
          shortcode in minutes.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="http://localhost:3000/app/auth/signup"
            class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-white text-blue-700 font-bold text-sm shadow-md hover:bg-blue-50 transition-colors"
          >
            Start Free Trial — 50 SMS Included
          </a>
          <a
            href="/demo"
            class="inline-flex items-center justify-center px-6 py-3 rounded-xl border border-white/40 text-white font-semibold text-sm hover:bg-white/10 transition-colors"
          >
            Request Live Demo
          </a>
        </div>
      </div>

      {/* 8. Related Posts Slot */}
      <slot name="related" />
    </div>
  </article>
</MarketingLayout>

{/* Global styles for handling rich media in blog markdown/HTML content */}
<style is:global>
  /* Automatic 16:9 responsive scaling for images, HTML5 videos, and iframes */
  .blog-prose-wrapper img,
  .blog-prose-wrapper video {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 1rem !important; /* rounded-2xl */
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.1),
      0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
    margin-top: 2rem !important;
    margin-bottom: 2rem !important;
    display: block;
  }

  .blog-prose-wrapper iframe {
    width: 100% !important;
    aspect-ratio: 16 / 9;
    height: auto !important;
    border-radius: 1rem !important; /* rounded-2xl */
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.15),
      0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
    margin-top: 2rem !important;
    margin-bottom: 2rem !important;
    border: 1px solid rgba(148, 163, 184, 0.2) !important;
    display: block;
  }

  .dark .blog-prose-wrapper img,
  .dark .blog-prose-wrapper video,
  .dark .blog-prose-wrapper iframe {
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.6),
      0 8px 10px -6px rgba(0, 0, 0, 0.4) !important;
    border-color: rgba(51, 65, 85, 0.6) !important;
  }
</style>
